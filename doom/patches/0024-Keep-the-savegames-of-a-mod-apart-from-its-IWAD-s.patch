From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Sat, 3 Oct 2026 11:04:45 +0200
Subject: [PATCH] Keep the savegames of a mod apart from its IWAD's

A mod gets its own savegame directory named after the mod's WAD, its
savegames don't load in another game.
---
 doomgeneric/d_main.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/doomgeneric/d_main.c b/doomgeneric/d_main.c
index 34a26af..faeb696 100644
--- a/doomgeneric/d_main.c
+++ b/doomgeneric/d_main.c
@@ -1563,6 +1563,16 @@ void D_DoomMain (void)
         savegamedir = M_GetSaveGameDir(D_SaveGameIWADName(gamemission));
     }
 
+    // A mod keeps its own savegames, they don't load in another game
+    p = M_CheckParmWithArgs("-file", 1);
+    if (p)
+    {
+        char *name = strrchr(myargv[p + 1], '/');
+
+        free(savegamedir);
+        savegamedir = M_GetSaveGameDir(name != NULL ? name + 1 : myargv[p + 1]);
+    }
+
     // Check for -file in shareware
     if (modifiedgame)
     {
