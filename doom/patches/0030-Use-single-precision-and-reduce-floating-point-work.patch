From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Tue, 6 Oct 2026 12:00:00 +0200
Subject: [PATCH] Use single precision and reduce floating point work

Reuse a periodic sine table across harmonics and instruments, and divide
once per waveform when normalizing instead of once per sample. Read and
write float settings without the C library's float parsing and printing,
in thousandths, and use float math in the mouse speed widget.
---
 doomgeneric/i_ndsmusic.c | 10 ++++++++--
 doomgeneric/m_config.c   | 33 +++++++++++++++++++++++++++++++--
 doomgeneric/v_video.c    |  2 +-
 3 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/doomgeneric/i_ndsmusic.c b/doomgeneric/i_ndsmusic.c
index ecdde69..6721585 100644
--- a/doomgeneric/i_ndsmusic.c
+++ b/doomgeneric/i_ndsmusic.c
@@ -151,6 +151,11 @@ static int8_t Clamp8(float v)
 static void InitWaves(void)
 {
     int w, i, h;
+    float sine[WAVE_LEN];
+
+    // Every harmonic uses the same periodic sine samples.
+    for (i = 0; i < WAVE_LEN; ++i)
+        sine[i] = sinf(2.0f * (float) M_PI * i / WAVE_LEN);
 
     for (w = 0; w < NUM_WAVES; ++w)
     {
@@ -160,14 +165,15 @@ static void InitWaves(void)
         {
             buf[i] = 0.0f;
             for (h = 0; h < 8; ++h)
-                buf[i] += harmonics[w][h] * sinf(2.0f * (float) M_PI * (h + 1) * i / WAVE_LEN);
+                buf[i] += harmonics[w][h] * sine[((h + 1) * i) % WAVE_LEN];
             if (w == WAVE_DIST)
                 buf[i] = tanhf(3.0f * buf[i]);
             if (fabsf(buf[i]) > peak)
                 peak = fabsf(buf[i]);
         }
+        float scale = 110.0f / peak;
         for (i = 0; i < WAVE_LEN; ++i)
-            waves[w][i] = Clamp8(buf[i] * 110.0f / peak);
+            waves[w][i] = Clamp8(buf[i] * scale);
     }
     DC_FlushRange(waves, sizeof(waves));
 }
diff --git a/doomgeneric/m_config.c b/doomgeneric/m_config.c
index c016a6f..9ef6c8b 100644
--- a/doomgeneric/m_config.c
+++ b/doomgeneric/m_config.c
@@ -1610,6 +1610,7 @@ static void SaveDefaultCollection(default_collection_t *collection)
 {
     default_t *defaults;
     int i, v;
+    float f_value;
     FILE *f;
 	
     f = fopen (collection->filename, "w");
@@ -1695,7 +1696,10 @@ static void SaveDefaultCollection(default_collection_t *collection)
                 break;
 
             case DEFAULT_FLOAT:
-                fprintf(f, "%f", * (float *) defaults[i].location);
+                // in thousandths, without the C library's float printing
+                f_value = * (float *) defaults[i].location * 1000;
+                v = f_value + (f_value < 0 ? -0.5f : 0.5f);
+                fprintf(f, "%s%i.%03i", v < 0 ? "-" : "", abs(v) / 1000, abs(v) % 1000);
                 break;
 
             case DEFAULT_STRING:
@@ -1723,6 +1727,31 @@ static int ParseIntParameter(char *strparm)
     return parm;
 }
 
+// Parses float values in the configuration file, without the C library's
+// float parsing
+
+static float ParseFloatParameter(char *strparm)
+{
+    float sign = 1, parm = 0, scale = 1;
+
+    if (*strparm == '-')
+    {
+        sign = -1;
+        ++strparm;
+    }
+
+    for (; isdigit((unsigned char) *strparm); ++strparm)
+        parm = parm * 10 + (*strparm - '0');
+
+    if (*strparm == '.')
+    {
+        for (++strparm; isdigit((unsigned char) *strparm); ++strparm)
+            parm += (*strparm - '0') * (scale *= 0.1f);
+    }
+
+    return sign * parm;
+}
+
 static void SetVariable(default_t *def, char *value)
 {
     int intparm;
@@ -1765,7 +1794,7 @@ static void SetVariable(default_t *def, char *value)
             break;
 
         case DEFAULT_FLOAT:
-            * (float *) def->location = (float) atof(value);
+            * (float *) def->location = ParseFloatParameter(value);
             break;
     }
 }
diff --git a/doomgeneric/v_video.c b/doomgeneric/v_video.c
index 273e008..9859ebc 100644
--- a/doomgeneric/v_video.c
+++ b/doomgeneric/v_video.c
@@ -942,7 +942,7 @@ void V_DrawMouseSpeedBox(int speed)
     // If the mouse is turned off or acceleration is turned off, don't
     // draw the box at all.
 
-    if (!usemouse || fabs(mouse_acceleration - 1) < 0.01)
+    if (!usemouse || fabsf(mouse_acceleration - 1.0f) < 0.01f)
     {
         return;
     }
