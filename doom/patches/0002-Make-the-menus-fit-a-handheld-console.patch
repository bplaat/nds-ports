@@ -1567,6 +1606,38 @@ boolean M_Responder (event_t* ev)
     {
 	switch(key)
 	{
+	  case KEY_UPARROW:
+	  case KEY_DOWNARROW:
+	    // Without a keyboard, cycle the last character through the
+	    // alphabet, starting a new one if the name is empty
+	    if (saveCharIndex == 0)
+	    {
+		savegamestrings[saveSlot][saveCharIndex++] = 'A';
+		savegamestrings[saveSlot][saveCharIndex] = 0;
+	    }
+	    else
+	    {
+		char *c = &savegamestrings[saveSlot][saveCharIndex - 1];
+		const char *pos = strchr(savecharset, toupper(*c));
+		int n = pos != NULL ? pos - savecharset : 0;
+		int count = strlen(savecharset);
+
+		n = (n + (key == KEY_UPARROW ? 1 : count - 1)) % count;
+		*c = savecharset[n];
+	    }
+	    break;
+
+	  case KEY_RIGHTARROW:
+	    // Add a new character to edit
+	    if (saveCharIndex < SAVESTRINGSIZE-1 &&
+		M_StringWidth(savegamestrings[saveSlot]) < (SAVESTRINGSIZE-2)*8)
+	    {
+		savegamestrings[saveSlot][saveCharIndex++] = 'A';
+		savegamestrings[saveSlot][saveCharIndex] = 0;
+	    }
+	    break;
+
+	  case KEY_LEFTARROW:
 	  case KEY_BACKSPACE:
 	    if (saveCharIndex > 0)
 	    {
@@ -1626,6 +1697,12 @@ boolean M_Responder (event_t* ev)
