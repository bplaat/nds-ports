+//
+// Characters the d-pad cycles through when editing a savegame name
+static const char savecharset[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -.:/!?";
+
 //
 // M_Responder calls this when user is finished
 //
@@ -640,13 +640,42 @@ void M_SaveSelect(int choice)
     saveSlot = choice;
     M_StringCopy(saveOldString,savegamestrings[choice], SAVESTRINGSIZE);
     if (!strcmp(savegamestrings[choice], EMPTYSTRING))
-	savegamestrings[choice][0] = 0;
+    {
+	// Name new saves after the level and time, so a keyboard is optional
+	time_t now = time(NULL);
+	char stamp[16];
+
+	strftime(stamp, sizeof(stamp), "%d/%m %H:%M", localtime(&now));
+	if (gamemode == commercial)
+	    M_snprintf(savegamestrings[choice], SAVESTRINGSIZE, "MAP%02d %s", gamemap, stamp);
+	else
+	    M_snprintf(savegamestrings[choice], SAVESTRINGSIZE, "E%dM%d %s", gameepisode, gamemap, stamp);
+    }
     saveCharIndex = strlen(savegamestrings[choice]);
 }
 
 //
 // Selected from DOOM menu
 //
+// Savegames need writable storage, eg. an SD card on the Nintendo DS.
+// Without it saving is refused with a message instead of an I_Error.
+#define SAVEDISABLED \
+    "no sd card found, saving is\n" \
+    "disabled. you can keep playing.\n\n" \
+    "press a key."
+
+static boolean M_CanWriteSaves(void)
+{
+    char *filename = P_TempSaveGameFile();
+    FILE *f = fopen(filename, "wb");
+
+    if (f == NULL)
+	return false;
+    fclose(f);
+    remove(filename);
+    return true;
+}
+
 void M_SaveGame (int choice)
 {
