 #define ENDGAME	"are you sure you want to end the game?\n\n"PRESSYN
 
-#define DOSY		"(press y to quit to dos.)"
+#define DOSY		"(press a to quit.)"
 
 #define DETAILHI	"High detail"
 #define DETAILLO	"Low detail"
