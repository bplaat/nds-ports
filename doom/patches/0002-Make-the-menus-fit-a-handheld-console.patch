 //
 // Selected from DOOM menu
 //
+// Savegames need writable storage, eg. an SD card on the Nintendo DS.
+// Without it saving is refused with a message instead of an I_Error.
+#define SAVEDISABLED \
+    "no sd card found, saving is\n" \
+    "disabled. you can keep playing.\n\n" \
+    "press a key."
+
+static boolean M_CanWriteSaves(void)
+{
+    char *filename = P_TempSaveGameFile();
+    FILE *f = fopen(filename, "wb");
+
+    if (f == NULL)
+	return false;
+    fclose(f);
+    remove(filename);
+    return true;
+}
+
