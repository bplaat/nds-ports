 doomgeneric/m_menu.c   | 101 ++++++++++++++++++++++++-----------------
 doomgeneric/m_menu.h   |   3 ++
 doomgeneric/s_sound.c  |  11 ++++-
 4 files changed, 74 insertions(+), 45 deletions(-)

