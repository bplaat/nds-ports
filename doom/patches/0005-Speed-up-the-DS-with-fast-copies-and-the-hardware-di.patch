From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Thu, 1 Oct 2026 08:50:03 +0200
Subject: [PATCH] Speed up the DS with fast copies and the hardware divider

- newlib's memcpy and memset copy a byte at a time in Thumb mode, which
  made copying the frames to VRAM a tenth of the time. mem_nds.c moves
  words, eight at a time, from ITCM.
- The scale of every wall column (dc_iscale) and SlopeDiv divided in
  software, the ARM9 has no divide instruction. They use the DS hardware
  divider, like FixedDiv.
---
 doomgeneric/Makefile.nds |  6 ++--
 doomgeneric/mem_nds.c    | 76 ++++++++++++++++++++++++++++++++++++++++
 doomgeneric/r_segs.c     | 14 ++++++--
 doomgeneric/tables.c     |  9 +++++
 4 files changed, 101 insertions(+), 4 deletions(-)
 create mode 100644 doomgeneric/mem_nds.c

diff --git a/doomgeneric/Makefile.nds b/doomgeneric/Makefile.nds
index 99e95b9..f664c73 100644
--- a/doomgeneric/Makefile.nds
+++ b/doomgeneric/Makefile.nds
@@ -34,8 +34,9 @@ SRC_DOOM := dummy am_map doomdef doomstat dstrings d_event d_items d_iwad d_loop
 	sounds statdump st_lib st_stuff s_sound tables v_video wi_stuff w_checksum w_file w_main w_wad \
 	z_zone w_file_stdc doomgeneric doomgeneric_nds i_ndsvideo i_ndssound
 
-# Hot inner loops (column/span drawers, fixed point math, visplanes) run from ITCM
-SRC_ITCM := r_draw r_plane r_segs r_bsp m_fixed
+# Hot inner loops (column/span drawers, fixed point math, visplanes) and
+# memcpy/memset run from ITCM
+SRC_ITCM := r_draw r_plane r_segs r_bsp m_fixed mem_nds
 
 OFILES := $(addprefix $(BUILD)/,$(addsuffix .o,$(SRC_DOOM)) $(addsuffix .itcm.o,$(SRC_ITCM)))
 
@@ -60,6 +61,7 @@ $(OUTPUT).nds: $(OUTPUT).elf $(GAME_ICON) $(wildcard $(NITRO_DIR)/*)
 $(OUTPUT).elf: $(OFILES)
 
 $(BUILD)/%.itcm.o: CFLAGS += -marm -mlong-calls
+$(BUILD)/mem_nds.itcm.o: CFLAGS += -fno-builtin -fno-tree-loop-distribute-patterns
 $(BUILD)/%.itcm.o: %.c | $(BUILD)
 	$(SILENTMSG) $(notdir $<)
 	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
diff --git a/doomgeneric/mem_nds.c b/doomgeneric/mem_nds.c
new file mode 100644
index 0000000..1afa852
--- /dev/null
+++ b/doomgeneric/mem_nds.c
@@ -0,0 +1,76 @@
+//
+// memcpy and memset for the ARM9
+//
+// newlib's copy a byte at a time in Thumb mode, these move words, eight at a
+// time, or halfwords when only those line up, and run from ITCM. VRAM ignores
+// byte writes, so copies to it need at least the halfwords. Built without builtins, so the compiler doesn't
+// turn the loops back into calls to themselves.
+//
+#include <stddef.h>
+#include <stdint.h>
+
+void *memcpy (void *dst, const void *src, size_t n)
+{
+	uint8_t			*d = dst;
+	const uint8_t	*s = src;
+	uint32_t		*dw;
+	const uint32_t	*sw;
+
+	if ((((uintptr_t) d ^ (uintptr_t) s) & 3) == 0)
+	{
+		while (n && ((uintptr_t) d & 3))
+		{
+			*d++ = *s++;
+			n--;
+		}
+		dw = (uint32_t *) d;
+		sw = (const uint32_t *) s;
+		for (; n >= 32; n -= 32, dw += 8, sw += 8)
+		{
+			uint32_t a = sw[0], b = sw[1], c = sw[2], e = sw[3];
+			uint32_t f = sw[4], g = sw[5], h = sw[6], i = sw[7];
+			dw[0] = a; dw[1] = b; dw[2] = c; dw[3] = e;
+			dw[4] = f; dw[5] = g; dw[6] = h; dw[7] = i;
+		}
+		for (; n >= 4; n -= 4)
+			*dw++ = *sw++;
+		d = (uint8_t *) dw;
+		s = (const uint8_t *) sw;
+	}
+	else if ((((uintptr_t) d ^ (uintptr_t) s) & 1) == 0)
+	{
+		if ((uintptr_t) d & 1 && n)
+		{
+			*d++ = *s++;
+			n--;
+		}
+		for (; n >= 2; n -= 2, d += 2, s += 2)
+			*(uint16_t *) d = *(const uint16_t *) s;
+	}
+	while (n--)
+		*d++ = *s++;
+	return dst;
+}
+
+void *memset (void *dst, int c, size_t n)
+{
+	uint8_t		*d = dst;
+	uint32_t	*dw, v = (uint8_t) c * 0x01010101u;
+
+	while (n && ((uintptr_t) d & 3))
+	{
+		*d++ = c;
+		n--;
+	}
+	dw = (uint32_t *) d;
+	for (; n >= 16; n -= 16, dw += 4)
+	{
+		dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
+	}
+	for (; n >= 4; n -= 4)
+		*dw++ = v;
+	d = (uint8_t *) dw;
+	while (n--)
+		*d++ = c;
+	return dst;
+}
diff --git a/doomgeneric/r_segs.c b/doomgeneric/r_segs.c
index 9b4e413..e7464ac 100644
--- a/doomgeneric/r_segs.c
+++ b/doomgeneric/r_segs.c
@@ -32,6 +32,16 @@
 #include "r_local.h"
 #include "r_sky.h"
 
+#ifdef __NDS__
+#include <nds/arm9/math.h>
+
+// 0xffffffff / scale with the DS hardware divider, the ARM9 has no divide
+// instruction and this runs for every wall column
+#define R_InvScale(scale)	((unsigned) div64(0xffffffffLL, (scale)))
+#else
+#define R_InvScale(scale)	(0xffffffffu / (unsigned) (scale))
+#endif
+
 
 // OPTIMIZE: closed two sided lines as single sided
 
@@ -168,7 +178,7 @@ R_RenderMaskedSegRange
 	    }
 			
 	    sprtopscreen = centeryfrac - FixedMul(dc_texturemid, spryscale);
-	    dc_iscale = 0xffffffffu / (unsigned)spryscale;
+	    dc_iscale = R_InvScale(spryscale);
 	    
 	    // draw the texture
 	    col = (column_t *)( 
@@ -264,7 +274,7 @@ void R_RenderSegLoop (void)
 
 	    dc_colormap = walllights[index];
 	    dc_x = rw_x;
-	    dc_iscale = 0xffffffffu / (unsigned)rw_scale;
+	    dc_iscale = R_InvScale(rw_scale);
 	}
         else
         {
diff --git a/doomgeneric/tables.c b/doomgeneric/tables.c
index c221e9a..aecf99b 100644
--- a/doomgeneric/tables.c
+++ b/doomgeneric/tables.c
@@ -30,6 +30,10 @@
 //	
 //    
 
+#ifdef __NDS__
+#include <nds/arm9/math.h>
+#endif
+
 #include "tables.h"
 
 // to get a global angle from cartesian coordinates, the coordinates are
@@ -48,7 +52,12 @@ int SlopeDiv(unsigned int num, unsigned int den)
     }
     else
     {
+#ifdef __NDS__
+        // the DS hardware divider, the ARM9 has no divide instruction
+        ans = div64((num << 3), den >> 8);
+#else
         ans = (num << 3) / (den >> 8);
+#endif
 
         if (ans <= SLOPERANGE)
         {
