+// The weapon pictures fit inside the bevels of a cell, the ones that are
+// bigger are scaled down, keeping their proportions
+#define ICON_W  (CELL_W - 2)
+#define ICON_H  (CELL_H - 2)
+
+typedef struct
+{
+    int w, h;                   // 0 when the WAD doesn't have the weapon
+    int y;                      // in the cell
+    byte pixels[ICON_W * ICON_H];
+    byte opaque[ICON_W * ICON_H];
+} weapon_icon_t;
+
+static weapon_icon_t weapon_icons[NUMWEAPONS];
+
+static void BuildWeaponIcon(weapon_icon_t *icon, weapontype_t weapon)
+{
+    static byte ones[256];
+    int lump = W_CheckNumForName((char *) weapon_pictures[weapon].sprite);
+    int rows = weapon_pictures[weapon].rows;
+    int maxh = weapon_pictures[weapon].height;
+    const patch_t *patch;
+    byte *pixels, *opaque;
+    int pw, ph, x, y;
+
+    icon->w = icon->h = 0;
+    if (lump < 0)
+        return;
+    patch = W_CacheLumpNum(lump, PU_CACHE);
+    pw = SHORT(patch->width);
+    ph = SHORT(patch->height);
+    pixels = malloc(pw * ph);
+    opaque = calloc(pw, ph);
+    if (pixels == NULL || opaque == NULL)
+    {
+        free(pixels);
+        free(opaque);
+        return;
+    }
+    // The picture, and where it isn't transparent
+    memset(ones, 1, sizeof(ones));
+    DrawPatchTo(pixels, pw, ph, SHORT(patch->leftoffset), SHORT(patch->topoffset), patch, NULL);
+    DrawPatchTo(opaque, pw, ph, SHORT(patch->leftoffset), SHORT(patch->topoffset), patch, ones);
+    if (rows > 0 && rows < ph)
+        ph = rows;
+    if (maxh == 0 || maxh > ICON_H)
+        maxh = ICON_H;
+
+    if (pw * maxh > ph * ICON_W)
+    {
+        icon->w = pw < ICON_W ? pw : ICON_W;
+        icon->h = ph * icon->w / pw;
+    }
+    else
+    {
+        icon->h = ph < maxh ? ph : maxh;
+        icon->w = pw * icon->h / ph;
+    }
+    icon->y = weapon_pictures[weapon].held ? ICON_H - icon->h : (ICON_H - icon->h) / 2;
+    // Sampled at the middle of each pixel, 1:1 when it fits
+    for (y = 0; y < icon->h; ++y)
+        for (x = 0; x < icon->w; ++x)
+        {
+            int src = (2 * y + 1) * ph / (2 * icon->h) * pw + (2 * x + 1) * pw / (2 * icon->w);
+
+            icon->pixels[y * ICON_W + x] = pixels[src];
+            icon->opaque[y * ICON_W + x] = opaque[src];
+        }
+    free(pixels);
+    free(opaque);
+}
