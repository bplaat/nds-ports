+//
+// V_DrawFullscreenPatch
+// Draws a picture made for the whole screen, like the title screen and the
+// intermission maps. A frame with one is shown scaled to fit when only part
+// of the screen is visible at 1:1.
+//
+boolean v_fullscreenpicture;
+
+void V_DrawFullscreenPatch(int x, int y, patch_t *patch)
+{
+    V_DrawPatch(x, y, patch);
+    v_fullscreenpicture = true;
+}
+
+//
+// V_DrawPatchSqueezed
+// A patch squeezed to a narrower width, every column takes the patch column
+// it covers.
+//
+void V_DrawPatchSqueezed(int x, int y, int width, patch_t *patch)
+{
+    int col, w, dx;
+    column_t *column;
+    byte *source, *dest;
+
+    y -= SHORT(patch->topoffset);
+    x -= SHORT(patch->leftoffset);
+    w = SHORT(patch->width);
+
+    V_MarkRect(x, y, width, SHORT(patch->height));
+
+    for (dx = 0; dx < width; dx++)
+    {
+        col = dx * w / width;
+        column = (column_t *)((byte *)patch + LONG(patch->columnofs[col]));
+
+        // step through the posts in a column
+        while (column->topdelta != 0xff)
+        {
+            int count = column->length;
+
+            source = (byte *)column + 3;
+            dest = dest_screen + (y + column->topdelta) * SCREENWIDTH + x + dx;
+            while (count--)
+            {
+                *dest = *source++;
+                dest += SCREENWIDTH;
+            }
+            column = (column_t *)((byte *)column + column->length + 4);
+        }
+    }
+}
+
