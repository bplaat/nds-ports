+static char *M_WrapMessage(char *string)
+{
+    static char wrapped[512];
+    char *p, *space = NULL;
+    int w = 0, wspace = 0;
+
+    if (V_VISIBLEW == SCREENWIDTH)
+	return string;
+    M_StringCopy(wrapped, string, sizeof(wrapped));
+    for (p = wrapped; *p; p++)
+    {
+	if (*p == '\n')
+	{
+	    w = 0;
+	    space = NULL;
+	    continue;
+	}
+	w += M_CharWidth(*p);
+	if (*p == ' ')
+	{
+	    space = p;
+	    wspace = w;
+	}
+	else if (w > V_VISIBLEW - 8 && space)
+	{
+	    *space = '\n';
+	    w -= wspace;
+	    space = NULL;
+	}
+    }
+    return wrapped;
