From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Sat, 3 Oct 2026 11:04:47 +0200
Subject: [PATCH] Copy memory fast on the DS

newlib's memcpy and memset copy a byte at a time in Thumb mode. mem_nds.c
moves words, eight at a time, from ITCM, or halfwords when only those line
up: VRAM ignores byte writes.
---
 doomgeneric/mem_nds.c | 74 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 doomgeneric/mem_nds.c

diff --git a/doomgeneric/mem_nds.c b/doomgeneric/mem_nds.c
new file mode 100644
index 0000000..aa14897
--- /dev/null
+++ b/doomgeneric/mem_nds.c
@@ -0,0 +1,74 @@
+//
+// memcpy and memset for the ARM9
+//
+// newlib's copy a byte at a time in Thumb mode, these move words, eight at a
+// time, or halfwords when only those line up, and run from ITCM. VRAM ignores
+// byte writes, so copies to it need at least the halfwords. Built without
+// builtins, so the compiler doesn't turn the loops back into calls to
+// themselves.
+//
+
+#include <stddef.h>
+#include <stdint.h>
+
+void *memcpy(void *dst, const void *src, size_t n)
+{
+    uint8_t *d = dst;
+    const uint8_t *s = src;
+
+    if ((((uintptr_t) d ^ (uintptr_t) s) & 3) == 0)
+    {
+        uint32_t *dw;
+        const uint32_t *sw;
+
+        for (; n && ((uintptr_t) d & 3); --n)
+            *d++ = *s++;
+        dw = (uint32_t *) d;
+        sw = (const uint32_t *) s;
+        for (; n >= 32; n -= 32, dw += 8, sw += 8)
+        {
+            uint32_t a = sw[0], b = sw[1], c = sw[2], e = sw[3];
+            uint32_t f = sw[4], g = sw[5], h = sw[6], i = sw[7];
+
+            dw[0] = a; dw[1] = b; dw[2] = c; dw[3] = e;
+            dw[4] = f; dw[5] = g; dw[6] = h; dw[7] = i;
+        }
+        for (; n >= 4; n -= 4)
+            *dw++ = *sw++;
+        d = (uint8_t *) dw;
+        s = (const uint8_t *) sw;
+    }
+    else if ((((uintptr_t) d ^ (uintptr_t) s) & 1) == 0)
+    {
+        if (((uintptr_t) d & 1) && n)
+        {
+            *d++ = *s++;
+            --n;
+        }
+        for (; n >= 2; n -= 2, d += 2, s += 2)
+            *(uint16_t *) d = *(const uint16_t *) s;
+    }
+    while (n--)
+        *d++ = *s++;
+    return dst;
+}
+
+void *memset(void *dst, int c, size_t n)
+{
+    uint8_t *d = dst;
+    uint32_t *dw, v = (uint8_t) c * 0x01010101u;
+
+    for (; n && ((uintptr_t) d & 3); --n)
+        *d++ = c;
+    dw = (uint32_t *) d;
+    for (; n >= 16; n -= 16, dw += 4)
+    {
+        dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
+    }
+    for (; n >= 4; n -= 4)
+        *dw++ = v;
+    d = (uint8_t *) dw;
+    while (n--)
+        *d++ = c;
+    return dst;
+}
