@@ -385,11 +388,18 @@ void HU_Drawer(void)
 
     HUlib_drawSText(&w_message);
     HUlib_drawIText(&w_chat);
-    if (automapactive)
+    // a second screen for the automap shows the level name itself
+    if (automapactive && !AM_HasOwnScreen())
 	HUlib_drawTextLine(&w_title, false);
 
 }
 
+// The current level's name, eg. "E1M1: Hangar"
