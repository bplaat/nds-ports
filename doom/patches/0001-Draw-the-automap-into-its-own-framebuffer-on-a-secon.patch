 void AM_Drawer (void);
 
+// Render the automap into a separate framebuffer of the given size,
+// the player view then keeps being drawn while the automap is active.
+void AM_SetFramebuffer(byte *buffer, int width, int height);
+boolean AM_HasOwnScreen(void);
+
 // Called to force the automap to quit
 // if the level is completed while it is up.
 void AM_Stop (void);
diff --git a/doomgeneric/d_main.c b/doomgeneric/d_main.c
index 9012e5f..4014653 100644
--- a/doomgeneric/d_main.c
+++ b/doomgeneric/d_main.c
@@ -239,8 +239,8 @@ void D_Display (void)
     // draw buffered stuff to screen
     I_UpdateNoBlit ();
     
-    // draw the view directly
-    if (gamestate == GS_LEVEL && !automapactive && gametic)
+    // draw the view directly, the automap may live on its own screen
+    if (gamestate == GS_LEVEL && (!automapactive || AM_HasOwnScreen()) && gametic)
     	R_RenderPlayerView (&players[displayplayer]);
 
     if (gamestate == GS_LEVEL && gametic)
@@ -258,7 +258,7 @@ void D_Display (void)
     }
 
     // see if the border needs to be updated to the screen
-    if (gamestate == GS_LEVEL && !automapactive && scaledviewwidth != 320)
+    if (gamestate == GS_LEVEL && (!automapactive || AM_HasOwnScreen()) && scaledviewwidth != 320)
     {
 		if (menuactive || menuactivestate || !viewactivestate)
 			borderdrawcount = 3;
@@ -284,7 +284,7 @@ void D_Display (void)
     // draw pause pic
     if (paused)
     {
-		if (automapactive)
+		if (automapactive && !AM_HasOwnScreen())
 			y = 4;
 		else
 			y = viewwindowy+4;
