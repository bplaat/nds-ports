From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 3 Oct 2026 11:04:43 +0200
Subject: [PATCH] Speed up the column and span drawers

- The drawers keep the source, colormap and translation in locals: the
  byte stores into the frame may alias the globals, so the compiler
  loaded them again for every pixel.
- The column drawer draws four pixels at a time, so the loads of one
  hide the latency of the others, and keeps the texture row in the top
  7 bits of its position: the wrap around 128 is free and the texel load
  takes the shifted position as its index.
- The span drawer stores four pixels as one word, a single write to main
  RAM instead of four.

The frames drawn are the same.
---
 doomgeneric/r_draw.c | 90 ++++++++++++++++++++++++++++++--------------
 1 file changed, 62 insertions(+), 28 deletions(-)

diff --git a/doomgeneric/r_draw.c b/doomgeneric/r_draw.c
index 7ba0a1c..69efe0d 100644
--- a/doomgeneric/r_draw.c
+++ b/doomgeneric/r_draw.c
@@ -103,8 +103,11 @@ void R_DrawColumn (void)
 { 
     int			count; 
     byte*		dest; 
+    byte*		source;
+    lighttable_t*	colormap;
     fixed_t		frac;
     fixed_t		fracstep;	 
+    unsigned		tfrac, tstep;
  
     count = dc_yh - dc_yl; 
 
@@ -131,17 +134,33 @@ void R_DrawColumn (void)
 
     // Inner loop that does the actual texture mapping,
     //  e.g. a DDA-lile scaling.
-    // This is as fast as it gets.
-    do 
+    // The source and colormap are kept in locals, the byte stores
+    //  would make the compiler load them again for every pixel.
+    // Four pixels at a time, so the loads of one hide the latency of
+    //  the others. The texture row is in the top 7 bits of tfrac, the
+    //  wrap around 128 then costs nothing.
+    source = dc_source;
+    colormap = dc_colormap;
+    tfrac = (unsigned) frac << (16 - 7);
+    tstep = (unsigned) fracstep << (16 - 7);
+    for (count++; count >= 4; count -= 4)
     {
 	// Re-map color indices from wall texture column
 	//  using a lighting/special effects LUT.
-	*dest = dc_colormap[dc_source[(frac>>FRACBITS)&127]];
+	dest[0] = colormap[source[tfrac >> 25]];
+	dest[SCREENWIDTH] = colormap[source[(tfrac + tstep) >> 25]];
+	dest[2*SCREENWIDTH] = colormap[source[(tfrac + 2*tstep) >> 25]];
+	dest[3*SCREENWIDTH] = colormap[source[(tfrac + 3*tstep) >> 25]];
 	
+	dest += 4*SCREENWIDTH;
+	tfrac += 4*tstep;
+    }
+    for (; count > 0; count--)
+    {
+	*dest = colormap[source[tfrac >> 25]];
 	dest += SCREENWIDTH; 
-	frac += fracstep;
-	
-    } while (count--); 
+	tfrac += tstep;
+    }
 } 
 
 
@@ -286,6 +305,8 @@ void R_DrawFuzzColumn (void)
     byte*		dest; 
     fixed_t		frac;
     fixed_t		fracstep;	 
+    int			pos = fuzzpos;
+    lighttable_t*	colormap = colormaps + 6*256;
 
     // Adjust borders. Low... 
     if (!dc_yl) 
@@ -325,16 +346,18 @@ void R_DrawFuzzColumn (void)
 	//  a pixel that is either one column
 	//  left or right of the current one.
 	// Add index from colormap to index.
-	*dest = colormaps[6*256+dest[fuzzoffset[fuzzpos]]]; 
+	*dest = colormap[dest[fuzzoffset[pos]]];
 
 	// Clamp table lookup index.
-	if (++fuzzpos == FUZZTABLE) 
-	    fuzzpos = 0;
+	if (++pos == FUZZTABLE)
+	    pos = 0;
 	
 	dest += SCREENWIDTH;
 
 	frac += fracstep; 
     } while (count--); 
+
+    fuzzpos = pos;
 } 
 
 // low detail mode version
@@ -427,6 +450,9 @@ void R_DrawTranslatedColumn (void)
     byte*		dest; 
     fixed_t		frac;
     fixed_t		fracstep;	 
+    byte*		source = dc_source;
+    lighttable_t*	colormap = dc_colormap;
+    byte*		translation = dc_translation;
  
     count = dc_yh - dc_yl; 
     if (count < 0) 
@@ -458,7 +484,7 @@ void R_DrawTranslatedColumn (void)
 	//  used with PLAY sprites.
 	// Thus the "green" ramp of the player 0 sprite
 	//  is mapped to gray, red, black/indigo. 
-	*dest = dc_colormap[dc_translation[dc_source[frac>>FRACBITS]]];
+	*dest = colormap[translation[source[frac>>FRACBITS]]];
 	dest += SCREENWIDTH;
 	
 	frac += fracstep; 
@@ -585,6 +611,11 @@ byte*			ds_source;
 int			dscount;
 
 
+// The flat pixel at a span position: the texture index in u,v, re-indexed
+// using light/colormap
+#define SPANPIXEL(position) \
+    colormap[source[(((position) >> 4) & 0x0fc0) | ((position) >> 26)]]
+
 //
 // Draws the actual span.
 void R_DrawSpan (void) 
@@ -592,8 +623,9 @@ void R_DrawSpan (void)
     unsigned int position, step;
     byte *dest;
     int count;
-    int spot;
-    unsigned int xtemp, ytemp;
+    unsigned int p0, p1, p2, p3;
+    byte *source = ds_source;
+    lighttable_t *colormap = ds_colormap;
 
 #ifdef RANGECHECK
     if (ds_x2 < ds_x1
@@ -618,24 +650,26 @@ void R_DrawSpan (void)
          | ((ds_ystep >> 6)  & 0x0000ffff);
 
     dest = ylookup[ds_y] + columnofs[ds_x1];
+    count = ds_x2 - ds_x1 + 1;
 
-    // We do not check for zero spans here?
-    count = ds_x2 - ds_x1;
-
-    do
+    // Single pixels up to a word boundary, then four at a time stored as
+    // one (little endian) word: a single write to main RAM instead of four
+    for (; count > 0 && ((uintptr_t) dest & 3); count--, position += step)
+	*dest++ = SPANPIXEL(position);
+    for (; count >= 4; count -= 4, dest += 4)
     {
-	// Calculate current texture index in u,v.
-        ytemp = (position >> 4) & 0x0fc0;
-        xtemp = (position >> 26);
-        spot = xtemp | ytemp;
-
-	// Lookup pixel from flat texture tile,
-	//  re-index using light/colormap.
-	*dest++ = ds_colormap[ds_source[spot]];
-
-        position += step;
-
-    } while (count--);
+	p0 = SPANPIXEL(position);
+	position += step;
+	p1 = SPANPIXEL(position);
+	position += step;
+	p2 = SPANPIXEL(position);
+	position += step;
+	p3 = SPANPIXEL(position);
+	position += step;
+	*(uint32_t *) dest = p0 | (p1 << 8) | (p2 << 16) | (p3 << 24);
+    }
+    for (; count > 0; count--, position += step)
+	*dest++ = SPANPIXEL(position);
 }
 
 
