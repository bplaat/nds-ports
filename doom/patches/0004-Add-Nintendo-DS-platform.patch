+// ---------------------------------------------------------------------------
+// Input
+// ---------------------------------------------------------------------------
+
+typedef struct
+{
+    u32 button;
+    int game_key;
+    int menu_key;
+} button_binding_t;
+
+static const button_binding_t bindings[] =
+{
+    { KEY_UP,     KEY_UPARROW,    KEY_UPARROW },
+    { KEY_DOWN,   KEY_DOWNARROW,  KEY_DOWNARROW },
+    { KEY_LEFT,   KEY_LEFTARROW,  KEY_LEFTARROW },
+    { KEY_RIGHT,  KEY_RIGHTARROW, KEY_RIGHTARROW },
+    { KEY_A,      KEY_FIRE,       KEY_ENTER },
+    { KEY_B,      KEY_USE,        KEY_BACKSPACE },
+    { KEY_X,      ']',            0 },
+    { KEY_Y,      KEY_RSHIFT,     0 },
+    { KEY_L,      KEY_STRAFE_L,   0 },
+    { KEY_R,      KEY_STRAFE_R,   0 },
+    { KEY_START,  KEY_ESCAPE,     KEY_ESCAPE },
+    { KEY_SELECT, KEY_TAB,        0 },
+};
+
+// Doom key sent on press, so the release always matches even if the menu
+// opened or closed in between
+static int held_keys[arrlen(bindings)];
+
+// Touch bar buttons along the bottom of the touch screen
+typedef struct
+{
+    int x, w;
+    const char *label;
+    int key;
+} touch_button_t;
+
+static const touch_button_t touch_buttons[] =
+{
+    {   0, 24, "1", '1' },
+    {  24, 24, "2", '2' },
+    {  48, 24, "3", '3' },
+    {  72, 24, "4", '4' },
+    {  96, 24, "5", '5' },
+    { 120, 24, "6", '6' },
+    { 144, 24, "7", '7' },
+    { 168, 40, "MAP", KEY_TAB },
+    { 208, 24, "-", KEY_MINUS },
+    { 232, 24, "+", KEY_EQUALS },
+};
+
+#define TOUCH_TURN_SCALE 12
+
+static int touch_key = -1, touch_button = -1;
+static boolean touch_dragging;
+static int touch_last_x;
+
+static void PostKey(evtype_t type, int key)
+{
+    event_t ev = { 0 };
+
+    ev.type = type;
+    ev.data1 = key;
+    ev.data2 = type == ev_keydown ? key : 0;
+    D_PostEvent(&ev);
+}
+
+static void PollTouch(u32 down, u32 held)
+{
+    touchPosition touch;
+    unsigned i;
+
+    if (!(held & KEY_TOUCH))
+    {
+        if (touch_key >= 0)
+            PostKey(ev_keyup, touch_key);
+        touch_key = touch_button = -1;
+        touch_dragging = false;
+        return;
+    }
+    touchRead(&touch);
+
+    if (down & KEY_TOUCH)
+    {
+        if (touch.py >= SUB_BAR_Y)
+        {
+            for (i = 0; i < arrlen(touch_buttons); ++i)
+            {
+                if (touch.px >= touch_buttons[i].x && touch.px < touch_buttons[i].x + touch_buttons[i].w)
+                {
+                    touch_button = i;
+                    touch_key = touch_buttons[i].key;
+                    PostKey(ev_keydown, touch_key);
+                    break;
+                }
+            }
+        }
+        else
+        {
+            touch_dragging = true;
+            touch_last_x = touch.px;
+        }
+        return;
+    }
+
+    // Dragging the stylus turns the player, like a mouse
+    if (touch_dragging)
+    {
+        int dx = touch.px - touch_last_x;
+
+        touch_last_x = touch.px;
+        if (dx != 0 && dx > -48 && dx < 48 && gamestate == GS_LEVEL && !menuactive)
+        {
+            event_t ev = { 0 };
+
+            ev.type = ev_mouse;
+            ev.data2 = dx * TOUCH_TURN_SCALE;
+            D_PostEvent(&ev);
+        }
+    }
+}
+
+void NDS_PollInput(void)
+{
+    u32 down, up;
+    unsigned i;
+
+    scanKeys();
+    down = keysDown();
+    up = keysUp();
+    // Held d-pad keys repeat in menus, eg. to cycle savegame name letters
+    if (menuactive)
+        down |= keysDownRepeat() & (KEY_UP | KEY_DOWN | KEY_LEFT | KEY_RIGHT);
+
+    for (i = 0; i < arrlen(bindings); ++i)
+    {
+        if ((up & bindings[i].button) && held_keys[i])
+        {
+            PostKey(ev_keyup, held_keys[i]);
+            held_keys[i] = 0;
+        }
+        if (down & bindings[i].button)
+        {
+            int key = menuactive ? bindings[i].menu_key : bindings[i].game_key;
+
+            if (key != 0)
+            {
+                PostKey(ev_keydown, key);
+                held_keys[i] = key;
+            }
+        }
+    }
+
+    PollTouch(down, keysHeld());
+}
+
+// ---------------------------------------------------------------------------
+// Bottom screen: automap and stats panel
+// ---------------------------------------------------------------------------
+
+static byte sub_fb[SUB_WIDTH * SUB_HEIGHT] __attribute__((aligned(32)));
+static byte xlat_white[256], xlat_gold[256], xlat_gray[256], xlat_green[256];
+static unsigned panel_hash, bar_hash;
+
+// Palette indices in PLAYPAL
+#define COL_BLACK       0
+#define COL_BUTTON      102
+#define COL_BUTTON_HI   90
+#define COL_BUTTON_LO   108
+#define COL_BUTTON_ON   188
+#define COL_PRESSED     176
+#define COL_DIVIDER     100
+
+// The HUD font is drawn with the red ramp 176-191, remap it onto another ramp
+static void BuildTranslation(byte *xlat, int base, int count)
+{
+    int i;
+
+    for (i = 0; i < 256; ++i)
+        xlat[i] = i;
+    for (i = 0; i < 16; ++i)
+        xlat[176 + i] = base + i * count / 16;
+}
+
+void NDS_InitSubScreen(void)
+{
+    const byte *playpal = W_CacheLumpName("PLAYPAL", PU_CACHE);
+    int i;
+
+    for (i = 0; i < 256; ++i)
+    {
+        int r = gammatable[usegamma][playpal[i * 3]];
+        int g = gammatable[usegamma][playpal[i * 3 + 1]];
+        int b = gammatable[usegamma][playpal[i * 3 + 2]];
+        BG_PALETTE_SUB[i] = RGB15(r >> 3, g >> 3, b >> 3);
+    }
+
+    BuildTranslation(xlat_white, 80, 16);
+    BuildTranslation(xlat_gray, 96, 12);
+    BuildTranslation(xlat_gold, 160, 8);
+    BuildTranslation(xlat_green, 112, 16);
+
+    videoSetModeSub(MODE_5_2D);
+    bgInitSub(3, BgType_Bmp8, BgSize_B8_256x256, 0, 0);
+    memset(sub_fb, 0, sizeof(sub_fb));
+    sub_bitmap_mode = true;
+    panel_hash = bar_hash = 0;
+
+    AM_SetFramebuffer(sub_fb, SUB_WIDTH, SUB_BAR_Y);
+}
+
+static void DrawPatch(int x, int y, const patch_t *patch, const byte *xlat)
+{
+    DrawPatchTo(sub_fb, SUB_WIDTH, SUB_HEIGHT, x, y, patch, xlat);
+}
+
+static int TextWidth(const char *s)
+{
+    int w = 0;
+
+    for (; *s; ++s)
+    {
+        int c = toupper((unsigned char) *s) - HU_FONTSTART;
+        w += c < 0 || c >= HU_FONTSIZE ? 4 : SHORT(hu_font[c]->width);
+    }
+    return w;
+}
+
+static void DrawText(int x, int y, const char *s, const byte *xlat)
+{
+    for (; *s; ++s)
+    {
+        int c = toupper((unsigned char) *s) - HU_FONTSTART;
+
+        if (c < 0 || c >= HU_FONTSIZE)
+        {
+            x += 4;
+            continue;
+        }
+        DrawPatch(x, y, hu_font[c], xlat);
+        x += SHORT(hu_font[c]->width);
+    }
+}
+
+static void FillRect(int x, int y, int w, int h, byte color)
+{
+    int i;
+
+    for (i = 0; i < h; ++i)
+        memset(sub_fb + (y + i) * SUB_WIDTH + x, color, w);
+}
+
+// Bevelled button in the style of the status bar, fill is the face color
+static void DrawButton(int x, int y, int w, int h, const char *label, byte fill, const byte *xlat)
+{
+    boolean pressed = fill == COL_PRESSED;
+
+    FillRect(x, y, w, h, pressed ? COL_BUTTON_HI : COL_BUTTON_LO);
+    FillRect(x, y, w - 1, h - 1, pressed ? COL_BUTTON_LO : COL_BUTTON_HI);
+    FillRect(x + 1, y + 1, w - 2, h - 2, fill);
+    DrawText(x + (w - TextWidth(label)) / 2 + pressed, y + (h - 7) / 2 + pressed, label, xlat);
+}
+
+static void DrawTouchBar(void)
+{
+    player_t *player = &players[consoleplayer];
+    boolean in_level = gamestate == GS_LEVEL;
+    unsigned i;
+
+    FillRect(0, SUB_BAR_Y, SUB_WIDTH, SUB_HEIGHT - SUB_BAR_Y, COL_BLACK);
+    for (i = 0; i < arrlen(touch_buttons); ++i)
+    {
+        const touch_button_t *b = &touch_buttons[i];
+        const byte *xlat = in_level ? xlat_white : xlat_gray;
+        byte fill = (int) i == touch_button ? COL_PRESSED : COL_BUTTON;
+
+        if (i < 7 && in_level)
+        {
+            // Slot 1 is fist/chainsaw, slot 3 shotgun/super shotgun
+            boolean owned = i == 0 || player->weaponowned[i]
+                || (i == 2 && player->weaponowned[wp_supershotgun]);
+            int current = player->readyweapon == wp_chainsaw ? 0
+                : player->readyweapon == wp_supershotgun ? 2 : player->readyweapon;
+
+            xlat = !owned ? xlat_gray : (int) i == current ? xlat_gold : xlat_white;
+            if ((int) i == current && fill == COL_BUTTON)
+                fill = COL_BUTTON_ON;
+        }
+        else if (i == 7 && automapactive)
+        {
+            xlat = xlat_gold;
+            if (fill == COL_BUTTON)
+                fill = COL_BUTTON_ON;
+        }
+        DrawButton(b->x, SUB_BAR_Y + 2, b->w, SUB_HEIGHT - SUB_BAR_Y - 2, b->label, fill, xlat);
+    }
+}
+
+static void DrawStat(int y, const char *label, int value, int total)
+{
+    char buf[32];
+
+    DrawText(16, y, label, xlat_white);
+    if (total > 0)
+        snprintf(buf, sizeof(buf), "%d / %d", value, total);
+    else
+        snprintf(buf, sizeof(buf), "%d", value);
+    DrawText(112, y, buf, value >= total && total > 0 ? xlat_green : xlat_gold);
+}
+
+static void DrawLevelPanel(void)
+{
+    static const char *ammo_names[NUMAMMO] = { "BULLETS", "SHELLS", "CELLS", "ROCKETS" };
+    static const int ammo_rows[NUMAMMO] = { 0, 1, 3, 2 };
+    player_t *player = &players[consoleplayer];
+    char buf[32];
+    int i, secs = leveltime / TICRATE;
+
+    DrawText(16, 8, HU_LevelTitle(), xlat_gold);
+    FillRect(16, 20, SUB_WIDTH - 32, 1, COL_DIVIDER);
+
+    DrawStat(26, "KILLS", player->killcount, totalkills);
+    DrawStat(38, "ITEMS", player->itemcount, totalitems);
+    DrawStat(50, "SECRETS", player->secretcount, totalsecret);
+    DrawText(16, 62, "TIME", xlat_white);
+    snprintf(buf, sizeof(buf), "%d:%02d", secs / 60, secs % 60);
+    DrawText(112, 62, buf, xlat_gold);
+    FillRect(16, 76, SUB_WIDTH - 32, 1, COL_DIVIDER);
+
+    for (i = 0; i < NUMAMMO; ++i)
+    {
+        int y = 82 + ammo_rows[i] * 12;
+
+        DrawText(16, y, ammo_names[i], xlat_white);
+        snprintf(buf, sizeof(buf), "%d / %d", player->ammo[i], player->maxammo[i]);
+        DrawText(112, y, buf, player->ammo[i] > 0 ? xlat_gold : xlat_gray);
+    }
+    FillRect(16, 132, SUB_WIDTH - 32, 1, COL_DIVIDER);
+
+    // Keycards and skulls, drawn with the status bar key icons
+    for (i = 0; i < NUMCARDS; ++i)
+    {
+        char name[9];
+
+        if (!player->cards[i])
+            continue;
+        snprintf(name, sizeof(name), "STKEYS%d", i);
+        DrawPatch(16 + i * 14, 140, W_CacheLumpName(name, PU_CACHE), xlat_white);
+    }
+    DrawText(112, 142, "DRAG TO TURN", xlat_gray);
+}
+
+static void DrawHelpPanel(void)
+{
+    static const char *lines[] =
+    {
+        "A  FIRE / OK",
+        "B  USE / BACK",
+        "X  NEXT WEAPON",
+        "Y  RUN",
+        "L R  STRAFE",
+        "START  MENU",
+        "SELECT  AUTOMAP",
+        "STYLUS  DRAG TO TURN",
+    };
+    unsigned i;
+
+    DrawText((SUB_WIDTH - TextWidth("DOOM FOR NINTENDO DS")) / 2, 10, "DOOM FOR NINTENDO DS", xlat_gold);
+    FillRect(16, 22, SUB_WIDTH - 32, 1, COL_DIVIDER);
+    for (i = 0; i < arrlen(lines); ++i)
+        DrawText(40, 32 + i * 14, lines[i], xlat_white);
+}
+
+// Cheap fingerprints of what the touch bar and panel show, to skip redundant redraws
+static unsigned BarHash(void)
+{
+    player_t *player = &players[consoleplayer];
+    unsigned h = gamestate * 31 + automapactive * 7 + (touch_button + 1) * 131;
+    int i;
+
+    if (gamestate != GS_LEVEL)
+        return h | 1;
+    h = h * 33 + player->readyweapon;
+    for (i = 0; i < NUMWEAPONS; ++i)
+        h = h * 3 + player->weaponowned[i];
+    return h | 1;
+}
+
+static unsigned PanelHash(void)
+{
+    player_t *player = &players[consoleplayer];
+    unsigned h = gamestate * 31 + automapactive * 7;
+    int i;
+
+    if (gamestate != GS_LEVEL)
+        return h | 1;
+    h = h * 33 + leveltime / TICRATE;
+    h = h * 33 + player->killcount;
+    h = h * 33 + player->itemcount;
+    h = h * 33 + player->secretcount;
+    for (i = 0; i < NUMAMMO; ++i)
+        h = h * 33 + player->ammo[i] + player->maxammo[i] * 7;
+    for (i = 0; i < NUMCARDS; ++i)
+        h = h * 3 + player->cards[i];
+    return h | 1;
+}
+
+static void CopyToVRAM(int y, int h)
+{
+    memcpy((byte *) BG_BMP_RAM_SUB(0) + y * SUB_WIDTH, sub_fb + y * SUB_WIDTH, h * SUB_WIDTH);
+}
+
+void NDS_UpdateSubScreen(void)
+{
+    unsigned hash;
+
+    if (!sub_bitmap_mode)
+        return;
+
+    if (gamestate == GS_LEVEL && automapactive)
+    {
+        // The automap already drew into the top of sub_fb during D_Display
+        panel_hash = 0;
+        CopyToVRAM(0, SUB_BAR_Y);
+    }
+    else if ((hash = PanelHash()) != panel_hash)
+    {
+        panel_hash = hash;
+        memset(sub_fb, COL_BLACK, SUB_WIDTH * SUB_BAR_Y);
+        if (gamestate == GS_LEVEL)
+            DrawLevelPanel();
+        else
+            DrawHelpPanel();
+        CopyToVRAM(0, SUB_BAR_Y);
+    }
+
+    if ((hash = BarHash()) != bar_hash)
+    {
+        bar_hash = hash;
+        DrawTouchBar();
+        CopyToVRAM(SUB_BAR_Y, SUB_HEIGHT - SUB_BAR_Y);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Entry point
+// ---------------------------------------------------------------------------
+
+int main(int argc, char **argv)
+{
+    static char *doom_argv[8] = { "doom", "-iwad" };
+    const wad_entry_t *wad;
+    int doom_argc = 3;
+
+    I_NDS_InitVideo();
+    ConsoleMode();
+    PrintHeader();
+
+    have_fat = fatInitDefault();
+    nitroFSInit(NULL);
+    // Paths without a device need a current device, use the ROM if there is no SD card
+    if (!have_fat)
+        chdir("nitro:/");
+
+    // A mod runs as -file on top of its IWAD
+    wad = PickWad();
+    doom_argv[2] = wads[wad->base].path;
+    if (!wad->iwad)
+    {
+        doom_argv[doom_argc++] = "-file";
+        doom_argv[doom_argc++] = (char *) wad->path;
+    }
+    PrintHeader();
+    printf("\n");
+    EnterDataDir();
+    printf("\n  Loading %s\n\n  ", wad->title);
+    fflush(stdout);
+    SetLoadingOutput(true);
+
+    // Extra command line options (eg. -skill 4 -warp 1 3) can be put in
+    // /data/doom/args.txt, expanded as a Doom response file
+    if (FileExists("args.txt"))
+        doom_argv[doom_argc++] = "@args.txt";
+
+    doomgeneric_Create(doom_argc, doom_argv);
+    for (;;)
+        doomgeneric_Tick();
+    return 0;
+}
