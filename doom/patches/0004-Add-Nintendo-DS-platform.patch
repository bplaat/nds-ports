diff --git a/doomgeneric/i_ndssound.c b/doomgeneric/i_ndssound.c
new file mode 100644
index 0000000..0c949e3
--- /dev/null
+++ b/doomgeneric/i_ndssound.c
@@ -0,0 +1,1107 @@
+//
+// Nintendo DS sound backend
+//
+// Sound effects are converted once to signed 8-bit PCM and played directly
+// by the hardware mixer on channels 0-7, which does the resampling, volume
+// and stereo panning.
+//
+// Music is a MUS (and converted MIDI) sequencer running in a 140 Hz calico
+// thread that plays a wavetable synth on hardware channels 8-15: looping
+// single-cycle waveforms per General MIDI instrument family and synthesized
+// drum samples, with software envelopes. The DS mixer does all the
+// resampling and mixing, no OPL emulation or ARM9 mixing is needed.
+//
+
+#include <nds.h>
+#include <math.h>
+#include <string.h>
+
+#include "doomtype.h"
+#include "i_sound.h"
+#include "i_swap.h"
+#include "i_system.h"
+#include "deh_str.h"
+#include "m_misc.h"
+#include "w_wad.h"
+#include "z_zone.h"
+
+// ---------------------------------------------------------------------------
+// Sound effects
+// ---------------------------------------------------------------------------
+
+#define NUM_SFX_CHANNELS 8
+
+typedef struct
+{
+    sfxinfo_t *sfx;
+    uint32_t end_ms;
+} sfx_channel_t;
+
+// Converted sample, stored in sfx->driver_data as a purgable zone block
+typedef struct
+{
+    int rate;
+    int length;
+    int8_t data[];
+} sfx_sample_t;
+
+// Config variables normally provided by the SDL sound module
+int use_libsamplerate = 0;
+float libsamplerate_scale = 0.65f;
+
+static sfx_channel_t sfx_channels[NUM_SFX_CHANNELS];
+static boolean use_sfx_prefix;
+
+static snddevice_t sound_devices[] = { SNDDEVICE_SB, SNDDEVICE_PAS, SNDDEVICE_GUS,
+    SNDDEVICE_WAVEBLASTER, SNDDEVICE_SOUNDCANVAS, SNDDEVICE_AWE32 };
+
+static uint32_t NowMs(void)
+{
+    return (uint32_t) (tickGetCount() * 1000 / TICK_FREQ);
+}
+
+static sfx_sample_t *CacheSfx(sfxinfo_t *sfx)
+{
+    byte *lump;
+    int lumplen, rate, length, i;
+    sfx_sample_t *sample;
+
+    if (sfx->driver_data != NULL)
+        return sfx->driver_data;
+
+    lump = W_CacheLumpNum(sfx->lumpnum, PU_STATIC);
+    lumplen = W_LumpLength(sfx->lumpnum);
+
+    // DMX header: format 3, sample rate, length; skip the 16 byte pads
+    if (lumplen < 8 || lump[0] != 0x03 || lump[1] != 0x00)
+    {
+        W_ReleaseLumpNum(sfx->lumpnum);
+        return NULL;
+    }
+    rate = lump[2] | (lump[3] << 8);
+    length = lump[4] | (lump[5] << 8) | (lump[6] << 16) | (lump[7] << 24);
+    if (length > lumplen - 8 || length <= 48)
+    {
+        W_ReleaseLumpNum(sfx->lumpnum);
+        return NULL;
+    }
+    length -= 32;
+
+    sample = Z_Malloc(sizeof(sfx_sample_t) + ((length + 3) & ~3), PU_STATIC, &sfx->driver_data);
+    sample->rate = rate;
+    sample->length = (length + 3) & ~3;
+    for (i = 0; i < length; ++i)
+        sample->data[i] = lump[8 + 16 + i] ^ 0x80;
+    memset(sample->data + length, 0, sample->length - length);
+    DC_FlushRange(sample->data, sample->length);
+
+    W_ReleaseLumpNum(sfx->lumpnum);
+    Z_ChangeTag(sample, PU_CACHE);
+    return sample;
+}
+
+static void ReleaseChannel(int channel)
+{
+    sfxinfo_t *sfx = sfx_channels[channel].sfx;
+    int i;
+
+    sfx_channels[channel].sfx = NULL;
+    if (sfx == NULL || sfx->driver_data == NULL)
+        return;
+    // The sample may only be purged once no channel plays it anymore
+    for (i = 0; i < NUM_SFX_CHANNELS; ++i)
+        if (sfx_channels[i].sfx == sfx)
+            return;
+    Z_ChangeTag(sfx->driver_data, PU_CACHE);
+}
+
+static boolean NDS_InitSound(boolean _use_sfx_prefix)
+{
+    use_sfx_prefix = _use_sfx_prefix;
+    soundInit();
+    soundPowerOn();
+    soundSetMixerVolume(127);
+    memset(sfx_channels, 0, sizeof(sfx_channels));
+    return true;
+}
+
+static void NDS_ShutdownSound(void)
+{
+    soundStop(0xff);
+}
+
+static int NDS_GetSfxLumpNum(sfxinfo_t *sfx)
+{
+    char namebuf[9];
+
+    // Linked sounds (eg. the chaingun) play the lump of the sound they link to
+    if (sfx->link != NULL)
+        sfx = sfx->link;
+    if (use_sfx_prefix)
+        M_snprintf(namebuf, sizeof(namebuf), "ds%s", DEH_String(sfx->name));
+    else
+        M_StringCopy(namebuf, DEH_String(sfx->name), sizeof(namebuf));
+    return W_GetNumForName(namebuf);
+}
+
+static void NDS_UpdateSound(void)
+{
+    int i;
+    uint32_t now = NowMs();
+
+    for (i = 0; i < NUM_SFX_CHANNELS; ++i)
+        if (sfx_channels[i].sfx != NULL && (int32_t) (now - sfx_channels[i].end_ms) >= 0)
+            ReleaseChannel(i);
+}
+
+static unsigned SfxVolume(int vol)
+{
+    return (vol < 0 ? 0 : vol > 127 ? 127 : vol) << 4;
+}
+
+static unsigned SfxPan(int sep)
+{
+    return (sep < 0 ? 0 : sep > 254 ? 254 : sep) / 2;
+}
+
+static void NDS_UpdateSoundParams(int channel, int vol, int sep)
+{
+    if (channel < 0 || channel >= NUM_SFX_CHANNELS)
+        return;
+    soundChSetVolume(channel, SfxVolume(vol));
+    soundChSetPan(channel, SfxPan(sep));
+}
+
+static int NDS_StartSound(sfxinfo_t *sfx, int channel, int vol, int sep)
+{
+    sfx_sample_t *sample;
+
+    if (channel < 0 || channel >= NUM_SFX_CHANNELS)
+        return -1;
+
+    ReleaseChannel(channel);
+    sample = CacheSfx(sfx);
+    if (sample == NULL)
+        return -1;
+
+    // Keep the sample resident while the ARM7 is reading it
+    Z_ChangeTag(sample, PU_STATIC);
+    sfx_channels[channel].sfx = sfx;
+    sfx_channels[channel].end_ms = NowMs() + (uint32_t) sample->length * 1000 / sample->rate + 1;
+
+    soundPreparePcm(channel | SOUND_START, SfxVolume(vol), SfxPan(sep),
+        soundTimerFromHz(sample->rate), SoundMode_OneShot, SoundFmt_Pcm8,
+        sample->data, 0, sample->length / 4);
+    return channel;
+}
+
+static void NDS_StopSound(int channel)
+{
+    if (channel < 0 || channel >= NUM_SFX_CHANNELS)
+        return;
+    soundStop(1U << channel);
+    ReleaseChannel(channel);
+}
+
+static boolean NDS_SoundIsPlaying(int channel)
+{
+    if (channel < 0 || channel >= NUM_SFX_CHANNELS)
+        return false;
+    return sfx_channels[channel].sfx != NULL && (int32_t) (NowMs() - sfx_channels[channel].end_ms) < 0;
+}
+
+static void NDS_PrecacheSounds(sfxinfo_t *sounds, int num_sounds)
+{
+    // Samples are converted on first use, the zone may purge them again
+}
+
+sound_module_t DG_sound_module =
+{
+    sound_devices,
+    arrlen(sound_devices),
+    NDS_InitSound,
+    NDS_ShutdownSound,
+    NDS_GetSfxLumpNum,
+    NDS_UpdateSound,
+    NDS_UpdateSoundParams,
+    NDS_StartSound,
+    NDS_StopSound,
+    NDS_SoundIsPlaying,
+    NDS_PrecacheSounds,
+};
+
+// ---------------------------------------------------------------------------
+// Music: MUS sequencer driving a hardware wavetable synth
+// ---------------------------------------------------------------------------
+
+#define MUS_TICK_HZ     140
+#define MUS_CHANNELS    16
+#define MUS_PERCUSSION  15
+
+// Hardware channels 8-15 are music voices, 0-7 belong to sound effects
+#define VOICE_FIRST     8
+#define NUM_VOICES      8
+
+// Single-cycle waveform length and drum sample rate
+#define WAVE_LEN        64
+#define DRUM_RATE       16384
+
+// Channel volume (0..2047) of a full velocity, full volume note
+#define VOICE_GAIN      3
+
+typedef struct
+{
+    byte header[4];
+    uint16_t score_len;
+    uint16_t score_start;
+} PACKEDATTR mus_header_t;
+
+typedef struct
+{
+    int instrument;
+    int volume;
+    int pan;
+    int bend;
+    int velocity;
+} mus_channel_t;
+
+typedef struct
+{
+    boolean active;
+    boolean releasing;
+    int channel;
+    int note;
+    int velocity;
+    int env;          // 0..255 << 8
+    int decay;        // per tick
+    int sustain;      // 0..255 << 8
+    int release;      // per tick
+    int ticks_left;   // one-shot drum samples end on their own
+    int age;
+    unsigned last_vol;
+} voice_t;
+
+enum { WAVE_PIANO, WAVE_BELL, WAVE_ORGAN, WAVE_PLUCK, WAVE_DIST, WAVE_BASS,
+       WAVE_STRINGS, WAVE_BRASS, WAVE_REED, WAVE_FLUTE, WAVE_SQUARE, NUM_WAVES };
+
+enum { DRUM_KICK, DRUM_SNARE, DRUM_HAT, DRUM_OPENHAT, DRUM_CRASH, DRUM_TOM, NUM_DRUMS };
+
+typedef struct
+{
+    byte wave;
+    byte decay;
+    byte sustain;
+    byte release;
+} instrument_family_t;
+
+// Timbre and envelope per General MIDI instrument family (program / 8)
+static const instrument_family_t families[16] =
+{
+    { WAVE_PIANO,   5, 100, 24 }, // piano
+    { WAVE_BELL,    8, 50,  16 }, // chromatic percussion
+    { WAVE_ORGAN,   0, 255, 32 }, // organ
+    { WAVE_PLUCK,   3, 140, 20 }, // guitar
+    { WAVE_BASS,    2, 180, 30 }, // bass
+    { WAVE_STRINGS, 1, 220, 12 }, // strings
+    { WAVE_STRINGS, 1, 220, 12 }, // ensemble
+    { WAVE_BRASS,   1, 200, 24 }, // brass
+    { WAVE_REED,    1, 210, 24 }, // reed
+    { WAVE_FLUTE,   1, 220, 24 }, // pipe
+    { WAVE_SQUARE,  1, 200, 20 }, // synth lead
+    { WAVE_STRINGS, 1, 230, 10 }, // synth pad
+    { WAVE_BRASS,   2, 170, 16 }, // synth effects
+    { WAVE_PLUCK,   5, 110, 20 }, // ethnic
+    { WAVE_BELL,    12, 40, 30 }, // percussive
+    { WAVE_SQUARE,  4, 120, 20 }, // sound effects
+};
+
+// Harmonic amplitudes (1..8) of the additive waveforms
+static const float harmonics[NUM_WAVES][8] =
+{
+    { 1.0f, 0.5f, 0.25f, 0.12f, 0.06f },                     // piano
+    { 1.0f, 0.0f, 0.0f, 0.35f, 0.0f, 0.0f, 0.2f },           // bell
+    { 1.0f, 0.7f, 0.5f, 0.35f, 0.0f, 0.2f, 0.0f, 0.15f },    // organ
+    { 1.0f, 0.6f, 0.4f, 0.3f, 0.2f, 0.15f, 0.1f, 0.08f },    // pluck
+    { 1.0f, 0.5f, 0.33f, 0.25f, 0.2f, 0.16f, 0.14f, 0.12f }, // distortion (clipped below)
+    { 1.0f, 0.3f, 0.1f },                                    // bass
+    { 1.0f, 0.5f, 0.33f, 0.25f, 0.2f, 0.16f, 0.14f, 0.12f }, // strings
+    { 1.0f, 0.8f, 0.6f, 0.5f, 0.4f, 0.3f, 0.2f, 0.15f },     // brass
+    { 1.0f, 0.0f, 0.5f, 0.0f, 0.33f, 0.0f, 0.2f },           // reed
+    { 1.0f, 0.1f, 0.05f },                                   // flute
+    { 1.0f, 0.0f, 0.33f, 0.0f, 0.2f, 0.0f, 0.14f, 0.0f },    // square
+};
+
+static int8_t waves[NUM_WAVES][WAVE_LEN] __attribute__((aligned(4)));
+static int8_t *drums[NUM_DRUMS];
+static int drum_len[NUM_DRUMS];
+
+static Mutex music_mutex;
+static Thread music_thread;
+static byte music_stack[8192] __attribute__((aligned(8)));
+
+static const byte *song, *song_end, *song_pos;
+static boolean song_looping, song_playing, song_paused;
+static int song_delay;
+static int music_volume = 100;
+
+static mus_channel_t channels[MUS_CHANNELS];
+static voice_t voices[NUM_VOICES];
+static int voice_clock;
+
+static uint32_t note_hz[128];       // note frequency * WAVE_LEN, the sample rate
+static uint32_t bend_mul[256];      // 16.16 pitch bend multipliers
+
+static uint32_t noise_state = 0x12345678;
+
+static float Noise(void)
+{
+    noise_state = noise_state * 1664525 + 1013904223;
+    return (int32_t) noise_state / 2147483648.0f;
+}
+
+static int8_t Clamp8(float v)
+{
+    return v > 127.0f ? 127 : v < -127.0f ? -127 : (int8_t) v;
+}
+
+static void InitWaves(void)
+{
+    int w, i, h;
+
+    for (w = 0; w < NUM_WAVES; ++w)
+    {
+        float buf[WAVE_LEN], peak = 0.0f;
+
+        for (i = 0; i < WAVE_LEN; ++i)
+        {
+            buf[i] = 0.0f;
+            for (h = 0; h < 8; ++h)
+                buf[i] += harmonics[w][h] * sinf(2.0f * (float) M_PI * (h + 1) * i / WAVE_LEN);
+            if (w == WAVE_DIST)
+                buf[i] = tanhf(3.0f * buf[i]);
+            if (fabsf(buf[i]) > peak)
+                peak = fabsf(buf[i]);
+        }
+        for (i = 0; i < WAVE_LEN; ++i)
+            waves[w][i] = Clamp8(buf[i] * 110.0f / peak);
+    }
+    DC_FlushRange(waves, sizeof(waves));
+}
+
+// Synthesizes one drum sample, lengths in milliseconds
+static void MakeDrum(int drum, int ms)
+{
+    int i, len = (DRUM_RATE * ms / 1000 + 3) & ~3;
+    float phase = 0.0f, lp = 0.0f, prev = 0.0f;
+    int8_t *out = Z_Malloc(len, PU_STATIC, NULL);
+
+    for (i = 0; i < len; ++i)
+    {
+        float t = (float) i / DRUM_RATE, env = 1.0f - (float) i / len, v = 0.0f, n = Noise();
+
+        switch (drum)
+        {
+        case DRUM_KICK:
+            phase += 2.0f * (float) M_PI * (45.0f + 110.0f * expf(-t * 30.0f)) / DRUM_RATE;
+            v = sinf(phase) * expf(-t * 12.0f);
+            break;
+        case DRUM_SNARE:
+            phase += 2.0f * (float) M_PI * 190.0f / DRUM_RATE;
+            v = (0.45f * sinf(phase) + 0.75f * n) * expf(-t * 20.0f);
+            break;
+        case DRUM_HAT:
+        case DRUM_OPENHAT:
+            // High passed noise
+            v = (n - prev) * 0.6f * expf(-t * (drum == DRUM_HAT ? 70.0f : 12.0f));
+            prev = n;
+            break;
+        case DRUM_CRASH:
+            lp += (n - lp) * 0.6f;
+            v = (n - 0.5f * lp) * expf(-t * 4.0f);
+            break;
+        case DRUM_TOM:
+            phase += 2.0f * (float) M_PI * (110.0f + 60.0f * expf(-t * 20.0f)) / DRUM_RATE;
+            v = sinf(phase) * expf(-t * 9.0f);
+            break;
+        }
+        out[i] = Clamp8(v * env * 120.0f);
+    }
+    DC_FlushRange(out, len);
+    drums[drum] = out;
+    drum_len[drum] = len;
+}
+
+static void InitTables(void)
+{
+    int i;
+
+    for (i = 0; i < 128; ++i)
+        note_hz[i] = (uint32_t) (WAVE_LEN * 440.0f * powf(2.0f, (i - 69) / 12.0f));
+    for (i = 0; i < 256; ++i)
+        bend_mul[i] = (uint32_t) (65536.0f * powf(2.0f, (i - 128) / 768.0f));
+
+    InitWaves();
+    MakeDrum(DRUM_KICK, 250);
+    MakeDrum(DRUM_SNARE, 200);
+    MakeDrum(DRUM_HAT, 60);
+    MakeDrum(DRUM_OPENHAT, 300);
+    MakeDrum(DRUM_CRASH, 900);
+    MakeDrum(DRUM_TOM, 300);
+}
+
+static unsigned VoiceTimer(const voice_t *v)
+{
+    uint32_t hz = (uint32_t) (((uint64_t) note_hz[v->note] * bend_mul[channels[v->channel].bend]) >> 16);
+    unsigned timer = soundTimerFromHz(hz ? hz : 1);
+    return timer < 1 ? 1 : timer > 0xffff ? 0xffff : timer;
+}
+
+static unsigned VoiceVolume(const voice_t *v)
+{
+    const mus_channel_t *ch = &channels[v->channel];
+    unsigned level = (unsigned) (v->env >> 8) * v->velocity * ch->volume / (127 * 127);
+    return level * music_volume * VOICE_GAIN / 127;
+}
+
+static void VoiceOff(int i)
+{
+    voices[i].active = false;
+    soundStop(1U << (VOICE_FIRST + i));
+}
+
+static void AllNotesOff(void)
+{
+    int i;
+
+    for (i = 0; i < NUM_VOICES; ++i)
+        VoiceOff(i);
+}
+
+static int AllocVoice(void)
+{
+    int i, best = 0, best_score = INT_MAX;
+
+    // Prefer a free voice, then the quietest releasing one, then the oldest
+    for (i = 0; i < NUM_VOICES; ++i)
+    {
+        int score;
+
+        if (!voices[i].active)
+            return i;
+        score = voices[i].releasing ? (voices[i].env >> 8) - 0x10000 : voices[i].age;
+        if (score < best_score)
+        {
+            best = i;
+            best_score = score;
+        }
+    }
+    return best;
+}
+
+// General MIDI percussion key to drum sample, playback rate and loudness
+static void DrumParams(int note, int *drum, int *rate, int *level)
+{
+    *rate = DRUM_RATE;
+    *level = 255;
+    switch (note)
+    {
+    case 35: case 36: *drum = DRUM_KICK; break;
+    case 37: case 38: case 39: case 40: *drum = DRUM_SNARE; *level = 220; break;
+    case 42: case 44: *drum = DRUM_HAT; *level = 150; break;
+    case 46: *drum = DRUM_OPENHAT; *level = 150; break;
+    case 49: case 52: case 55: case 57: *drum = DRUM_CRASH; *level = 170; break;
+    case 51: case 53: case 59: *drum = DRUM_OPENHAT; *rate = DRUM_RATE * 3 / 4; *level = 120; break;
+    case 41: case 43: case 45: case 47: case 48: case 50:
+        // Toms, pitched by key
+        *drum = DRUM_TOM; *rate = DRUM_RATE * (note - 29) / 16; *level = 220; break;
+    default: *drum = DRUM_SNARE; *rate = DRUM_RATE * 3 / 2; *level = 110; break;
+    }
+}
+
+static void NoteOn(int channel, int note, int velocity)
+{
+    mus_channel_t *ch = &channels[channel];
+    int i = AllocVoice();
+    voice_t *v = &voices[i];
+
+    v->active = true;
+    v->channel = channel;
+    v->note = note & 127;
+    v->velocity = velocity;
+    v->env = 255 << 8;
+    v->age = voice_clock++;
+
+    if (channel == MUS_PERCUSSION)
+    {
+        int drum, rate, level;
+
+        DrumParams(note, &drum, &rate, &level);
+        v->releasing = true;
+        v->velocity = velocity * level / 255;
+        v->release = 0;
+        v->ticks_left = drum_len[drum] * MUS_TICK_HZ / rate + 1;
+        v->last_vol = VoiceVolume(v);
+        soundPreparePcm((VOICE_FIRST + i) | SOUND_START, v->last_vol, ch->pan, soundTimerFromHz(rate),
+            SoundMode_OneShot, SoundFmt_Pcm8, drums[drum], 0, drum_len[drum] / 4);
+        return;
+    }
+
+    const instrument_family_t *f = &families[ch->instrument >> 3];
+    // Overdriven and distortion guitar, the sound of Doom's soundtrack
+    int wave = ch->instrument == 29 || ch->instrument == 30 ? WAVE_DIST : f->wave;
+
+    v->releasing = false;
+    v->decay = f->decay << 8;
+    v->sustain = f->sustain << 8;
+    v->release = f->release << 8;
+    v->ticks_left = 0;
+    v->last_vol = VoiceVolume(v);
+    soundPreparePcm((VOICE_FIRST + i) | SOUND_START, v->last_vol, ch->pan, VoiceTimer(v),
+        SoundMode_Repeat, SoundFmt_Pcm8, waves[wave], 0, WAVE_LEN / 4);
+}
+
+static void NoteOff(int channel, int note)
+{
+    int i;
+
+    if (channel == MUS_PERCUSSION)
+        return;
+    for (i = 0; i < NUM_VOICES; ++i)
+        if (voices[i].active && !voices[i].releasing && voices[i].channel == channel && voices[i].note == note)
+            voices[i].releasing = true;
+}
+
+static void UpdateChannelVoices(int channel, boolean pitch, boolean pan)
+{
+    int i;
+
+    for (i = 0; i < NUM_VOICES; ++i)
+    {
+        if (!voices[i].active || voices[i].channel != channel)
+            continue;
+        if (pitch && channel != MUS_PERCUSSION)
+            soundChSetTimer(VOICE_FIRST + i, VoiceTimer(&voices[i]));
+        if (pan)
+            soundChSetPan(VOICE_FIRST + i, channels[channel].pan);
+    }
+}
+
+static void ResetChannels(void)
+{
+    int i;
+
+    for (i = 0; i < MUS_CHANNELS; ++i)
+    {
+        channels[i].instrument = 0;
+        channels[i].volume = 100;
+        channels[i].pan = 64;
+        channels[i].bend = 128;
+        channels[i].velocity = 100;
+    }
+}
+
+static void Controller(int channel, int ctrl, int value)
+{
+    mus_channel_t *ch = &channels[channel];
+
+    value &= 127;
+    switch (ctrl)
+    {
+    case 0: ch->instrument = value; break;
+    case 3: ch->volume = value; break;
+    case 4: ch->pan = value; UpdateChannelVoices(channel, false, true); break;
+    default: break;
+    }
+}
+
+// Runs MUS events until the next delay, returns false at the end of the score
+static boolean ProcessEvents(void)
+{
+    for (;;)
+    {
+        byte event, data;
+        int channel, type;
+
+        if (song_pos >= song_end)
+            return false;
+        event = *song_pos++;
+        channel = event & 15;
+        type = (event >> 4) & 7;
+
+        switch (type)
+        {
+        case 0: // release note
+            NoteOff(channel, *song_pos++ & 127);
+            break;
+        case 1: // play note
+            data = *song_pos++;
+            if (data & 0x80)
+                channels[channel].velocity = *song_pos++ & 127;
+            NoteOn(channel, data & 127, channels[channel].velocity);
+            break;
+        case 2: // pitch wheel
+            channels[channel].bend = *song_pos++;
+            UpdateChannelVoices(channel, true, false);
+            break;
+        case 3: // system event
+            data = *song_pos++;
+            if (data == 10 || data == 11)
+                AllNotesOff();
+            else if (data == 14)
+                ResetChannels();
+            break;
+        case 4: // controller
+            data = *song_pos++;
+            Controller(channel, data, *song_pos++);
+            break;
+        case 5: // end of measure
+            break;
+        case 6: // score end
+            return false;
+        default:
+            break;
+        }
+
+        if (event & 0x80)
+        {
+            int delay = 0;
+            do
+            {
+                data = *song_pos++;
+                delay = (delay << 7) | (data & 127);
+            } while ((data & 0x80) && song_pos < song_end);
+            song_delay = delay;
+            return true;
+        }
+    }
+}
+
+static void UpdateEnvelopes(void)
+{
+    int i;
+
+    for (i = 0; i < NUM_VOICES; ++i)
+    {
+        voice_t *v = &voices[i];
+        unsigned vol;
+
+        if (!v->active)
+            continue;
+        if (v->ticks_left > 0 && --v->ticks_left == 0)
+        {
+            VoiceOff(i);
+            continue;
+        }
+        if (v->releasing)
+            v->env -= v->release;
+        else if (v->env > v->sustain)
+            v->env = v->env - v->decay < v->sustain ? v->sustain : v->env - v->decay;
+        if (v->env <= 0)
+        {
+            VoiceOff(i);
+            continue;
+        }
+        vol = VoiceVolume(v);
+        if (vol != v->last_vol)
+        {
+            v->last_vol = vol;
+            soundChSetVolume(VOICE_FIRST + i, vol);
+        }
+    }
+}
+
+static void MusicTick(void)
+{
+    if (!song_playing || song_paused)
+        return;
+
+    while (song_delay <= 0)
+    {
+        if (!ProcessEvents())
+        {
+            if (!song_looping)
+            {
+                song_playing = false;
+                AllNotesOff();
+                return;
+            }
+            song_pos = song;
+            song_delay = 0;
+        }
+    }
+    --song_delay;
+    UpdateEnvelopes();
+}
+
+static int MusicThreadMain(void *arg)
+{
+    TickTask task;
+
+    threadTimerStart(&task, MUS_TICK_HZ);
+    for (;;)
+    {
+        threadTimerWait(&task);
+        mutexLock(&music_mutex);
+        MusicTick();
+        mutexUnlock(&music_mutex);
+    }
+    return 0;
+}
+
+static boolean NDS_InitMusic(void)
+{
+    soundInit();
+    soundPowerOn();
+    InitTables();
+    ResetChannels();
+
+    threadPrepare(&music_thread, MusicThreadMain, NULL, music_stack + sizeof(music_stack), MAIN_THREAD_PRIO - 1);
+    threadAttachLocalStorage(&music_thread, NULL);
+    threadStart(&music_thread);
+    return true;
+}
+
+static void NDS_ShutdownMusic(void)
+{
+    mutexLock(&music_mutex);
+    song_playing = false;
+    AllNotesOff();
+    mutexUnlock(&music_mutex);
+}
+
+static void NDS_SetMusicVolume(int volume)
+{
+    mutexLock(&music_mutex);
+    music_volume = volume < 0 ? 0 : volume > 127 ? 127 : volume;
+    mutexUnlock(&music_mutex);
+}
+
+static void NDS_PauseMusic(void)
+{
+    mutexLock(&music_mutex);
+    song_paused = true;
+    AllNotesOff();
+    mutexUnlock(&music_mutex);
+}
+
+static void NDS_ResumeMusic(void)
+{
+    mutexLock(&music_mutex);
+    song_paused = false;
+    mutexUnlock(&music_mutex);
+}
+
+// ---------------------------------------------------------------------------
+// MIDI support: MIDI lumps (Freedoom, PWADs) are converted once into a MUS
+// event stream at 140 Hz, so a single sequencer handles both formats.
+// ---------------------------------------------------------------------------
+
+#define MAX_MIDI_TRACKS 64
+
+typedef struct
+{
+    const byte *pos, *end;
+    uint32_t next_tick;
+    byte status;
+    boolean done;
+} midi_track_t;
+
+typedef struct
+{
+    byte *data;
+    int len, size;
+    int pending;        // offset of the last event byte, to set its delay bit
+    uint32_t tick;      // MUS ticks written so far
+} mus_writer_t;
+
+static uint32_t ReadVarLen(const byte **p, const byte *end)
+{
+    uint32_t value = 0;
+
+    while (*p < end)
+    {
+        byte b = *(*p)++;
+        value = (value << 7) | (b & 127);
+        if (!(b & 0x80))
+            break;
+    }
+    return value;
+}
+
+static void MusPut(mus_writer_t *w, byte b)
+{
+    if (w->len == w->size)
+    {
+        byte *grown = Z_Malloc(w->size * 2, PU_STATIC, NULL);
+        memcpy(grown, w->data, w->len);
+        Z_Free(w->data);
+        w->data = grown;
+        w->size *= 2;
+    }
+    w->data[w->len++] = b;
+}
+
+static void MusDelayTo(mus_writer_t *w, uint32_t tick)
+{
+    uint32_t delay = tick - w->tick;
+    int shift;
+
+    if (delay == 0 || w->pending < 0)
+        return;
+    w->data[w->pending] |= 0x80;
+    for (shift = 28; shift > 0 && !(delay >> shift); shift -= 7)
+        ;
+    for (; shift > 0; shift -= 7)
+        MusPut(w, 0x80 | ((delay >> shift) & 127));
+    MusPut(w, delay & 127);
+    w->tick = tick;
+    w->pending = -1;
+}
+
+static void MusEvent(mus_writer_t *w, uint32_t tick, int type, int channel, int a, int b)
+{
+    MusDelayTo(w, tick);
+    w->pending = w->len;
+    MusPut(w, (type << 4) | channel);
+    if (a >= 0)
+        MusPut(w, a);
+    if (b >= 0)
+        MusPut(w, b);
+}
+
+static byte *ConvertMidi(const byte *data, int len, int *out_len)
+{
+    midi_track_t tracks[MAX_MIDI_TRACKS];
+    mus_writer_t w;
+    const byte *p = data + 14;
+    int num_tracks = 0, division, i;
+    uint32_t tempo = 500000, last_tick = 0;
+    uint64_t usec = 0;
+
+    if (len < 14 || memcmp(data, "MThd", 4) != 0)
+        return NULL;
+    division = (data[12] << 8) | data[13];
+    if (division & 0x8000 || division == 0)
+        division = 96;
+
+    while (p + 8 <= data + len && num_tracks < MAX_MIDI_TRACKS)
+    {
+        uint32_t size = (p[4] << 24) | (p[5] << 16) | (p[6] << 8) | p[7];
+
+        if (memcmp(p, "MTrk", 4) == 0)
+        {
+            midi_track_t *t = &tracks[num_tracks++];
+            t->pos = p + 8;
+            t->end = p + 8 + size > data + len ? data + len : p + 8 + size;
+            t->status = 0;
+            t->done = false;
+            t->next_tick = ReadVarLen(&t->pos, t->end);
+        }
+        p += 8 + size;
+    }
+    if (num_tracks == 0)
+        return NULL;
+
+    w.size = 4096;
+    w.data = Z_Malloc(w.size, PU_STATIC, NULL);
+    w.len = 0;
+    w.pending = -1;
+    w.tick = 0;
+
+    for (;;)
+    {
+        midi_track_t *t = NULL;
+        byte status, a = 0, b = 0;
+        int channel, type;
+        uint32_t mus_tick;
+
+        // Merge the tracks by picking the earliest pending event
+        for (i = 0; i < num_tracks; ++i)
+            if (!tracks[i].done && (t == NULL || tracks[i].next_tick < t->next_tick))
+                t = &tracks[i];
+        if (t == NULL)
+            break;
+
+        usec += (uint64_t) (t->next_tick - last_tick) * tempo / division;
+        last_tick = t->next_tick;
+        mus_tick = (uint32_t) (usec * MUS_TICK_HZ / 1000000);
+
+        if (t->pos >= t->end)
+        {
+            t->done = true;
+            continue;
+        }
+        status = *t->pos;
+        if (status & 0x80)
+            t->pos++;
+        else
+            status = t->status;
+
+        if (status == 0xff)
+        {
+            byte meta = *t->pos++;
+            uint32_t size = ReadVarLen(&t->pos, t->end);
+
+            if (meta == 0x51 && size == 3)
+                tempo = (t->pos[0] << 16) | (t->pos[1] << 8) | t->pos[2];
+            else if (meta == 0x2f)
+                t->done = true;
+            t->pos += size;
+        }
+        else if (status == 0xf0 || status == 0xf7)
+        {
+            t->pos += ReadVarLen(&t->pos, t->end);
+        }
+        else if (status & 0x80)
+        {
+            t->status = status;
+            type = status >> 4;
+            // MIDI percussion is channel 9, MUS uses 15
+            channel = status & 15;
+            channel = channel == 9 ? MUS_PERCUSSION : channel == MUS_PERCUSSION ? 9 : channel;
+            a = *t->pos++;
+            if (type != 0xc && type != 0xd)
+                b = *t->pos++;
+
+            switch (type)
+            {
+            case 0x8:
+                MusEvent(&w, mus_tick, 0, channel, a & 127, -1);
+                break;
+            case 0x9:
+                if (b == 0)
+                    MusEvent(&w, mus_tick, 0, channel, a & 127, -1);
+                else
+                    MusEvent(&w, mus_tick, 1, channel, 0x80 | (a & 127), b & 127);
+                break;
+            case 0xb:
+                if (a == 7)
+                    MusEvent(&w, mus_tick, 4, channel, 3, b);
+                else if (a == 10)
+                    MusEvent(&w, mus_tick, 4, channel, 4, b);
+                else if (a == 120 || a == 123)
+                    MusEvent(&w, mus_tick, 3, channel, a == 120 ? 10 : 11, -1);
+                else if (a == 121)
+                    MusEvent(&w, mus_tick, 3, channel, 14, -1);
+                break;
+            case 0xc:
+                MusEvent(&w, mus_tick, 4, channel, 0, a);
+                break;
+            case 0xe:
+                // 14-bit bend to the 8-bit MUS range
+                MusEvent(&w, mus_tick, 2, channel, ((b << 7) | a) >> 6, -1);
+                break;
+            default:
+                break;
+            }
+        }
+
+        if (!t->done)
+            t->next_tick += ReadVarLen(&t->pos, t->end);
+    }
+
+    MusEvent(&w, w.tick, 6, 0, -1, -1);
+    *out_len = w.len;
+    return w.data;
+}
+
+typedef struct
+{
+    const byte *score;
+    int len;
+    byte *converted;
+} song_t;
+
+static void *NDS_RegisterSong(void *data, int len)
+{
+    const mus_header_t *header = data;
+    song_t *handle = Z_Malloc(sizeof(song_t), PU_STATIC, NULL);
+
+    handle->converted = NULL;
+    if (len >= (int) sizeof(mus_header_t) && memcmp(header->header, "MUS\x1a", 4) == 0
+     && SHORT(header->score_start) + SHORT(header->score_len) <= len)
+    {
+        handle->score = (const byte *) data + SHORT(header->score_start);
+        handle->len = SHORT(header->score_len);
+    }
+    else if ((handle->converted = ConvertMidi(data, len, &handle->len)) != NULL)
+    {
+        handle->score = handle->converted;
+    }
+    else
+    {
+        Z_Free(handle);
+        return NULL;
+    }
+    return handle;
+}
+
+static void NDS_UnRegisterSong(void *handle)
+{
+    song_t *s = handle;
+
+    if (s == NULL)
+        return;
+    mutexLock(&music_mutex);
+    if (song == s->score)
+    {
+        song_playing = false;
+        AllNotesOff();
+        song = NULL;
+    }
+    mutexUnlock(&music_mutex);
+    if (s->converted != NULL)
+        Z_Free(s->converted);
+    Z_Free(s);
+}
+
+static void NDS_PlaySong(void *handle, boolean looping)
+{
+    song_t *s = handle;
+
+    if (s == NULL)
+        return;
+    mutexLock(&music_mutex);
+    AllNotesOff();
+    ResetChannels();
+    song = s->score;
+    song_end = song + s->len;
+    song_pos = song;
+    song_delay = 0;
+    song_looping = looping;
+    song_paused = false;
+    song_playing = true;
+    mutexUnlock(&music_mutex);
+}
+
+static void NDS_StopSong(void)
+{
+    mutexLock(&music_mutex);
+    song_playing = false;
+    AllNotesOff();
+    mutexUnlock(&music_mutex);
+}
+
+static boolean NDS_MusicIsPlaying(void)
+{
+    return song_playing;
+}
+
+static snddevice_t music_devices[] = { SNDDEVICE_ADLIB, SNDDEVICE_SB, SNDDEVICE_GENMIDI };
+
+music_module_t DG_music_module =
+{
+    music_devices,
+    arrlen(music_devices),
+    NDS_InitMusic,
+    NDS_ShutdownMusic,
+    NDS_SetMusicVolume,
+    NDS_PauseMusic,
+    NDS_ResumeMusic,
+    NDS_RegisterSong,
+    NDS_UnRegisterSong,
+    NDS_PlaySong,
+    NDS_StopSong,
+    NDS_MusicIsPlaying,
+    NULL,
+};
diff --git a/doomgeneric/i_ndsvideo.c b/doomgeneric/i_ndsvideo.c
new file mode 100644
index 0000000..d41d3a4
--- /dev/null
+++ b/doomgeneric/i_ndsvideo.c
@@ -0,0 +1,217 @@
+//
+// Nintendo DS video backend
+//
+// The 320x200 Doom frame is rendered into main RAM, copied into one of two
+// 8bpp bitmap backgrounds in VRAM banks A/B and page flipped on vblank. The
+// affine background hardware scales it to the 256x192 top screen for free, and
+// Doom's palette lives directly in the hardware BG palette, so palette effects
+// (damage, pickups, radiation suit) cost nothing. For smoothing, a second
+// affine background samples the same frame at a half pixel offset and is
+// alpha blended on top, which gives a cheap hardware bilinear-like filter.
+//
+
+#include <nds.h>
+#include <string.h>
+
+#include "i_video.h"
+#include "m_config.h"
+#include "tables.h"
+#include "z_zone.h"
+
+#include "doomgeneric_nds.h"
+
+#define FB_STRIDE 512
+
+byte *I_VideoBuffer = NULL;
+boolean screenvisible = true;
+boolean screensaver_mode = false;
+int usegamma = 0;
+int usemouse = 1;
+float mouse_acceleration = 1.0f;
+int mouse_threshold = 0;
+
+int nds_smooth = 1;
+
+static u16 palette[256] __attribute__((aligned(4)));
+static volatile boolean palette_dirty;
+static volatile int shown_page, pending_page = -1;
+
+// Scale factors in 8.8 fixed point: 320 -> 256 and 200 -> 192
+#define SCALE_X ((SCREENWIDTH << 8) / 256)
+#define SCALE_Y ((SCREENHEIGHT << 8) / 192)
+
+static void VBlankHandler(void)
+{
+    // A CPU copy, DMA would miss palette writes still in the data cache
+    if (palette_dirty)
+    {
+        memcpy(BG_PALETTE, palette, sizeof(palette));
+        palette_dirty = false;
+    }
+    if (pending_page >= 0)
+    {
+        u16 base = BG_MAP_BASE(pending_page * 8);
+        REG_BG2CNT = (REG_BG2CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+        REG_BG3CNT = (REG_BG3CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+        shown_page = pending_page;
+        pending_page = -1;
+    }
+}
+
+void I_NDS_SetSmoothing(boolean enable)
+{
+    nds_smooth = enable;
+    if (enable)
+    {
+        REG_DISPCNT |= DISPLAY_BG2_ACTIVE;
+        REG_BLDCNT = BLEND_ALPHA | BLEND_SRC_BG2 | BLEND_DST_BG3;
+        REG_BLDALPHA = 8 | (8 << 8);
+    }
+    else
+    {
+        REG_DISPCNT &= ~DISPLAY_BG2_ACTIVE;
+        REG_BLDCNT = BLEND_NONE;
+    }
+}
+
+// Sets up the scaled top screen, also used for the splash before Doom starts
+void I_NDS_InitVideo(void)
+{
+    int bg;
+
+    videoSetMode(MODE_5_2D);
+    vramSetBankA(VRAM_A_MAIN_BG_0x06000000);
+    vramSetBankB(VRAM_B_MAIN_BG_0x06020000);
+    memset(BG_GFX, 0, 2 * FB_STRIDE * 256);
+
+    for (bg = 2; bg <= 3; ++bg)
+    {
+        int id = bgInit(bg, BgType_Bmp8, BgSize_B8_512x256, 0, 0);
+        bgSetPriority(id, bg == 2 ? 0 : 1);
+        bgSetScale(id, SCALE_X, SCALE_Y);
+        // The blend layer samples half an output pixel further
+        if (bg == 2)
+            bgSetScrollf(id, SCALE_X / 2, SCALE_Y / 2);
+    }
+    bgUpdate();
+
+    I_NDS_SetSmoothing(nds_smooth);
+}
+
+// Shows a 320x200 Doom palette image on the top screen
+void I_NDS_ShowSplash(const byte *pixels, const byte *playpal)
+{
+    int y, i;
+
+    for (i = 0; i < 256; ++i)
+        BG_PALETTE[i] = RGB15(playpal[i * 3] >> 3, playpal[i * 3 + 1] >> 3, playpal[i * 3 + 2] >> 3);
+    for (y = 0; y < SCREENHEIGHT; ++y)
+        memcpy((byte *) BG_BMP_RAM(0) + y * FB_STRIDE, pixels + y * SCREENWIDTH, SCREENWIDTH);
+}
+
+void I_InitGraphics(void)
+{
+    I_VideoBuffer = Z_Malloc(SCREENWIDTH * SCREENHEIGHT, PU_STATIC, NULL);
+    memset(I_VideoBuffer, 0, SCREENWIDTH * SCREENHEIGHT);
+
+    // The config is loaded by now, so apply its settings
+    I_NDS_InitVideo();
+    irqSet(IRQ_VBLANK, VBlankHandler);
+    irqEnable(IRQ_VBLANK);
+
+    NDS_InitSubScreen();
+}
+
+void I_ShutdownGraphics(void)
+{
+    irqClear(IRQ_VBLANK);
+}
+
+void I_StartFrame(void)
+{
+}
+
+void I_StartTic(void)
+{
+    NDS_PollInput();
+}
+
+void I_UpdateNoBlit(void)
+{
+}
+
+void I_FinishUpdate(void)
+{
+    int page, y;
+    u32 *src, *dst;
+
+    // Wait until the last flip happened, the back buffer is then free
+    while (pending_page >= 0)
+        threadWaitForVBlank();
+
+    page = shown_page ^ 1;
+    src = (u32 *) I_VideoBuffer;
+    dst = (u32 *) BG_BMP_RAM(page * 8);
+    for (y = 0; y < SCREENHEIGHT; ++y)
+    {
+        memcpy(dst, src, SCREENWIDTH);
+        src += SCREENWIDTH / 4;
+        dst += FB_STRIDE / 4;
+    }
+    pending_page = page;
+
+    NDS_UpdateSubScreen();
+}
+
+void I_ReadScreen(byte *scr)
+{
+    memcpy(scr, I_VideoBuffer, SCREENWIDTH * SCREENHEIGHT);
+}
+
+void I_SetPalette(byte *doompalette)
+{
+    int i;
+
+    for (i = 0; i < 256; ++i)
+    {
+        int r = gammatable[usegamma][*doompalette++];
+        int g = gammatable[usegamma][*doompalette++];
+        int b = gammatable[usegamma][*doompalette++];
+        palette[i] = RGB15(r >> 3, g >> 3, b >> 3);
+    }
+    palette_dirty = true;
+}
+
+int I_GetPaletteIndex(int r, int g, int b)
+{
+    int i, best = 0, best_diff = INT_MAX;
+
+    for (i = 0; i < 256; ++i)
+    {
+        int dr = r - ((palette[i] & 31) << 3);
+        int dg = g - (((palette[i] >> 5) & 31) << 3);
+        int db = b - (((palette[i] >> 10) & 31) << 3);
+        int diff = dr * dr + dg * dg + db * db;
+
+        if (diff < best_diff)
+        {
+            best = i;
+            best_diff = diff;
+        }
+    }
+    return best;
+}
+
+void I_BeginRead(void) {}
+void I_EndRead(void) {}
+void I_SetWindowTitle(char *title) {}
+void I_GraphicsCheckCommandLine(void) {}
+void I_SetGrabMouseCallback(grabmouse_callback_t func) {}
+void I_EnableLoadingDisk(void) {}
+void I_DisplayFPSDots(boolean dots_on) {}
+void I_CheckIsScreensaver(void) {}
+
+void I_BindVideoVariables(void)
+{
+    M_BindVariable("nds_smooth", &nds_smooth);
+}
