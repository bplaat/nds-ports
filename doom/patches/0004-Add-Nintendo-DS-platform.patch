+#---------------------------------------------------------------------------------
+# Nintendo DS (devkitARM + libnds) build of doomgeneric
+#   make -f Makefile.nds [ICON=icon.bmp] [NITRO_DIR=dir]
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(DEVKITARM)),)
+$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
+endif
+
+GAME_TITLE     := DOOM
+GAME_SUBTITLE1 := id Software (1993)
+GAME_SUBTITLE2 := doomgeneric NDS port
+
+TARGET  := doom
+BUILD   := build
+OUTPUT  := $(CURDIR)/$(TARGET)
+
+ICON      ?=
+NITRO_DIR ?=
+GAME_ICON := $(or $(ICON),$(DEVKITPRO)/calico/share/nds-icon.bmp)
+ifneq ($(strip $(NITRO_DIR)),)
+NITRO_FILES := $(NITRO_DIR)
+endif
+
+# Must be set before ds_rules, which prepends the calico library path
+LIBPATHS := -L$(DEVKITPRO)/libnds/lib
+
+include $(DEVKITARM)/ds_rules
+
+SRC_DOOM := dummy am_map doomdef doomstat dstrings d_event d_items d_iwad d_loop d_main d_mode d_net \
+	f_finale f_wipe g_game hu_lib hu_stuff info i_cdmus i_endoom i_joystick i_scale i_sound \
+	i_system i_timer memio m_argv m_bbox m_cheat m_config m_controls m_menu m_misc m_random p_ceilng \
+	p_doors p_enemy p_floor p_inter p_lights p_map p_maputl p_mobj p_plats p_pspr p_saveg p_setup \
+	p_sight p_spec p_switch p_telept p_tick p_user r_data r_main r_sky r_things sha1 \
+	sounds statdump st_lib st_stuff s_sound tables v_video wi_stuff w_checksum w_file w_main w_wad \
+	z_zone w_file_stdc doomgeneric doomgeneric_nds i_ndsvideo i_ndssound
+
+# Hot inner loops (column/span drawers, fixed point math, visplanes) run from ITCM
+SRC_ITCM := r_draw r_plane r_segs r_bsp m_fixed
+
+OFILES := $(addprefix $(BUILD)/,$(addsuffix .o,$(SRC_DOOM)) $(addsuffix .itcm.o,$(SRC_ITCM)))
+
+ARCH     := -march=armv5te -mtune=arm946e-s -mthumb
+CFLAGS   := -g -O2 -Wall -Wno-unused -Wno-pointer-sign -Wno-format-truncation -Wno-dangling-pointer \
+	-ffunction-sections -fdata-sections -fno-strict-aliasing $(ARCH) \
+	-DARM9 -DNORMALUNIX -DLINUX -DFEATURE_SOUND -DCMAP256 \
+	-I$(LIBNDS)/include -I$(CALICO)/include
+LDFLAGS  := -specs=ds_arm9.specs -g $(ARCH) -Wl,-Map,$(BUILD)/$(TARGET).map
+LIBS     := -lfilesystem -lfat -lnds9 -lm
+LD       := $(CC)
+
+.PHONY: all clean
+all: $(OUTPUT).nds
+
+# Like the ds_rules default, plus a proper header title (homebrew game code kept)
+$(OUTPUT).nds: $(OUTPUT).elf $(GAME_ICON) $(wildcard $(NITRO_DIR)/*)
+	$(SILENTCMD)ndstool -c $@ -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1);$(GAME_SUBTITLE2)" \
+		-g "####" 00 "$(GAME_TITLE)" $(_ADDFILES)
+	$(SILENTMSG) built ... $(notdir $@)
+
+$(OUTPUT).elf: $(OFILES)
+
+$(BUILD)/%.itcm.o: CFLAGS += -marm -mlong-calls
+$(BUILD)/%.itcm.o: %.c | $(BUILD)
+	$(SILENTMSG) $(notdir $<)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+$(BUILD)/%.o: %.c | $(BUILD)
+	$(SILENTMSG) $(notdir $<)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+$(BUILD):
+	@mkdir -p $@
+
+clean:
+	rm -rf $(BUILD) $(OUTPUT).elf $(OUTPUT).nds $(TARGET).lst
+
+-include $(OFILES:.o=.d)
