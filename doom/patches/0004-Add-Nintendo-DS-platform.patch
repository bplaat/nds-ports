+//
+// Nintendo DS platform layer for doomgeneric
+//
+// - Game picker and loading screen on the bottom screen console, listing every
+//   IWAD and mod (PWAD) found in NitroFS (embedded in the ROM) and on the SD card
+// - Buttons map to Doom keys, context sensitive between game and menus
+// - The touch screen turns the player by dragging the stylus and has a button
+//   bar for weapons, the automap and view size / map zoom
+// - The bottom screen shows the live automap or a stats panel, drawn with the
+//   Doom palette and the WAD's own HUD font
+//
+
+#include <nds.h>
+#include <ctype.h>
+#include <fat.h>
+#include <filesystem.h>
+#include <stdio.h>
+#include <string.h>
+#include <dirent.h>
+#include <stdlib.h>
+#include <sys/iosupport.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "am_map.h"
+#include "d_event.h"
+#include "d_player.h"
+#include "doomgeneric.h"
+#include "doomkeys.h"
+#include "doomstat.h"
+#include "hu_stuff.h"
+#include "i_swap.h"
+#include "i_system.h"
+#include "i_video.h"
+#include "m_controls.h"
+#include "tables.h"
+#include "v_patch.h"
+#include "w_wad.h"
+#include "z_zone.h"
+
+#include "doomgeneric_nds.h"
+
+int vanilla_keyboard_mapping = 1;
+
+extern patch_t *hu_font[HU_FONTSIZE];
+
+// Draws a Doom patch into an 8bpp buffer, optionally through a color translation
+static void DrawPatchTo(byte *buf, int bw, int bh, int x, int y, const patch_t *patch, const byte *xlat)
+{
+    int col, w = SHORT(patch->width);
+
+    x -= SHORT(patch->leftoffset);
+    y -= SHORT(patch->topoffset);
+    for (col = 0; col < w; ++col)
+    {
+        const column_t *column;
+        int sx = x + col;
+
+        if (sx < 0 || sx >= bw)
+            continue;
+        column = (const column_t *) ((const byte *) patch + LONG(patch->columnofs[col]));
+        while (column->topdelta != 0xff)
+        {
+            const byte *src = (const byte *) column + 3;
+            int i, sy = y + column->topdelta;
+
+            for (i = 0; i < column->length; ++i, ++sy)
+                if (sy >= 0 && sy < bh)
+                    buf[sy * bw + sx] = xlat != NULL ? xlat[src[i]] : src[i];
+            column = (const column_t *) ((const byte *) column + column->length + 4);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Bottom screen console
+// ---------------------------------------------------------------------------
+
+static PrintConsole console;
+static boolean sub_bitmap_mode;
+
+// Doom's startup log is far too wide for the 32 column console, so while
+// loading every log line only prints a progress dot
+static const devoptab_t *console_out;
+static devoptab_t loading_out;
+
+static ssize_t LoadingWrite(struct _reent *r, void *fd, const char *ptr, size_t len)
+{
+    size_t i;
+
+    for (i = 0; i < len; ++i)
+        if (ptr[i] == '\n')
+            console_out->write_r(r, fd, ".", 1);
+    return len;
+}
+
+static void SetLoadingOutput(boolean loading)
+{
+    if (console_out == NULL)
+    {
+        console_out = devoptab_list[STD_OUT];
+        loading_out = *console_out;
+        loading_out.write_r = LoadingWrite;
+    }
+    devoptab_list[STD_OUT] = devoptab_list[STD_ERR] = loading ? &loading_out : console_out;
+}
+
+static void ConsoleMode(void)
+{
+    videoSetModeSub(MODE_5_2D);
+    vramSetBankC(VRAM_C_SUB_BG);
+    consoleInit(&console, 0, BgType_Text4bpp, BgSize_T_256x256, 30, 4, false, true);
+    consoleSelect(&console);
+    sub_bitmap_mode = false;
+}
+
+void I_NDS_ErrorBox(const char *msg)
+{
+    SetLoadingOutput(false);
+    ConsoleMode();
+    consoleClear();
+    printf("\x1b[31;1m  DOOM had to stop\x1b[39;0m\n\n%s\n\n\x1b[30;1m  Press START to exit\x1b[39;0m\n", msg);
+    for (;;)
+    {
+        threadWaitForVBlank();
+        scanKeys();
+        if (keysDown() & KEY_START)
+            break;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// WAD discovery and game picker
+// ---------------------------------------------------------------------------
+
+#define MAX_WADS 32
+
+static const struct
+{
+    const char *name;
+    const char *title;
+} known_iwads[] =
+{
+    { "doom2.wad",     "DOOM II" },
+    { "plutonia.wad",  "Final DOOM: Plutonia" },
+    { "tnt.wad",       "Final DOOM: TNT Evilution" },
+    { "doom.wad",      "DOOM" },
+    { "doom1.wad",     "DOOM Shareware" },
+    { "chex.wad",      "Chex Quest" },
+    { "hacx.wad",      "HACX" },
+};
+
+typedef struct
+{
+    char path[256];
+    char title[32];
+    boolean iwad;
+    boolean has_maps;     // has levels at all
+    boolean commercial;   // MAPxx levels (DOOM II) instead of ExMy
+    int known;            // index in known_iwads, or arrlen(known_iwads)
+    int base;             // IWAD a PWAD runs on, -1 if none fits
+} wad_entry_t;
+
+// WADs, config and saves live in the usual homebrew data folder on the SD card
+#define DATA_DIR "/data/doom"
+
+static wad_entry_t wads[MAX_WADS];
+static int num_wads;
+static boolean have_fat;
+
+static void MakeDataDir(void)
+{
+    mkdir("/data", 0777);
+    mkdir(DATA_DIR, 0777);
+}
+
+static boolean FileExists(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 && S_ISREG(st.st_mode);
+}
+
+// Reads the header and directory of a WAD, returns the lump count or -1
+static int ReadWadDirectory(FILE *f, boolean *iwad, byte **dir)
+{
+    byte header[12];
+    int numlumps, dirofs;
+
+    if (fread(header, 1, 12, f) != 12 || (memcmp(header, "IWAD", 4) && memcmp(header, "PWAD", 4)))
+        return -1;
+    *iwad = header[0] == 'I';
+    numlumps = LONG(*(int32_t *) (header + 4));
+    dirofs = LONG(*(int32_t *) (header + 8));
+    if (numlumps < 0 || numlumps > 65536 || (*dir = malloc(numlumps * 16 + 1)) == NULL)
+        return -1;
+    if (fseek(f, dirofs, SEEK_SET) != 0 || fread(*dir, 16, numlumps, f) != (size_t) numlumps)
+    {
+        free(*dir);
+        return -1;
+    }
+    return numlumps;
+}
+
+// Reads one lump from a WAD before the engine is up, for the splash screen
+static byte *ReadLump(const char *path, const char *name, int *len)
+{
+    FILE *f = fopen(path, "rb");
+    byte *dir, *data = NULL;
+    boolean iwad;
+    int numlumps, i;
+
+    if (f == NULL)
+        return NULL;
+    numlumps = ReadWadDirectory(f, &iwad, &dir);
+    for (i = numlumps - 1; i >= 0; --i)
+    {
+        byte *entry = dir + i * 16;
+
+        if (strncasecmp((char *) entry + 8, name, 8) != 0)
+            continue;
+        *len = LONG(*(int32_t *) (entry + 4));
+        data = malloc(*len);
+        if (data != NULL && (fseek(f, LONG(*(int32_t *) entry), SEEK_SET) != 0
+                             || fread(data, 1, *len, f) != (size_t) *len))
+        {
+            free(data);
+            data = NULL;
+        }
+        break;
+    }
+    if (numlumps >= 0)
+        free(dir);
+    fclose(f);
+    return data;
+}
+
+static void AddWad(const char *dir, const char *name)
+{
+    wad_entry_t *w = &wads[num_wads];
+    size_t len = strlen(name);
+    byte *lumps;
+    FILE *f;
+    int i, numlumps;
+
+    if (num_wads == MAX_WADS || len < 5 || strcasecmp(name + len - 4, ".wad") != 0)
+        return;
+    // The first copy of a file name wins, the ROM is searched first
+    for (i = 0; i < num_wads; ++i)
+        if (strcasecmp(strrchr(wads[i].path, '/') + 1, name) == 0)
+            return;
+
+    snprintf(w->path, sizeof(w->path), "%s%s%s", dir, dir[strlen(dir) - 1] == '/' ? "" : "/", name);
+    if ((f = fopen(w->path, "rb")) == NULL)
+        return;
+    numlumps = ReadWadDirectory(f, &w->iwad, &lumps);
+    fclose(f);
+    if (numlumps < 0)
+        return;
+
+    w->has_maps = w->commercial = false;
+    for (i = 0; i < numlumps; ++i)
+    {
+        const char *lump = (const char *) lumps + i * 16 + 8;
+
+        if (!strncasecmp(lump, "MAP", 3) && isdigit((unsigned char) lump[3]) && isdigit((unsigned char) lump[4]))
+            w->has_maps = w->commercial = true;
+        else if (toupper((unsigned char) lump[0]) == 'E' && isdigit((unsigned char) lump[1])
+              && toupper((unsigned char) lump[2]) == 'M' && isdigit((unsigned char) lump[3]))
+            w->has_maps = true;
+    }
+    free(lumps);
+
+    for (w->known = 0; w->known < (int) arrlen(known_iwads); ++w->known)
+        if (strcasecmp(known_iwads[w->known].name, name) == 0)
+            break;
+    if (w->iwad && w->known < (int) arrlen(known_iwads))
+        snprintf(w->title, sizeof(w->title), "%s", known_iwads[w->known].title);
+    else
+        snprintf(w->title, sizeof(w->title), "%.*s", (int) len - 4, name);
+    ++num_wads;
+}
+
+static void ScanDir(const char *path)
+{
+    DIR *dir = opendir(path);
+    struct dirent *entry;
+
+    if (dir == NULL)
+        return;
+    while ((entry = readdir(dir)) != NULL)
+        if (entry->d_type != DT_DIR)
+            AddWad(path, entry->d_name);
+    closedir(dir);
+}
+
+// IWADs first in the known order, then mods by name
+static int CompareWads(const void *pa, const void *pb)
+{
+    const wad_entry_t *a = pa, *b = pb;
+
+    if (a->iwad != b->iwad)
+        return a->iwad ? -1 : 1;
+    if (a->known != b->known)
+        return a->known - b->known;
+    return strcasecmp(a->title, b->title);
+}
+
+static boolean IsShareware(const wad_entry_t *w)
+{
+    return strcasecmp(strrchr(w->path, '/') + 1, "doom1.wad") == 0;
+}
+
+static void FindWads(void)
+{
+    char cwd[128] = "";
+    int i, j;
+
+    // The ROM, the directory the .nds was launched from, the data folder and the SD root
+    ScanDir("nitro:/");
+    if (have_fat)
+    {
+        if (getcwd(cwd, sizeof(cwd)) != NULL)
+            ScanDir(cwd);
+        ScanDir(DATA_DIR);
+        ScanDir("/");
+    }
+    qsort(wads, num_wads, sizeof(wad_entry_t), CompareWads);
+
+    // Mods run on the first IWAD with the same kind of levels, the
+    // shareware version refuses to load mods
+    for (i = 0; i < num_wads; ++i)
+    {
+        wads[i].base = wads[i].iwad ? i : -1;
+        for (j = 0; j < num_wads && wads[i].base < 0; ++j)
+            if (wads[j].iwad && !IsShareware(&wads[j])
+             && (!wads[i].has_maps || wads[j].commercial == wads[i].commercial))
+                wads[i].base = j;
+    }
+}
+
+// Shows the game's own title picture on the top screen, a mod's if it has one
+static void ShowTitle(const wad_entry_t *w)
+{
+    static byte black[768];
+    const char *base = w->base >= 0 ? wads[w->base].path : w->path;
+    int title_len = 0, pal_len = 0;
+    byte *title = ReadLump(w->path, "TITLEPIC", &title_len);
+    byte *pal = ReadLump(w->path, "PLAYPAL", &pal_len);
+    byte *pixels = calloc(SCREENWIDTH, SCREENHEIGHT);
+
+    if (title == NULL)
+        title = ReadLump(base, "TITLEPIC", &title_len);
+    if (pal == NULL)
+        pal = ReadLump(base, "PLAYPAL", &pal_len);
+    if (pixels == NULL)
+        return;
+    if (title != NULL && pal != NULL && pal_len >= 768 && title_len >= 8
+     && SHORT(((patch_t *) title)->width) <= SCREENWIDTH
+     && 8 + SHORT(((patch_t *) title)->width) * 4 <= title_len)
+        DrawPatchTo(pixels, SCREENWIDTH, SCREENHEIGHT, 0, 0, (patch_t *) title, NULL);
+    I_NDS_ShowSplash(pixels, pal != NULL && pal_len >= 768 ? pal : black);
+    free(title);
+    free(pal);
+    free(pixels);
+}
+
+static void PrintHeader(void)
+{
+    consoleClear();
+    printf("\x1b[31;1m  DOOM\x1b[39;0m for Nintendo %s\n", isDSiMode() ? "DSi" : "DS");
+    printf("\x1b[30;1m  doomgeneric %s RAM\x1b[39;0m\n", isDSiMode() ? "16 MB" : "4 MB");
+    printf("\x1b[31m--------------------------------\x1b[39m");
+}
+
+#define LAST_WAD_FILE  DATA_DIR "/last-wad.txt"
+#define PICKER_ROW     6
+#define PICKER_ROWS    15
+
+static int LastWad(void)
+{
+    char buf[256] = "";
+    FILE *f = fopen(LAST_WAD_FILE, "r");
+    int i;
+
+    if (f == NULL)
+        return 0;
+    if (fgets(buf, sizeof(buf), f) == NULL)
+        buf[0] = '\0';
+    fclose(f);
+    for (i = 0; i < num_wads; ++i)
+        if (strcmp(buf, wads[i].path) == 0 && wads[i].base >= 0)
+            return i;
+    return 0;
+}
+
+static void SaveLastWad(int index)
+{
+    FILE *f;
+
+    MakeDataDir();
+    if ((f = fopen(LAST_WAD_FILE, "w")) != NULL)
+    {
+        fputs(wads[index].path, f);
+        fclose(f);
+    }
+}
+
+static void DrawPicker(int selected, int top)
+{
+    int i;
+
+    PrintHeader();
+    printf("\n  Choose your game:\n\n");
+    for (i = top; i < num_wads && i < top + PICKER_ROWS; ++i)
+    {
+        const wad_entry_t *w = &wads[i];
+        const char *color = i == selected ? "\x1b[33;1m" : w->base < 0 ? "\x1b[30;1m" : "";
+
+        printf("%s  %c %s%s", color, i == selected ? '>' : ' ', w->iwad ? "" : "+ ", w->title);
+        if (w->base < 0)
+            printf(" (needs %s)", w->commercial ? "DOOM II" : "DOOM");
+        else if (!w->iwad)
+            printf("\x1b[30;1m (%s)", wads[w->base].title);
+        printf("\x1b[39;0m\n");
+    }
+    printf("\x1b[22;0H\x1b[31m--------------------------------\x1b[39m");
+    printf("\x1b[30;1m  UP/DOWN pick   A or tap: play\x1b[39;0m");
+}
+
+static const wad_entry_t *PickWad(void)
+{
+    int selected, top = 0, i;
+
+    FindWads();
+    if (num_wads == 0)
+    {
+        PrintHeader();
+        printf("\n\n\x1b[31;1m  No game data found!\x1b[39;0m\n\n"
+               "  Copy doom.wad, doom2.wad,\n"
+               "  tnt.wad or plutonia.wad\n"
+               "  to /data/doom/ on the SD card,\n"
+               "  or embed one in the ROM at\n"
+               "  build time (see README).\n\n"
+               "  Press START to exit\n");
+        do
+        {
+            threadWaitForVBlank();
+            scanKeys();
+        } while (!(keysDown() & KEY_START));
+        exit(1);
+    }
+
+    selected = LastWad();
+    ShowTitle(&wads[selected]);
+    if (num_wads == 1)
+        return &wads[0];
+
+    for (;;)
+    {
+        u32 down;
+        int prev = selected;
+
+        if (selected < top)
+            top = selected;
+        else if (selected >= top + PICKER_ROWS)
+            top = selected - PICKER_ROWS + 1;
+        DrawPicker(selected, top);
+        do
+        {
+            threadWaitForVBlank();
+            scanKeys();
+            down = keysDown();
+            if ((down & (KEY_A | KEY_START)) && wads[selected].base >= 0)
+                goto chosen;
+            if (down & KEY_TOUCH)
+            {
+                touchPosition touch;
+
+                touchRead(&touch);
+                i = top + touch.py / 8 - PICKER_ROW;
+                if (i >= top && i < num_wads && i < top + PICKER_ROWS && wads[i].base >= 0)
+                {
+                    selected = i;
+                    goto chosen;
+                }
+            }
+            if (down & KEY_UP)
+                selected = (selected + num_wads - 1) % num_wads;
+            if (down & KEY_DOWN)
+                selected = (selected + 1) % num_wads;
+        } while (selected == prev);
+        ShowTitle(&wads[selected]);
+    }
+
+chosen:
+    SaveLastWad(selected);
+    ShowTitle(&wads[selected]);
+    return &wads[selected];
+}
+
+// Config and savegames go to the data folder on the SD card when one is available
+static void EnterDataDir(void)
+{
+    if (!have_fat)
+    {
+        printf("\x1b[33;1m  No SD card, saving is off\x1b[39;0m\n");
+        return;
+    }
+    MakeDataDir();
+    if (chdir(DATA_DIR) != 0)
+        printf("\x1b[33;1m  Can't open " DATA_DIR ",\n  saving is off\x1b[39;0m\n");
+}
