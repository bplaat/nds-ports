+#endif
 // add additional movement on top of the keyboard move cmd
 
 void IN_ClearStates (void);
diff --git a/WinQuake/vid.h b/WinQuake/vid.h
index 0001882..669205a 100644
--- a/WinQuake/vid.h
+++ b/WinQuake/vid.h
@@ -76,6 +76,11 @@ void	VID_Flush3D (void);
 
 void	VID_MarkRows (int y, int height);
 // the 2D drawing changed these rows, only they are copied to the touch screen
+
+qboolean	VID_BeginUI (int top, int bottom);
+void		VID_EndUI (void);
+// the touch screen UI keeps rows top to bottom out of the view rectangle that
+// is cleared every frame, BeginUI returns true when something else drew there
 #endif
 // Called at startup to set up translation tables, takes 256 8 bit RGB values
 // the palette data will go away after the call, so it must be copied off if
diff --git a/WinQuake/vid_nds.c b/WinQuake/vid_nds.c
index d6115a2..35295b8 100644
--- a/WinQuake/vid_nds.c
+++ b/WinQuake/vid_nds.c
@@ -61,9 +61,12 @@ static int		smoothing = -1;
 static byte		screengamma[256];
 
 // Rows changed this frame, to copy to VRAM, and rows drawn this and the last
-// frame, the view rectangle is cleared where something was drawn before
-static int		copy_top, copy_bottom;
-static int		drawn_top, drawn_bottom, olddrawn_top, olddrawn_bottom;
+// frames, the view rectangle is cleared where something was drawn before
+static byte		copyrows[BASEHEIGHT], drawnrows[BASEHEIGHT], olddrawnrows[BASEHEIGHT];
+
+// Rows the touch screen UI keeps, it redraws them when something else drew there
+static int		ui_top, ui_bottom;
+static qboolean	ui_drawing, ui_overdrawn;
 static byte		vid_buffer[BASEWIDTH * BASEHEIGHT] __attribute__((aligned(32)));
 
 static void VID_VBlank (void)
@@ -189,27 +192,43 @@ only redraws what changed
 */
 void VID_ClearRect (vrect_t *rect)
 {
-	int	y, top, bottom;
+	int	y;
 
-	top = max (rect->y, olddrawn_top);
-	bottom = min (rect->y + rect->height, olddrawn_bottom);
-	for (y = top; y < bottom; y++)
-		memset (vid.buffer + y * vid.rowbytes + rect->x, 0, rect->width);
-	if (top < bottom)
+	for (y = rect->y; y < rect->y + rect->height; y++)
 	{
-		copy_top = min (copy_top, top);
-		copy_bottom = max (copy_bottom, bottom);
+		if (!olddrawnrows[y] || (y >= ui_top && y < ui_bottom))
+			continue;
+		memset (vid.buffer + y * vid.rowbytes + rect->x, 0, rect->width);
+		olddrawnrows[y] = 0;
+		copyrows[y] = 1;
 	}
-	olddrawn_top = BASEHEIGHT;
-	olddrawn_bottom = 0;
 }
 
 void VID_MarkRows (int y, int height)
 {
+	int	bottom = min (y + height, BASEHEIGHT);
+
 	y = max (y, 0);
-	height = min (y + height, BASEHEIGHT);
-	copy_top = drawn_top = min (drawn_top, y);
-	copy_bottom = drawn_bottom = max (drawn_bottom, height);
+	if (!ui_drawing && y < ui_bottom && bottom > ui_top)
+		ui_overdrawn = true;
+	memset (drawnrows + y, 1, max (bottom - y, 0));
+	memset (copyrows + y, 1, max (bottom - y, 0));
+}
+
+qboolean VID_BeginUI (int top, int bottom)
+{
+	qboolean	overdrawn = ui_overdrawn;
+
+	ui_top = top;
+	ui_bottom = bottom;
+	ui_overdrawn = false;
+	ui_drawing = true;
+	return overdrawn;
+}
+
+void VID_EndUI (void)
+{
+	ui_drawing = false;
 }
 
 /*
@@ -253,25 +272,23 @@ void VID_Update (vrect_t *rects)
 	int	y;
 	u32	*src, *dst;
 
+	IN_DrawTouchScreen ();
 	if (vid_showfps.value)
 		VID_DrawFPS ();
 
 	if (smoothing != (vid_smooth.value != 0))
 		VID_SetSmoothing (vid_smooth.value != 0);
 
-	src = (u32 *) (vid.buffer + copy_top * BASEWIDTH);
-	dst = (u32 *) BG_BMP_RAM_SUB(0) + copy_top * FB_STRIDE / 4;
-	for (y = copy_top; y < copy_bottom; y++)
+	src = (u32 *) vid.buffer;
+	dst = (u32 *) BG_BMP_RAM_SUB(0);
+	for (y = 0; y < BASEHEIGHT; y++, src += BASEWIDTH / 4, dst += FB_STRIDE / 4)
 	{
-		memcpy (dst, src, BASEWIDTH);
-		src += BASEWIDTH / 4;
-		dst += FB_STRIDE / 4;
+		if (copyrows[y])
+			memcpy (dst, src, BASEWIDTH);
+		olddrawnrows[y] |= drawnrows[y];
 	}
-
-	olddrawn_top = min (olddrawn_top, drawn_top);
-	olddrawn_bottom = max (olddrawn_bottom, drawn_bottom);
-	copy_top = drawn_top = BASEHEIGHT;
-	copy_bottom = drawn_bottom = 0;
+	memset (copyrows, 0, sizeof(copyrows));
+	memset (drawnrows, 0, sizeof(drawnrows));
 }
 
