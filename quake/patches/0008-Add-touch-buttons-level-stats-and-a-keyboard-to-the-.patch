 #include "quakedef.h"
 
@@ -61,6 +63,198 @@ static int	held_key[NUM_BUTTONS];
 
 static qboolean	touching;
 static int	touch_x, touch_y, mouse_x, mouse_y;
+static int	touch_key;		// held by the stylus
+
+// Touch buttons in 2D coordinates, 320x200
+typedef struct
+{
+	int			x, y, w, h;
+	int			key;
+	const char	*label;		// NULL when the status bar draws it
+} touchbutton_t;
+
+#define	BUTTONS_Y	130
+#define	STATS_Y		104
+
+static const touchbutton_t gamebuttons[] =
+{
+	{  0, BUTTONS_Y, 80, 20, K_SPACE, "JUMP"},			// +jump
+	{ 80, BUTTONS_Y, 80, 20, K_TAB, "SCORES"},			// +showscores
+	{160, BUTTONS_Y, 80, 20, K_END, "CENTER"},			// centerview
+	{240, BUTTONS_Y, 80, 20, '`', "CONSOLE"},			// toggleconsole
+	// the weapon icons of the status bar: impulse 2 to 8
+	{  0, 152, 24, 24, '2', NULL},
+	{ 24, 152, 24, 24, '3', NULL},
+	{ 48, 152, 24, 24, '4', NULL},
+	{ 72, 152, 24, 24, '5', NULL},
+	{ 96, 152, 24, 24, '6', NULL},
+	{120, 152, 24, 24, '7', NULL},
+	{144, 152, 24, 24, '8', NULL},
+};
+
+#define	NUM_GAMEBUTTONS	(sizeof(gamebuttons) / sizeof(gamebuttons[0]))
+
+// The keyboard with the console, over the status bar: backspace, enter,
+// space and ~ to close the console
+#define	KEYBOARD_X		4
+#define	KEYBOARD_Y		104
+#define	KEY_W			26
+#define	KEY_H			24
+#define	KEYS_PER_ROW	12
+
+static const char *keyrows[] =
+{
+	"1234567890-\b",
+	"qwertyuiop+=",
+	"asdfghjkl;\"\r",
+	"zxcvbnm,./~ ",
+};
+
+#define	NUM_KEYROWS	(sizeof(keyrows) / sizeof(keyrows[0]))
+
+static qboolean	keyboard_shown;
+static char		drawn_state[64];	// what the UI shows, redrawn when it changes
+
+static qboolean IN_KeyboardActive (void)
+{
+	return key_dest == key_console || key_dest == key_message;
+}
+
+// The key of the keyboard at a 2D position, 0 for none
+static int IN_KeyboardKey (int x, int y)
+{
+	int	row, col, c;
+
+	row = (y - KEYBOARD_Y) / KEY_H;
+	col = (x - KEYBOARD_X) / KEY_W;
+	if (y < KEYBOARD_Y || x < KEYBOARD_X || row >= NUM_KEYROWS || col >= KEYS_PER_ROW)
+		return 0;
+	c = keyrows[row][col];
+	switch (c)
+	{
+	case '\b':	return K_BACKSPACE;
+	case '\r':	return K_ENTER;
+	case '~':	return '`';
+	default:	return c;
+	}
+}
+
+// The key under the stylus at a 2D position, 0 when dragging looks around
+static int IN_TouchKey (int x, int y)
+{
+	const touchbutton_t	*b;
+	int					i;
+
+	if (IN_KeyboardActive ())
+		return IN_KeyboardKey (x, y);
+	if (key_dest != key_game)
+		return 0;
+	for (i = 0, b = gamebuttons; i < NUM_GAMEBUTTONS; i++, b++)
+		if (x >= b->x && x < b->x + b->w && y >= b->y && y < b->y + b->h)
+			return b->key;
+	return 0;
+}
+
+static void IN_DrawButton (int x, int y, int w, int h, const char *label, qboolean pressed)
+{
+	Draw_Fill (x + 1, y + 1, w - 2, h - 2, pressed ? 6 : 2);
+	Draw_Fill (x + 1, y + h - 2, w - 2, 1, 0);
+	Draw_String (x + (w - strlen (label) * 8) / 2, y + (h - 8) / 2, (char *) label);
+}
+
+static void IN_DrawKeyboard (void)
+{
+	int		row, col, c, key;
+	char	label[4];
+
+	for (row = 0; row < NUM_KEYROWS; row++)
+		for (col = 0; col < KEYS_PER_ROW; col++)
+		{
+			c = keyrows[row][col];
+			label[0] = c;
+			label[1] = 0;
+			if (c == '\b')
+				strcpy (label, "<-");
+			else if (c == '\r')
+				strcpy (label, "ENT");
+			else if (c == ' ')
+				strcpy (label, "SPC");
+			key = IN_KeyboardKey (KEYBOARD_X + col * KEY_W, KEYBOARD_Y + row * KEY_H);
+			IN_DrawButton (KEYBOARD_X + col * KEY_W, KEYBOARD_Y + row * KEY_H, KEY_W, KEY_H,
+				label, touch_key == key);
+		}
+}
+
+// Kills, secrets and time like the solo scoreboard
+static void IN_StatsString (char *str)
+{
+	int	minutes = cl.time / 60;
+
+	sprintf (str, "KILLS %i/%i  SECRETS %i/%i  %i:%02i", cl.stats[STAT_MONSTERS],
+		cl.stats[STAT_TOTALMONSTERS], cl.stats[STAT_SECRETS], cl.stats[STAT_TOTALSECRETS],
+		minutes, (int) cl.time - 60 * minutes);
+}
+
+/*
+================
+IN_DrawTouchScreen
+
+Called by VID_Update after the 2D drawing of a frame, redraws what changed
+================
+*/
+void IN_DrawTouchScreen (void)
+{
+	const touchbutton_t	*b;
+	char				state[sizeof(drawn_state)], stats[40];
+	int					i, top, bottom;
+	qboolean			overdrawn;
+
+	if (IN_KeyboardActive ())
+	{
+		top = KEYBOARD_Y;
+		bottom = vid.height;
+		sprintf (state, "keyboard %i", touch_key);
+		keyboard_shown = true;
+	}
+	else
+	{
+		if (keyboard_shown)
+		{
+			// the keyboard was over the status bar
+			Sbar_Changed ();
+			keyboard_shown = false;
+		}
+		if (key_dest != key_game || cls.state != ca_connected || scr_con_current || cl.intermission)
+		{
+			VID_BeginUI (0, 0);
+			VID_EndUI ();
+			drawn_state[0] = 0;
+			return;
+		}
+		top = STATS_Y;
+		bottom = vid.height - sb_lines;
+		IN_StatsString (stats);
+		sprintf (state, "game %i %s", touch_key, stats);
+	}
+
+	overdrawn = VID_BeginUI (top, bottom);
+	if (overdrawn || strcmp (state, drawn_state))
+	{
+		strcpy (drawn_state, state);
+		Draw_Fill (0, top, vid.width, bottom - top, 0);
+		if (keyboard_shown)
+			IN_DrawKeyboard ();
+		else
+		{
+			Draw_String ((vid.width - strlen (cl.levelname) * 8) / 2, STATS_Y, cl.levelname);
+			Draw_String ((vid.width - strlen (stats) * 8) / 2, STATS_Y + 12, stats);
+			for (i = 0, b = gamebuttons; i < NUM_GAMEBUTTONS; i++, b++)
+				if (b->label)
+					IN_DrawButton (b->x, b->y, b->w, b->h, b->label, touch_key == b->key);
+		}
+	}
+	VID_EndUI ();
+}
 
 void IN_Init (void)
 {
@@ -97,7 +291,14 @@ void Sys_SendKeyEvents (void)
 	if (keysHeld () & KEY_TOUCH)
 	{
 		touchRead (&touch);
-		if (touching)
+		if (!touching)
+		{
+			// a new touch presses a button or starts dragging, in 2D coordinates
+			touch_key = IN_TouchKey (touch.px * vid.width / 256, touch.py * vid.height / 192);
+			if (touch_key)
+				Key_Event (touch_key, true);
+		}
+		else if (!touch_key)
 		{
 			mouse_x += touch.px - touch_x;
 			mouse_y += touch.py - touch_y;
@@ -106,8 +307,13 @@ void Sys_SendKeyEvents (void)
 		touch_y = touch.py;
 		touching = true;
 	}
-	else
+	else if (touching)
+	{
+		if (touch_key)
+			Key_Event (touch_key, false);
+		touch_key = 0;
 		touching = false;
+	}
 }
 
 void IN_Commands (void)
