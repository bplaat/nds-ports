 // this silliness is so we can load 1.06 save files, which have float skill values
-	fscanf (f, "%f\n", &tfloat);
+	tfloat = Q_atof (COM_ReadWord (f, str, sizeof(str)));
 	current_skill = (int)(tfloat + 0.1);
 	Cvar_SetValue ("skill", (float)current_skill);
 
@@ -636,8 +636,8 @@ void Host_Loadgame_f (void)
 	Cvar_SetValue ("teamplay", 0);
 #endif
 
-	fscanf (f, "%s\n",mapname);
-	fscanf (f, "%f\n",&time);
+	COM_ReadWord (f, mapname, sizeof(mapname));
+	time = Q_atof (COM_ReadWord (f, str, sizeof(str)));
 
 	CL_Disconnect_f ();
 	
@@ -659,7 +659,7 @@ void Host_Loadgame_f (void)
 
 	for (i=0 ; i<MAX_LIGHTSTYLES ; i++)
 	{
-		fscanf (f, "%s\n", str);
+		COM_ReadWord (f, str, sizeof(str));
 		sv.lightstyles[i] = Hunk_Alloc (strlen(str)+1);
 		strcpy (sv.lightstyles[i], str);
 	}
