+
+static void R_MarkLeaves (void)
+{
+	byte	*vis;
+	mnode_t	*node;
+	int		i;
+	static byte	solid[MAX_MAP_LEAFS/8];
+
+	if (r_oldviewleaf == r_viewleaf && !r_novis.value)
+		return;
+
+	r_visframecount++;
+	r_oldviewleaf = r_viewleaf;
+
+	if (r_novis.value)
+	{
+		vis = solid;
+		memset (solid, 0xff, (cl.worldmodel->numleafs+7)>>3);
+	}
+	else
+		vis = Mod_LeafPVS (r_viewleaf, cl.worldmodel);
+
+	for (i=0 ; i<cl.worldmodel->numleafs ; i++)
+	{
+		if (vis[i>>3] & (1<<(i&7)))
+		{
+			node = (mnode_t *)&cl.worldmodel->leafs[i+1];
+			do
+			{
+				if (node->visframe == r_visframecount)
+					break;
+				node->visframe = r_visframecount;
+				node = node->parent;
+			} while (node);
+		}
+	}
+}
+
+/*
+================
+R_CullNode
+
+Frustum test of a node's bounding box in fixed point. Returns the planes its
+children still need testing against, as a node inside a plane is too, or -1
+when it's outside.
+================
+*/
+static int R_CullNode (mnode_t *node, int clipflags)
+{
+	int		i, *f;
+	short	*mins = node->minmaxs, *maxs = node->minmaxs + 3;
+
+	for (i = 0, f = frustum_i[0]; i < 4; i++, f += 4)
+	{
+		if (!(clipflags & (1 << i)))
+			continue;
+		// the corner furthest along the normal is outside, the whole box is
+		if ((f[0] >= 0 ? maxs[0] : mins[0]) * f[0] + (f[1] >= 0 ? maxs[1] : mins[1]) * f[1] +
+			(f[2] >= 0 ? maxs[2] : mins[2]) * f[2] < f[3])
+			return -1;
+		// the nearest corner is inside, the whole box is
+		if ((f[0] >= 0 ? mins[0] : maxs[0]) * f[0] + (f[1] >= 0 ? mins[1] : maxs[1]) * f[1] +
+			(f[2] >= 0 ? mins[2] : maxs[2]) * f[2] >= f[3])
+			clipflags &= ~(1 << i);
+	}
+	return clipflags;
+}
+
+static void R_RecursiveWorldNode (mnode_t *node, int clipflags)
+{
+	int			c, side, dot;
+	mplane_t	*plane;
+	msurface_t	*surf, **mark;
+	mleaf_t		*pleaf;
+	texture_t	*t;
+
+	if (node->contents == CONTENTS_SOLID)
+		return;		// solid
+
+	if (node->visframe != r_visframecount)
+		return;
+	if (clipflags && (clipflags = R_CullNode (node, clipflags)) < 0)
+		return;
+
+// if a leaf node, draw stuff
+	if (node->contents < 0)
+	{
+		pleaf = (mleaf_t *)node;
+
+		mark = pleaf->firstmarksurface;
+		c = pleaf->nummarksurfaces;
+
+		if (c)
+		{
+			do
+			{
+				(*mark)->visframe = r_framecount;
+				mark++;
+			} while (--c);
+		}
+
+	// deal with model fragments in this leaf
+		if (pleaf->efrags)
+			R_StoreEfrags (&pleaf->efrags);
+
+		return;
+	}
+
+// node is just a decision point, so go down the apropriate sides
+
+// find which side of the node we are on
+	plane = node->plane;
+	dot = plane->inormal[0] * modelorg_i[0] + plane->inormal[1] * modelorg_i[1] +
+		plane->inormal[2] * modelorg_i[2] - plane->idist;
+	side = dot < 0;
+
+// recurse down the children, front side first
+	R_RecursiveWorldNode (node->children[side], clipflags);
+
+// add the surfaces facing us to their texture chain
+	c = node->numsurfaces;
+	if (c)
+	{
+		surf = cl.worldmodel->surfaces + node->firstsurface;
+		for ( ; c ; c--, surf++)
+		{
+			if (surf->visframe != r_framecount)
+				continue;
+			if ((dot < 0) ^ !!(surf->flags & SURF_PLANEBACK))
+				continue;		// wrong side
+			t = surf->texinfo->texture;
+			surf->texturechain = t->texturechain;
+			t->texturechain = surf;
+		}
+	}
+
+// recurse down the back side
+	R_RecursiveWorldNode (node->children[!side], clipflags);
+}
+
+static void R_DrawWorld (void)
+{
+	int			i;
+	model_t		*mod = cl.worldmodel;
+	texture_t	*t, *anim;
+	msurface_t	*s;
+
+	currententity = &r_worldentity;
+	VectorCopy (r_origin, modelorg);
+
+	for (i = 0; i < mod->numtextures; i++)
+		if (mod->textures[i])
+			mod->textures[i]->texturechain = NULL;
+	r_notexture_mip->texturechain = NULL;
+
+	for (i = 0; i < 3; i++)
+		modelorg_i[i] = modelorg[i] * VERTEX_SCALE;
+	R_RecursiveWorldNode (mod->nodes, 15);
+
+	for (i = 0; i <= mod->numtextures; i++)
+	{
+		t = i < mod->numtextures ? mod->textures[i] : r_notexture_mip;
+		if (!t || !t->texturechain)
+			continue;
+		anim = R_TextureAnimation (t);
+		R_BindBrushTexture (anim, t->texturechain);
+		for (s = t->texturechain; s; s = s->texturechain)
+			R_DrawGXSurface (mod, s);
+	}
+}
