+/*
+===============================================================================
+
+ALIAS MODELS
+
+===============================================================================
+*/
+
+static trivertx_t *R_AliasFrame (aliashdr_t *paliashdr, mdl_t *pmdl, entity_t *e)
+{
+	int				frame, i, numframes;
+	maliasgroup_t	*paliasgroup;
+	float			*pintervals, fullinterval, targettime, time;
+
+	frame = e->frame;
+	if ((frame >= pmdl->numframes) || (frame < 0))
+		frame = 0;
+
+	if (paliashdr->frames[frame].type == ALIAS_SINGLE)
+		return (trivertx_t *)((byte *)paliashdr + paliashdr->frames[frame].frame);
+
+	paliasgroup = (maliasgroup_t *)((byte *)paliashdr + paliashdr->frames[frame].frame);
+	pintervals = (float *)((byte *)paliashdr + paliasgroup->intervals);
+	numframes = paliasgroup->numframes;
+	fullinterval = pintervals[numframes-1];
+
+	time = cl.time + e->syncbase;
+	targettime = time - ((int)(time / fullinterval)) * fullinterval;
+	for (i=0 ; i<(numframes-1) ; i++)
+		if (pintervals[i] > targettime)
+			break;
+
+	return (trivertx_t *)((byte *)paliashdr + paliasgroup->frames[i].frame);
+}
+
+static int R_AliasSkin (aliashdr_t *paliashdr, mdl_t *pmdl, entity_t *e)
+{
+	int					skinnum, i, numskins;
+	maliasskindesc_t	*pskindesc;
+	maliasskingroup_t	*paliasskingroup;
+	float				*pskinintervals, fullskininterval, skintargettime, skintime;
+
+	skinnum = e->skinnum;
+	if ((skinnum >= pmdl->numskins) || (skinnum < 0))
+		skinnum = 0;
+
+	pskindesc = ((maliasskindesc_t *)((byte *)paliashdr + paliashdr->skindesc)) + skinnum;
+	if (pskindesc->type == ALIAS_SKIN_GROUP)
+	{
+		paliasskingroup = (maliasskingroup_t *)((byte *)paliashdr + pskindesc->skin);
+		pskinintervals = (float *)((byte *)paliashdr + paliasskingroup->intervals);
+		numskins = paliasskingroup->numskins;
+		fullskininterval = pskinintervals[numskins-1];
+		skintime = cl.time + e->syncbase;
+		skintargettime = skintime - ((int)(skintime / fullskininterval)) * fullskininterval;
+		for (i=0 ; i<(numskins-1) ; i++)
+			if (pskinintervals[i] > skintargettime)
+				break;
+		pskindesc = &paliasskingroup->skindescs[i];
+	}
+	return pskindesc->skin;
+}
+
+// R_LightPoint, looked up again when the model moved or a while ago
+static int R_AliasLight (entity_t *e)
+{
+	lightcache_t	*c = &lightcache[((unsigned) e >> 3) % LIGHTCACHE_SIZE];
+
+	if (c->entity != e || !VectorCompare (c->origin, e->origin) ||
+		r_framecount - c->framecount >= LIGHTCACHE_FRAMES)
+	{
+		c->entity = e;
+		VectorCopy (e->origin, c->origin);
+		c->light = R_LightPoint (e->origin);
+		c->framecount = r_framecount;
+	}
+	return c->light;
+}
+
+static void R_DrawAliasModel (entity_t *e, int minlight)
+{
+	model_t		*clmodel = e->model;
+	aliashdr_t	*paliashdr;
+	mdl_t		*pmdl;
+	trivertx_t	*verts, *v;
+	mtriangle_t	*tris;
+	gxalias_t	*gx;
+	gxtex_t		*tex = NULL;
+	vec3_t		mins, maxs, angles, forward, right, up, dist;
+	float		m[4][3], add;
+	int			i, j, skin, lnum, light, shade, n;
+	unsigned	*st;
+	u16			*dots;
+
+	paliashdr = Mod_Extradata (clmodel);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+
+	for (i = 0; i < 3; i++)
+	{
+		mins[i] = e->origin[i] - pmdl->boundingradius;
+		maxs[i] = e->origin[i] + pmdl->boundingradius;
+	}
+	if (minlight == 0 && R_CullBox (mins, maxs))
+		return;
+
+	gx = clmodel->gxalias;
+	if (!gx || pmdl->numverts > MAXALIASVERTS)
+		return;
+	skin = R_AliasSkin (paliashdr, pmdl, e);
+	for (i = 0; i < gx->numskins; i++)
+		if (gx->skins[i].offset == skin)
+			tex = &gx->skins[i].tex;
+	if (!tex)
+		return;
+
+	// lighting like the software renderer, shaded by the normals like GLQuake
+	light = R_AliasLight (e);
+	if (light < minlight)
+		light = minlight;
+	for (lnum = 0; lnum < r_numdlights; lnum++)
+	{
+		VectorSubtract (e->origin, r_dlights[lnum]->origin, dist);
+		add = r_dlights[lnum]->radius;
+		if (DotProduct (dist, dist) < add * add)
+			light += add - Length (dist);
+	}
+	if (light > 192)
+		light = 192;
+	// 1.0 at 200 like GLQuake, times the 8.8 normal dots
+	shade = light * GX_NORMAL_LIGHT * 256 / 200;
+	dots = gx_dots[((int)(e->angles[1] * (SHADEDOT_QUANT / 360.0))) & (SHADEDOT_QUANT - 1)];
+
+	// the vertices are bytes scaled by the model, the "stupid quake bug"
+	// flips the pitch of alias models
+	angles[0] = -e->angles[0];
+	angles[1] = e->angles[1];
+	angles[2] = e->angles[2];
+	AngleVectors (angles, forward, right, up);
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i] * pmdl->scale[0] * (4096 * MATRIX_SCALE_W);
+		m[1][i] = -right[i] * pmdl->scale[1] * (4096 * MATRIX_SCALE_W);
+		m[2][i] = up[i] * pmdl->scale[2] * (4096 * MATRIX_SCALE_W);
+		m[3][i] = (e->origin[i] + forward[i] * pmdl->scale_origin[0] -
+			right[i] * pmdl->scale_origin[1] + up[i] * pmdl->scale_origin[2]) * MATRIX_SCALE_W;
+	}
+	MATRIX_PUSH = 0;
+	R_LoadMatrix (m, true);
+
+	R_BindTexture (tex->param, tex->scale);
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_FRONT;
+
+	// each vertex once, then the triangles
+	verts = R_AliasFrame (paliashdr, pmdl, e);
+	for (i = 0, v = verts; i < pmdl->numverts; i++, v++)
+	{
+		alias_color[i] = GRAY (MIN ((dots[v->lightnormalindex] * shade) >> 16, 31));
+		alias_xy[i] = v->v[0] | (v->v[1] << 16);
+		alias_z[i] = v->v[2];
+	}
+
+	tris = (mtriangle_t *)((byte *)paliashdr + paliashdr->triangles);
+	GFX_BEGIN = GL_TRIANGLES;
+	for (i = 0; i < pmdl->numtris; i++, tris++)
+	{
+		st = tris->facesfront ? gx->st : gx->st + pmdl->numverts;
+		for (j = 0; j < 3; j++)
+		{
+			n = tris->vertindex[j];
+			GFX_COLOR = alias_color[n];
+			GFX_TEX_COORD = st[n];
+			GFX_VERTEX16 = alias_xy[n];
+			GFX_VERTEX16 = alias_z[n];
+		}
+	}
+	c_alias_polys += pmdl->numtris;
+
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+	MATRIX_POP = 1;
+}
