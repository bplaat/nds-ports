+
+// Nearest power of two, where the sizes Quake has in between round down
+static int R_TexSize (int size, int max)
+{
+	int	p;
+
+	for (p = 8; p < max && p * 3 / 2 < size; p <<= 1)
+		;
+	return p;
+}
+
+static int R_Log2 (int n)
+{
+	int	i;
+
+	for (i = 0; (1 << i) < n; i++)
+		;
+	return i;
+}
+
+static void R_MapTextures (qboolean cpu)
+{
+	if (tex_mapped == cpu)
+		return;
+	tex_mapped = cpu;
+	if (cpu)
+	{
+		vramSetBankA (VRAM_A_LCD);
+		vramSetBankB (VRAM_B_LCD);
+		vramSetBankD (VRAM_D_LCD);
+	}
+	else
+	{
+		vramSetBankA (VRAM_A_TEXTURE_SLOT0);
+		vramSetBankB (VRAM_B_TEXTURE_SLOT1);
+		vramSetBankD (VRAM_D_TEXTURE_SLOT2);
+	}
+}
+
+// Address of texture memory while it's mapped for the CPU
+static u16 *R_TexVRAM (int offset)
+{
+	return offset < TEXMEM_MODELS ? VRAM_A + offset / 2 : VRAM_D + (offset - TEXMEM_MODELS) / 2;
+}
+
+/*
+================
+R_UploadTexture
+
+Resamples a width x height 8-bit image with the given row stride to w x h in
+VRAM at *mem, returns the texture parameters. With transparent set the
+index 255 of sprites becomes the hardware's transparent 0.
+================
+*/
+static unsigned R_UploadTexture (const byte *pixels, int stride, int width, int height,
+	int w, int h, int *mem, qboolean transparent)
+{
+	int			x, y, offset;
+	const byte	*row;
+	byte		p[2];
+	u16			*dst;
+
+	offset = *mem;
+	*mem += w * h;
+
+	R_MapTextures (true);
+	dst = R_TexVRAM (offset);
+	for (y = 0; y < h; y++)
+	{
+		row = pixels + (y * height / h) * stride;
+		for (x = 0; x < w; x += 2)
+		{
+			p[0] = row[x * width / w];
+			p[1] = row[(x + 1) * width / w];
+			if (transparent)
+			{
+				p[0] = p[0] == 255 ? 0 : p[0] ? p[0] : tex_black;
+				p[1] = p[1] == 255 ? 0 : p[1] ? p[1] : tex_black;
+			}
+			*dst++ = p[0] | (p[1] << 8);
+		}
+	}
+
+	return (offset >> 3) | GL_TEXTURE_WRAP_S | GL_TEXTURE_WRAP_T |
+		((R_Log2 (w) - 3) << 20) | ((R_Log2 (h) - 3) << 23) | (GL_RGB256 << 26) |
+		(transparent ? GL_TEXTURE_COLOR0_TRANSPARENT : 0) | TEXGEN_TEXCOORD;
+}
+
+// Size in VRAM of a brush texture at a mip level
+static int R_BrushTexSize (texture_t *tx, int mip)
+{
+	int	w = tx->width >> mip, h = tx->height >> mip;
+
+	// only the back layer of the sky, the right half, is drawn
+	if (!Q_strncmp (tx->name, "sky", 3))
+		w >>= 1;
+	return R_TexSize (w, MAX_TEXSIZE) * R_TexSize (h, MAX_TEXSIZE);
+}
+
+/*
+================
+R_LoadTextures
+
+Called by Mod_LoadTextures, reads the textures of a brush model from its
+lump and uploads them at the largest mip levels that fit
+================
+*/
+void R_LoadTextures (texture_t **textures, int numtextures, lump_t *l)
+{
+	int			i, mip[MAX_MAP_TEXTURES], total, avail, largest, w, h, gw, gh;
+	byte		*pixels;
+	texture_t	*tx;
+
+	if (numtextures > MAX_MAP_TEXTURES)
+		Sys_Error ("R_LoadTextures: too many textures");
+
+	// the world leaves some room for the brush models loaded after it
+	avail = TEXMEM_MODELS - tex_world;
+	if (tex_world == TEXMEM_NOTEXTURE)
+		avail -= TEXMEM_INSTANCES;
+
+	total = 0;
+	for (i = 0; i < numtextures; i++)
+	{
+		mip[i] = 0;
+		if (textures[i])
+			total += R_BrushTexSize (textures[i], 0);
+	}
+
+	// halve the largest texture until everything fits
+	while (total > avail)
+	{
+		largest = -1;
+		for (i = 0; i < numtextures; i++)
+			if (textures[i] && mip[i] < MIPLEVELS - 1 && (largest < 0 ||
+				R_BrushTexSize (textures[i], mip[i]) > R_BrushTexSize (textures[largest], mip[largest])))
+				largest = i;
+		if (largest < 0)
+			break;
+		total -= R_BrushTexSize (textures[largest], mip[largest]);
+		mip[largest]++;
+		total += R_BrushTexSize (textures[largest], mip[largest]);
+	}
+
+	for (i = 0; i < numtextures; i++)
+	{
+		tx = textures[i];
+		if (!tx)
+			continue;
+
+		w = tx->width >> mip[i];
+		h = tx->height >> mip[i];
+		if (total > avail || tex_world + R_BrushTexSize (tx, mip[i]) > TEXMEM_MODELS)
+		{
+			// out of VRAM, use the checkerboard
+			tx->gxparam[0] = tx->gxparam[1] = r_notexture_mip->gxparam[0];
+			tx->gxscale[0] = r_notexture_mip->gxscale[0] * 16 / tx->width;
+			tx->gxscale[1] = r_notexture_mip->gxscale[1] * 16 / tx->height;
+			continue;
+		}
+
+		pixels = Hunk_TempAlloc (w * h);
+		if (!pixels)
+			Sys_Error ("R_LoadTextures: not enough memory");
+		Mod_ReadLump (l, tx->offsets[mip[i]], pixels, w * h);
+
+		if (!Q_strncmp (tx->name, "sky", 3))
+		{
+			gw = R_TexSize (w / 2, MAX_TEXSIZE);
+			gh = R_TexSize (h, MAX_TEXSIZE);
+			tx->gxparam[0] = R_UploadTexture (pixels + w / 2, w, w / 2, h, gw, gh, &tex_world, false);
+			tx->gxscale[0] = (2 * gw << 12) / (tx->width / 2);
+		}
+		else
+		{
+			gw = R_TexSize (w, MAX_TEXSIZE);
+			gh = R_TexSize (h, MAX_TEXSIZE);
+			tx->gxparam[0] = R_UploadTexture (pixels, w, w, h, gw, gh, &tex_world, false);
+			tx->gxscale[0] = (2 * gw << 12) / tx->width;
+		}
+		tx->gxscale[1] = (2 * gh << 12) / tx->height;
+		tx->gxparam[1] = tx->gxparam[0];
+	}
+	R_MapTextures (false);
+}
+
+/*
+================
+R_InitTextures
+
+The checkerboard for missing textures, uploaded by R_Init
+================
+*/
+void R_InitTextures (void)
+{
+	r_notexture_mip = Hunk_AllocName (sizeof(texture_t), "notexture");
+	strcpy (r_notexture_mip->name, "notexture");
+	r_notexture_mip->width = r_notexture_mip->height = 16;
+}
+
+static void R_UploadNoTexture (void)
+{
+	byte	pixels[16 * 16];
+	int		x, y, mem = TEXMEM_WORLD;
+
+	for (y = 0; y < 16; y++)
+		for (x = 0; x < 16; x++)
+			pixels[y * 16 + x] = (x < 8) ^ (y < 8) ? 0 : 15;
+	r_notexture_mip->gxparam[0] = r_notexture_mip->gxparam[1] =
+		R_UploadTexture (pixels, 16, 16, 16, 16, 16, &mem, false);
+	r_notexture_mip->gxscale[0] = r_notexture_mip->gxscale[1] = 2 << 12;
+	R_MapTextures (false);
+}
+
+/*
+================
+D_FlushCaches
+
+Called by Host_ClearMemory before a new map, frees all textures
+================
+*/
+void D_FlushCaches (void)
+{
+	tex_world = TEXMEM_NOTEXTURE;
+	tex_models = TEXMEM_MODELS;
+}
+
+// Calls fn for every skin of an alias model with its pixel data
+static void R_ForEachSkin (aliashdr_t *paliashdr, void (*fn)(aliashdr_t *, int, void *), void *arg)
+{
+	mdl_t				*pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+	maliasskindesc_t	*pskindesc;
+	maliasskingroup_t	*pgroup;
+	int					i, j;
+
+	pskindesc = (maliasskindesc_t *)((byte *)paliashdr + paliashdr->skindesc);
+	for (i = 0; i < pmdl->numskins; i++, pskindesc++)
+	{
+		if (pskindesc->type == ALIAS_SKIN_SINGLE)
+		{
+			fn (paliashdr, pskindesc->skin, arg);
+			continue;
+		}
+		pgroup = (maliasskingroup_t *)((byte *)paliashdr + pskindesc->skin);
+		for (j = 0; j < pgroup->numskins; j++)
+			fn (paliashdr, pgroup->skindescs[j].skin, arg);
+	}
+}
+
+static void R_AddModelTexture (model_t *mod, int skin, mspriteframe_t *frame, int width, int height)
+{
+	modeltex_t	*t;
+
+	if (nummodeltex == MAX_MODELTEXTURES)
+		return;
+	t = &modeltex[nummodeltex++];
+	t->model = mod;
+	t->skin = skin;
+	t->frame = frame;
+	t->width = width;
+	t->height = height;
+	t->maxsize = MAX_SKINSIZE;
+}
+
+static void R_AddSkin (aliashdr_t *paliashdr, int skin, void *mod)
+{
+	mdl_t	*pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+
+	R_AddModelTexture (mod, skin, NULL, pmdl->skinwidth, pmdl->skinheight);
+}
+
+static void R_AddSprite (model_t *mod)
+{
+	msprite_t		*psprite = mod->cache.data;
+	mspritegroup_t	*pgroup;
+	int				i, j;
+
+	for (i = 0; i < psprite->numframes; i++)
+	{
+		if (psprite->frames[i].type == SPR_SINGLE)
+		{
+			R_AddModelTexture (mod, -1, psprite->frames[i].frameptr,
+				psprite->frames[i].frameptr->width, psprite->frames[i].frameptr->height);
+			continue;
+		}
+		pgroup = (mspritegroup_t *)psprite->frames[i].frameptr;
+		for (j = 0; j < pgroup->numframes; j++)
+			R_AddModelTexture (mod, -1, pgroup->frames[j], pgroup->frames[j]->width, pgroup->frames[j]->height);
+	}
+}
+
+// Allocates the hardware data of an alias model and packs its texture coordinates
+static void R_SetupAliasModel (model_t *mod, int numskins)
+{
+	aliashdr_t	*paliashdr;
+	mdl_t		*pmdl;
+	stvert_t	*stverts;
+	gxalias_t	*gx;
+	int			i, s, t;
+
+	paliashdr = Mod_Extradata (mod);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+	gx = Hunk_AllocName (sizeof(gxalias_t) + numskins * sizeof(gx->skins[0]) +
+		pmdl->numverts * 2 * sizeof(unsigned), "gxalias");
+	gx->st = (unsigned *)&gx->skins[numskins];
+	mod->gxalias = gx;
+
+	// the hunk allocation may have evicted the model, the texture
+	// coordinates are 16.16 fixed point, the hardware takes 12.4
+	paliashdr = Mod_Extradata (mod);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+	stverts = (stvert_t *)((byte *)paliashdr + paliashdr->stverts);
+	for (i = 0; i < pmdl->numverts; i++)
+	{
+		s = (stverts[i].s >> 12) + 8;
+		t = (stverts[i].t >> 12) + 8;
+		gx->st[i] = TEXTURE_PACK (s, t);
+		if (stverts[i].onseam)
+			s += pmdl->skinwidth << 3;
+		gx->st[pmdl->numverts + i] = TEXTURE_PACK (s, t);
+	}
+}
+
+static int R_ModelTexSize (modeltex_t *t)
+{
+	return R_TexSize (t->width, t->maxsize) * R_TexSize (t->height, t->maxsize);
+}
+
+/*
+================
+R_UploadModelTextures
+
+Uploads the skins of all alias models and the frames of all sprites of the
+map, halving the largest until they fit in their part of VRAM
+================
+*/
+static void R_UploadModelTextures (void)
+{
+	int			i, j, total, w, h, gw, gh, filebase = 0;
+	model_t		*mod, *filemod = NULL;
+	modeltex_t	*t, *largest;
+	gxalias_t	*skins;
+	gxtex_t		*tex;
+	byte		*pixels;
+	FILE		*f = NULL;
+
+	nummodeltex = 0;
+	for (i = 1; i < MAX_MODELS && cl.model_precache[i]; i++)
+	{
+		mod = cl.model_precache[i];
+		mod->gxalias = NULL;
+		if (mod->type == mod_alias)
+			R_ForEachSkin (Mod_Extradata (mod), R_AddSkin, mod);
+		else if (mod->type == mod_sprite)
+			R_AddSprite (mod);
+	}
+
+	for (;;)
+	{
+		total = 0;
+		largest = NULL;
+		for (i = 0, t = modeltex; i < nummodeltex; i++, t++)
+		{
+			total += R_ModelTexSize (t);
+			if (t->maxsize > 8 && (!largest || R_ModelTexSize (t) > R_ModelTexSize (largest)))
+				largest = t;
+		}
+		if (total <= TEXMEM_END - TEXMEM_MODELS || !largest)
+			break;
+		largest->maxsize >>= 1;
+	}
+
+	// the hardware data of each alias model, the skins of a model were
+	// added in a row
+	for (i = 0; i < nummodeltex; i = j)
+	{
+		for (j = i + 1; j < nummodeltex && modeltex[j].model == modeltex[i].model; j++)
+			;
+		if (modeltex[i].skin >= 0)
+			R_SetupAliasModel (modeltex[i].model, j - i);
+	}
+
+	tex_models = TEXMEM_MODELS;
+	for (i = 0, t = modeltex; i < nummodeltex; i++, t++)
+	{
+		gw = R_TexSize (t->width, t->maxsize);
+		gh = R_TexSize (t->height, t->maxsize);
+		if (tex_models + gw * gh > TEXMEM_END)
+			break;
+		if (t->skin >= 0)
+		{
+			// the skins stay in the model file, see Mod_LoadAliasSkin
+			if (filemod != t->model)
+			{
+				if (f)
+					fclose (f);
+				filemod = t->model;
+				if (COM_FOpenFile (filemod->name, &f) < 0)
+					Sys_Error ("R_UploadModelTextures: can't open %s", filemod->name);
+				filebase = ftell (f);
+			}
+			pixels = Hunk_TempAlloc (t->width * t->height);
+			if (!pixels)
+				Sys_Error ("R_UploadModelTextures: not enough memory");
+			fseek (f, filebase + t->skin, SEEK_SET);
+			fread (pixels, 1, t->width * t->height, f);
+
+			skins = t->model->gxalias;
+			skins->skins[skins->numskins].offset = t->skin;
+			tex = &skins->skins[skins->numskins++].tex;
+		}
+		else
+		{
+			tex = Hunk_AllocName (sizeof(*tex), "gxsprite");
+			t->frame->pcachespot = tex;
+			pixels = t->frame->pixels;
+		}
+		tex->param = R_UploadTexture (pixels, t->width, t->width, t->height, gw, gh, &tex_models, t->skin < 0);
+		tex->scale[0] = (gw << 12) / t->width;
+		tex->scale[1] = (gh << 12) / t->height;
+	}
+	if (f)
+		fclose (f);
+	R_MapTextures (false);
+}
+
+static void R_BindTexture (unsigned param, const int *scale)
+{
+	GFX_TEX_FORMAT = param;
+	MATRIX_CONTROL = GL_TEXTURE;
+	MATRIX_IDENTITY = 0;
+	MATRIX_SCALE = scale[0];
+	MATRIX_SCALE = scale[1];
+	MATRIX_SCALE = 1 << 12;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
+
+/*
+===============================================================================
+
+BRUSH MODELS
+
+===============================================================================
+*/
+
+static int R_SurfaceStyles (msurface_t *surf)
+{
+	int	numstyles = 0;
+
+	if (surf->samples && !(surf->flags & SURF_DRAWTILED))
+		while (numstyles < MAXLIGHTMAPS && surf->styles[numstyles] != 255)
+			numstyles++;
+	return numstyles;
+}
+
+// gxsurf_t, texture coordinates, vertex indices and light, word aligned
+static int R_SurfaceSize (msurface_t *surf)
+{
+	int	n = MIN (surf->numedges, MAX_SURFVERTS);
+
+	return (sizeof(gxsurf_t) + n * 4 + ((n * 2 + 3) & ~3) + R_SurfaceStyles (surf) * n + 3) & ~3;
+}
+
+/*
+================
+R_BuildSurfaces
+
+Called by Mod_LoadBrushModel once the faces are loaded, packs the vertices,
+texture coordinates and light samples for the 3D hardware
+================
+*/
+void R_BuildSurfaces (model_t *mod)
+{
+	int			i, j, k, e, n, x, y, z, numstyles, smax, tmax, ls, lt, size;
+	byte		*data;
+	msurface_t	*surf;
+	mvertex_t	*v;
+	mtexinfo_t	*tex;
+	gxsurf_t	*gx;
+	float		st[MAX_SURFVERTS][2], mins[2], base[2];
+	unsigned	*out;
+
+	for (i = 0; i < mod->numplanes; i++)
+	{
+		for (j = 0; j < 3; j++)
+			mod->planes[i].inormal[j] = mod->planes[i].normal[j] * 16384;
+		mod->planes[i].idist = mod->planes[i].dist * (VERTEX_SCALE * 16384);
+	}
+
+	out = mod->gxvertexes = Hunk_AllocName (mod->numvertexes * 8, "gxverts");
+	for (i = 0, v = mod->vertexes; i < mod->numvertexes; i++, v++)
+	{
+		x = CLAMP (-32768, (int) (v->position[0] * VERTEX_SCALE), 32767);
+		y = CLAMP (-32768, (int) (v->position[1] * VERTEX_SCALE), 32767);
+		z = CLAMP (-32768, (int) (v->position[2] * VERTEX_SCALE), 32767);
+		*out++ = VERTEX_PACK (x, y);
+		*out++ = z & 0xffff;
+	}
+
+	// all surfaces in one allocation, the hunk rounds each up to 16 bytes
+	size = 0;
+	for (i = 0, surf = mod->surfaces; i < mod->numsurfaces; i++, surf++)
+		size += R_SurfaceSize (surf);
+	data = Hunk_AllocName (size, "gxsurf");
+
+	for (i = 0, surf = mod->surfaces; i < mod->numsurfaces; i++, surf++)
+	{
+		n = MIN (surf->numedges, MAX_SURFVERTS);
+		tex = surf->texinfo;
+		numstyles = R_SurfaceStyles (surf);
+
+		gx = surf->gx = (gxsurf_t *)data;
+		data += R_SurfaceSize (surf);
+		gx->numverts = n;
+		gx->numstyles = numstyles;
+		gx->st = (unsigned *)(gx + 1);
+		gx->verts = (unsigned short *)(gx->st + n);
+		gx->light = (byte *)gx->verts + ((n * 2 + 3) & ~3);
+
+		mins[0] = mins[1] = 999999;
+		for (j = 0; j < n; j++)
+		{
+			e = mod->surfedges[surf->firstedge + j];
+			gx->verts[j] = e >= 0 ? mod->edges[e].v[0] : mod->edges[-e].v[1];
+			v = &mod->vertexes[gx->verts[j]];
+			for (k = 0; k < 2; k++)
+			{
+				st[j][k] = DotProduct (v->position, tex->vecs[k]) + tex->vecs[k][3];
+				if (st[j][k] < mins[k])
+					mins[k] = st[j][k];
+			}
+		}
+
+		// start near 0, the hardware only takes 12 bits of texels
+		base[0] = floor (mins[0] / tex->texture->width) * tex->texture->width;
+		base[1] = floor (mins[1] / tex->texture->height) * tex->texture->height;
+
+		smax = (surf->extents[0] >> 4) + 1;
+		tmax = (surf->extents[1] >> 4) + 1;
+		for (j = 0; j < n; j++)
+		{
+			x = CLAMP (-32768, (int) ((st[j][0] - base[0]) * ST_SCALE), 32767);
+			y = CLAMP (-32768, (int) ((st[j][1] - base[1]) * ST_SCALE), 32767);
+			gx->st[j] = TEXTURE_PACK (x, y);
+
+			ls = CLAMP (0, (int) ((st[j][0] - surf->texturemins[0]) / 16 + 0.5), smax - 1);
+			lt = CLAMP (0, (int) ((st[j][1] - surf->texturemins[1]) / 16 + 0.5), tmax - 1);
+			for (k = 0; k < numstyles; k++)
+				gx->light[k * n + j] = surf->samples[k * smax * tmax + lt * smax + ls];
+		}
+	}
+}
+
+/*
+================
+R_SurfaceLight
+
+Called by RecursiveLightPoint for the light at texture position ds, dt of
+a world surface: the vertex light of its nearest vertex
+================
+*/
+int R_SurfaceLight (msurface_t *surf, int ds, int dt)
+{
+	gxsurf_t	*gx = surf->gx;
+	mtexinfo_t	*tex = surf->texinfo;
+	unsigned	*pos;
+	vec3_t		v;
+	float		s, t, d, best = 1e30;
+	int			i, k, nearest = 0, l = 0;
+
+	if (!gx->numstyles)
+		return 0;
+
+	for (i = 0; i < gx->numverts; i++)
+	{
+		pos = cl.worldmodel->gxvertexes + gx->verts[i] * 2;
+		v[0] = (short) (pos[0] & 0xffff) * (1.0f / VERTEX_SCALE);
+		v[1] = (short) (pos[0] >> 16) * (1.0f / VERTEX_SCALE);
+		v[2] = (short) (pos[1] & 0xffff) * (1.0f / VERTEX_SCALE);
+		s = DotProduct (v, tex->vecs[0]) + tex->vecs[0][3] - surf->texturemins[0] - ds;
+		t = DotProduct (v, tex->vecs[1]) + tex->vecs[1][3] - surf->texturemins[1] - dt;
+		d = s * s + t * t;
+		if (d < best)
+		{
+			best = d;
+			nearest = i;
+		}
+	}
+
+	for (k = 0; k < gx->numstyles; k++)
+		l += gx->light[k * gx->numverts + nearest] * d_lightstylevalue[surf->styles[k]];
+	return l >> 8;
+}
+
+/*
+===============
+R_TextureAnimation
+
+Returns the proper texture for a given time and base texture
+===============
+*/
+texture_t *R_TextureAnimation (texture_t *base)
+{
+	int		reletive;
+	int		count;
+
+	if (currententity->frame)
+	{
+		if (base->alternate_anims)
+			base = base->alternate_anims;
+	}
+
+	if (!base->anim_total)
+		return base;
+
+	reletive = (int)(cl.time*10) % base->anim_total;
+
+	count = 0;
+	while (base->anim_min > reletive || base->anim_max <= reletive)
+	{
+		base = base->anim_next;
+		if (!base)
+			Sys_Error ("R_TextureAnimation: broken cycle");
+		if (++count > 100)
+			Sys_Error ("R_TextureAnimation: infinite cycle");
+	}
+
+	return base;
+}
+
+static void R_DrawGXSurface (model_t *mod, msurface_t *surf)
+{
+	gxsurf_t	*gx = surf->gx;
+	int			n = gx->numverts, i, j, k, l, sv[MAXLIGHTMAPS];
+	u16			color[MAX_SURFVERTS];
+	byte		*light;
+
+	if (surf->flags & SURF_DRAWTILED || r_fullbright.value)
+	{
+		for (i = 0; i < n; i++)
+			color[i] = GRAY (GX_NORMAL_LIGHT);
+	}
+	else
+	{
+		for (k = 0; k < gx->numstyles; k++)
+			sv[k] = d_lightstylevalue[surf->styles[k]];
+		for (i = 0; i < n; i++)
+		{
+			l = 0;
+			for (k = 0, light = gx->light + i; k < gx->numstyles; k++, light += n)
+				l += *light * sv[k];
+			color[i] = gx_light[MIN (l >> 8, 511)];
+		}
+	}
+
+#define EMIT(v) \
+	GFX_COLOR = color[v]; \
+	GFX_TEX_COORD = gx->st[v]; \
+	GFX_VERTEX16 = mod->gxvertexes[gx->verts[v] * 2]; \
+	GFX_VERTEX16 = mod->gxvertexes[gx->verts[v] * 2 + 1];
+
+	// a quad strip zig-zagging across the polygon: 1 0, 2 n-1, 3 n-2, ...
+	// with an odd number of vertices the last quad is a triangle
+	GFX_BEGIN = GL_QUAD_STRIP;
+	for (i = 1, j = 0; ; )
+	{
+		EMIT (i);
+		EMIT (j);
+		i++;
+		j = j ? j - 1 : n - 1;
+		if (i > j)
+			break;
+		if (i == j)
+		{
+			EMIT (i);
+			EMIT (i);
+			break;
+		}
+	}
+#undef EMIT
+
+	c_brush_polys += (n - 1) / 2;
+}
+
+static void R_BindBrushTexture (texture_t *t, msurface_t *surf)
+{
+	R_BindTexture (t->gxparam[0], t->gxscale);
+	if (surf->flags & (SURF_DRAWSKY | SURF_DRAWTURB))
+	{
+		// sky and liquids flow slowly
+		MATRIX_CONTROL = GL_TEXTURE;
+		MATRIX_TRANSLATE = F32 (cl.time * (surf->flags & SURF_DRAWSKY ? 8 : 2) * 16);
+		MATRIX_TRANSLATE = F32 (cl.time * (surf->flags & SURF_DRAWSKY ? 8 : 1) * 16);
+		MATRIX_TRANSLATE = 0;
+		MATRIX_CONTROL = GL_MODELVIEW;
+	}
+}
+
+static void R_LoadMatrix (float m[4][3], qboolean multiply)
+{
+	int	i, j;
+
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 3; j++)
+		{
+			if (multiply)
+				MATRIX_MULT4x3 = F32 (m[i][j]);
+			else
+				MATRIX_LOAD4x3 = F32 (m[i][j]);
+		}
+}
+
+// Model to world matrix, for brush models in their scaled vertex units
+static void R_EntityMatrix (entity_t *e, vec3_t angles, float m[4][3])
+{
+	vec3_t	forward, right, up;
+	int		i;
+
+	AngleVectors (angles, forward, right, up);
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i];
+		m[1][i] = -right[i];
+		m[2][i] = up[i];
+		m[3][i] = e->origin[i] * MATRIX_SCALE_W;
+	}
+}
+
+qboolean R_CullBox (vec3_t mins, vec3_t maxs)
+{
+	int		i;
+
+	for (i=0 ; i<4 ; i++)
+		if (BoxOnPlaneSide (mins, maxs, &frustum[i]) == 2)
+			return true;
+	return false;
+}
+
+static void R_DrawBrushModel (entity_t *e)
+{
+	int			i;
+	vec3_t		mins, maxs, temp, forward, right, up;
+	msurface_t	*psurf;
+	float		dot, m[4][3];
+	model_t		*clmodel = e->model;
+	qboolean	rotated;
+	texture_t	*t;
+
+	rotated = e->angles[0] || e->angles[1] || e->angles[2];
+	if (rotated)
+	{
+		for (i=0 ; i<3 ; i++)
+		{
+			mins[i] = e->origin[i] - clmodel->radius;
+			maxs[i] = e->origin[i] + clmodel->radius;
+		}
+	}
+	else
+	{
+		VectorAdd (e->origin, clmodel->mins, mins);
+		VectorAdd (e->origin, clmodel->maxs, maxs);
+	}
+	if (R_CullBox (mins, maxs))
+		return;
+
+	VectorSubtract (r_origin, e->origin, modelorg);
+	if (rotated)
+	{
+		VectorCopy (modelorg, temp);
+		AngleVectors (e->angles, forward, right, up);
+		modelorg[0] = DotProduct (temp, forward);
+		modelorg[1] = -DotProduct (temp, right);
+		modelorg[2] = DotProduct (temp, up);
+	}
+
+	MATRIX_PUSH = 0;
+	R_EntityMatrix (e, e->angles, m);
+	R_LoadMatrix (m, true);
+
+	psurf = &clmodel->surfaces[clmodel->firstmodelsurface];
+	for (i=0 ; i<clmodel->nummodelsurfaces ; i++, psurf++)
+	{
+		dot = DotProduct (modelorg, psurf->plane->normal) - psurf->plane->dist;
+		if (((psurf->flags & SURF_PLANEBACK) && (dot < -BACKFACE_EPSILON)) ||
+			(!(psurf->flags & SURF_PLANEBACK) && (dot > BACKFACE_EPSILON)))
+		{
+			t = R_TextureAnimation (psurf->texinfo->texture);
+			R_BindBrushTexture (t, psurf);
+			R_DrawGXSurface (clmodel, psurf);
+		}
+	}
+
+	MATRIX_POP = 1;
+}
