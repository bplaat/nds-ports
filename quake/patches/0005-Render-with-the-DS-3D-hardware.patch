+// r_nds.c -- renderer for the Nintendo DS 3D hardware
+//
+// The world, brush and alias models, sprites and particles are drawn by the
+// geometry engine on the top screen, the 2D drawing stays in software on the
+// touch screen (vid_nds.c).
+//
+// - Vertices are 16-bit fixed point world coordinates times 8, the matrices
+//   work in units of 512 world units, so maps up to 4096 units fit.
+// - Textures stay 8-bit with Quake's palette in the texture palette, so the
+//   palette shifts for damage and pickups are free. They go to VRAM when a
+//   map loads, at the largest mip level that fits, with texture coordinates
+//   scaled to their size by the texture matrix. Nothing stays in main RAM.
+// - Light maps become vertex light, one sample per style for each vertex, so
+//   the light styles still animate.
+// - Surfaces are polygons, drawn as quad strips zig-zagging across them,
+//   which needs half as many polygons as triangles.
+
+#include "quakedef.h"
+#include "r_local.h"
+
+#include <nds.h>
+
+// Texture VRAM: banks A and B for brush models, D for skins and sprites
+#define	TEXMEM_WORLD		0x00000
+#define	TEXMEM_MODELS		0x40000
+#define	TEXMEM_END			0x60000
+#define	TEXMEM_NOTEXTURE	256		// the checkerboard stays at the start
+#define	TEXMEM_INSTANCES	(16 * 1024)	// kept for brush models after the world
+
+#define	MAX_TEXSIZE			256
+#define	MAX_SKINSIZE		128
+
+// Vertex coordinates are world units times 8, the matrices are in 1/512
+#define	VERTEX_SCALE		8
+#define	MATRIX_SCALE_W		(1.0 / 512)
+
+// Brush texture coordinates are stored in 1/8 texels, the hardware reads 1/16
+#define	ST_SCALE			8
+
+// The texture palette is twice as bright, so vertex light can go up to
+// double like the software renderer's overbright light
+#define	GX_NORMAL_LIGHT		15
+
+#define	NEAR_PLANE			(4.0 / 512)
+#define	FAR_PLANE			(8192.0 / 512)
+
+#define	MAX_SURFVERTS		128
+#define	MAX_PARTICLES_DRAWN	512
+
+#define	F32(x)				((int) ((x) * 4096))
+#define	MIN(a,b)			((a) < (b) ? (a) : (b))
+#define	CLAMP(lo,x,hi)		((x) < (lo) ? (lo) : (x) > (hi) ? (hi) : (x))
+#define	GRAY(c)				((c) | ((c) << 5) | ((c) << 10))
+
+#define	MAX_MODELTEXTURES	256
+#define	LIGHTCACHE_SIZE		128
+#define	LIGHTCACHE_FRAMES	8
+#define	NUMVERTEXNORMALS	162
+#define	SHADEDOT_QUANT		16
