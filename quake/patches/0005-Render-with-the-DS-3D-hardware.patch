+/*
+================
+R_RenderView
+
+r_refdef must be set before the first call
+================
+*/
+void R_RenderView (void)
+{
+	double	time1 = 0;
+
+	if (!r_worldentity.model || !cl.worldmodel)
+		Sys_Error ("R_RenderView: NULL worldmodel");
+
+	if (r_speeds.value)
+		time1 = Sys_FloatTime ();
+
+	// the 3D view is on the top screen, clear its place on the touch screen
+	VID_ClearRect (&scr_vrect);
+
+	R_SetupFrame ();
+	R_SetFrustum ();
+	R_MarkLeaves ();
+	R_DrawWorld ();
+	R_DrawEntitiesOnList ();
+	R_DrawViewModel ();
+	R_DrawParticles ();
+	VID_Flush3D ();
+
+	if (r_speeds.value)
+		Con_Printf ("%3i ms  %4i wpoly %4i epoly\n", (int)((Sys_FloatTime () - time1)*1000),
+			c_brush_polys, c_alias_polys);
+}
