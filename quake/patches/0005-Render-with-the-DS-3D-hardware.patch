+
+void D_StartParticles (void)
+{
+	int	i;
+
+	for (i = 0; i < 3; i++)
+	{
+		particle_vpn[i] = vpn[i] * 16384;
+		particle_up[i] = vup[i] * 16384;
+		particle_right[i] = vright[i] * 16384;
+	}
+	gx_particles = 0;
+	GFX_TEX_FORMAT = 0;
+	GFX_BEGIN = GL_TRIANGLES;
+}
+
+void D_DrawParticle (particle_t *p)
+{
+	int		x, y, z, ux, uy, uz, rx, ry, rz, scale;
+
+	if (gx_particles++ >= MAX_PARTICLES_DRAWN)
+		return;
+
+	x = p->org[0] * VERTEX_SCALE;
+	y = p->org[1] * VERTEX_SCALE;
+	z = p->org[2] * VERTEX_SCALE;
+
+	// hack a scale up to keep particles from disapearing: 1.5 units and
+	// 0.006 per unit of distance, in 1/8 units times 1.14
+	scale = ((x - modelorg_i[0]) * particle_vpn[0] + (y - modelorg_i[1]) * particle_vpn[1] +
+		(z - modelorg_i[2]) * particle_vpn[2]) >> 14;
+	scale = scale < 20 * VERTEX_SCALE ? 12 : 12 + scale * 6 / 1000;
+	ux = (particle_up[0] * scale) >> 14;
+	uy = (particle_up[1] * scale) >> 14;
+	uz = (particle_up[2] * scale) >> 14;
+	rx = (particle_right[0] * scale) >> 14;
+	ry = (particle_right[1] * scale) >> 14;
+	rz = (particle_right[2] * scale) >> 14;
+
+	GFX_COLOR = d_8to16table[(int)p->color & 255];
+	GFX_VERTEX16 = VERTEX_PACK (x, y);
+	GFX_VERTEX16 = z & 0xffff;
+	GFX_VERTEX16 = VERTEX_PACK (x + ux, y + uy);
+	GFX_VERTEX16 = (z + uz) & 0xffff;
+	GFX_VERTEX16 = VERTEX_PACK (x + rx, y + ry);
+	GFX_VERTEX16 = (z + rz) & 0xffff;
+}
