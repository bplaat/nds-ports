+/*
+===============================================================================
+
+SPRITES
+
+===============================================================================
+*/
+
+static mspriteframe_t *R_GetSpriteFrame (entity_t *e)
+{
+	msprite_t		*psprite;
+	mspritegroup_t	*pspritegroup;
+	int				i, numframes, frame;
+	float			*pintervals, fullinterval, targettime, time;
+
+	psprite = e->model->cache.data;
+	frame = e->frame;
+	if ((frame >= psprite->numframes) || (frame < 0))
+		frame = 0;
+
+	if (psprite->frames[frame].type == SPR_SINGLE)
+		return psprite->frames[frame].frameptr;
+
+	pspritegroup = (mspritegroup_t *)psprite->frames[frame].frameptr;
+	pintervals = pspritegroup->intervals;
+	numframes = pspritegroup->numframes;
+	fullinterval = pintervals[numframes-1];
+	time = cl.time + e->syncbase;
+	targettime = time - ((int)(time / fullinterval)) * fullinterval;
+	for (i=0 ; i<(numframes-1) ; i++)
+		if (pintervals[i] > targettime)
+			break;
+	return pspritegroup->frames[i];
+}
+
+static void R_SpriteVertex (vec3_t org, vec3_t up, float u, vec3_t right, float r, int s, int t)
+{
+	int	x, y, z;
+
+	x = (org[0] + up[0] * u + right[0] * r) * VERTEX_SCALE;
+	y = (org[1] + up[1] * u + right[1] * r) * VERTEX_SCALE;
+	z = (org[2] + up[2] * u + right[2] * r) * VERTEX_SCALE;
+	GFX_TEX_COORD = TEXTURE_PACK (s, t);
+	GFX_VERTEX16 = VERTEX_PACK (x, y);
+	GFX_VERTEX16 = z & 0xffff;
+}
+
+static void R_DrawSpriteModel (entity_t *e)
+{
+	mspriteframe_t	*frame;
+	msprite_t		*psprite;
+	gxtex_t			*tex;
+	vec3_t			forward, right, up;
+	int				w, h;
+
+	frame = R_GetSpriteFrame (e);
+	tex = frame->pcachespot;
+	if (!tex)
+		return;
+
+	psprite = e->model->cache.data;
+	if (psprite->type == SPR_ORIENTED)
+		AngleVectors (e->angles, forward, right, up);
+	else
+	{
+		VectorCopy (vup, up);
+		VectorCopy (vright, right);
+	}
+
+	R_BindTexture (tex->param, tex->scale);
+	w = frame->width << 4;
+	h = frame->height << 4;
+	GFX_COLOR = GRAY (GX_NORMAL_LIGHT);
+	GFX_BEGIN = GL_QUADS;
+	R_SpriteVertex (e->origin, up, frame->down, right, frame->left, 0, h);
+	R_SpriteVertex (e->origin, up, frame->up, right, frame->left, 0, 0);
+	R_SpriteVertex (e->origin, up, frame->up, right, frame->right, w, 0);
+	R_SpriteVertex (e->origin, up, frame->down, right, frame->right, w, h);
+}
