+// mem_nds.c -- memcpy and memset for the ARM9
+//
+// newlib's copy a byte at a time in Thumb mode, these move words, eight at a
+// time, and run from ITCM. Built without builtins, so the compiler doesn't
+// turn the loops back into calls to themselves.
+
+#include <stddef.h>
+#include <stdint.h>
+
+void *memcpy (void *dst, const void *src, size_t n)
+{
+	uint8_t			*d = dst;
+	const uint8_t	*s = src;
+	uint32_t		*dw;
+	const uint32_t	*sw;
+
+	if ((((uintptr_t) d ^ (uintptr_t) s) & 3) == 0)
+	{
+		while (n && ((uintptr_t) d & 3))
+		{
+			*d++ = *s++;
+			n--;
+		}
+		dw = (uint32_t *) d;
+		sw = (const uint32_t *) s;
+		for (; n >= 32; n -= 32, dw += 8, sw += 8)
+		{
+			uint32_t a = sw[0], b = sw[1], c = sw[2], e = sw[3];
+			uint32_t f = sw[4], g = sw[5], h = sw[6], i = sw[7];
+			dw[0] = a; dw[1] = b; dw[2] = c; dw[3] = e;
+			dw[4] = f; dw[5] = g; dw[6] = h; dw[7] = i;
+		}
+		for (; n >= 4; n -= 4)
+			*dw++ = *sw++;
+		d = (uint8_t *) dw;
+		s = (const uint8_t *) sw;
+	}
+	while (n--)
+		*d++ = *s++;
+	return dst;
+}
+
+void *memset (void *dst, int c, size_t n)
+{
+	uint8_t		*d = dst;
+	uint32_t	*dw, v = (uint8_t) c * 0x01010101u;
+
+	while (n && ((uintptr_t) d & 3))
+	{
+		*d++ = c;
+		n--;
+	}
+	dw = (uint32_t *) d;
+	for (; n >= 16; n -= 16, dw += 4)
+	{
+		dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
+	}
+	for (; n >= 4; n -= 4)
+		*dw++ = v;
+	d = (uint8_t *) dw;
+	while (n--)
+		*d++ = c;
+	return dst;
+}
