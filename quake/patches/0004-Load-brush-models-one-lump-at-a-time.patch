From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Wed, 30 Sep 2026 14:20:55 +0200
Subject: [PATCH] Load brush models one lump at a time

Mod_LoadModel read the whole .bsp into temporary hunk memory before
parsing it, which is more than 1 MiB for most maps and most of what the
DS has. Brush models are now read from the file lump by lump, only one
lump at a time in temporary memory, and the textures are read one by one
straight into their place in the hunk. Alias and sprite models are small
and still load in one piece.
---
 WinQuake/model.c | 149 +++++++++++++++++++++++++++++------------------
 1 file changed, 92 insertions(+), 57 deletions(-)

diff --git a/WinQuake/model.c b/WinQuake/model.c
index 940f7fe..9d0d292 100644
--- a/WinQuake/model.c
+++ b/WinQuake/model.c
@@ -35,6 +35,9 @@ model_t *Mod_LoadModel (model_t *mod, qboolean crash);
 
 byte	mod_novis[MAX_MAP_LEAFS/8];
 
+FILE	*mod_file;		// the brush model being loaded
+int		mod_filebase;
+
 #define	MAX_MOD_KNOWN	256
 model_t	mod_known[MAX_MOD_KNOWN];
 int		mod_numknown;
@@ -256,7 +259,7 @@ Loads a model into the cache
 model_t *Mod_LoadModel (model_t *mod, qboolean crash)
 {
 	unsigned *buf;
-	byte	stackbuf[1024];		// avoid dirtying the cache heap
+	unsigned	stackbuf[256];		// avoid dirtying the cache heap
 
 	if (mod->type == mod_alias)
 	{
@@ -275,18 +278,16 @@ model_t *Mod_LoadModel (model_t *mod, qboolean crash)
 //
 // because the world is so huge, load it one piece at a time
 //
-	
-//
-// load the file
-//
-	buf = (unsigned *)COM_LoadStackFile (mod->name, stackbuf, sizeof(stackbuf));
-	if (!buf)
+	if (COM_FOpenFile (mod->name, &mod_file) < 0)
 	{
 		if (crash)
 			Sys_Error ("Mod_NumForName: %s not found", mod->name);
 		return NULL;
 	}
-	
+	mod_filebase = ftell (mod_file);
+	if (fread (stackbuf, 1, sizeof(dheader_t), mod_file) < 4)
+		Sys_Error ("Mod_LoadModel: %s is truncated", mod->name);
+
 //
 // allocate a new model
 //
@@ -301,18 +302,22 @@ model_t *Mod_LoadModel (model_t *mod, qboolean crash)
 // call the apropriate loader
 	mod->needload = NL_PRESENT;
 
-	switch (LittleLong(*(unsigned *)buf))
+	switch (LittleLong(*(unsigned *)stackbuf))
 	{
 	case IDPOLYHEADER:
-		Mod_LoadAliasModel (mod, buf);
-		break;
-		
 	case IDSPRITEHEADER:
-		Mod_LoadSpriteModel (mod, buf);
+		// the others are small, load them in one piece
+		fclose (mod_file);
+		buf = (unsigned *)COM_LoadStackFile (mod->name, stackbuf, sizeof(stackbuf));
+		if (LittleLong(*buf) == IDPOLYHEADER)
+			Mod_LoadAliasModel (mod, buf);
+		else
+			Mod_LoadSpriteModel (mod, buf);
 		break;
 	
 	default:
-		Mod_LoadBrushModel (mod, buf);
+		Mod_LoadBrushModel (mod, stackbuf);
+		fclose (mod_file);
 		break;
 	}
 
@@ -344,7 +349,37 @@ model_t *Mod_ForName (char *name, qboolean crash)
 ===============================================================================
 */
 
-byte	*mod_base;
+/*
+=================
+Mod_ReadLump
+
+Reads len bytes from ofs into a lump of the brush model being loaded
+=================
+*/
+void Mod_ReadLump (lump_t *l, int ofs, void *dest, int len)
+{
+	if (ofs < 0 || len < 0 || ofs + len > l->filelen)
+		Sys_Error ("Mod_ReadLump: bad lump in %s", loadmodel->name);
+	fseek (mod_file, mod_filebase + l->fileofs + ofs, SEEK_SET);
+	if (fread (dest, 1, len, mod_file) != len)
+		Sys_Error ("Mod_ReadLump: %s is truncated", loadmodel->name);
+}
+
+/*
+=================
+Mod_LoadLump
+
+Reads a lump into temporary memory, which the next one reuses
+=================
+*/
+void *Mod_LoadLump (lump_t *l)
+{
+	void	*buf;
+
+	buf = Hunk_TempAlloc (l->filelen);
+	Mod_ReadLump (l, 0, buf, l->filelen);
+	return buf;
+}
 
 
