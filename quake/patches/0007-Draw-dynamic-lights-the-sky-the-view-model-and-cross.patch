+	R_SetProjection (0.15, -0.85);
 	R_DrawAliasModel (currententity, 24);
+	R_SetProjection (1, 0);
 	currententity = &r_worldentity;
 }
 
+// A small cross in the middle of the view, just in front of the eye
+static void R_DrawCrosshair (void)
+{
+	float	d = 2 * NEAR_PLANE, pixel;
+	int		size, thick, x, y;
+
+	if (!crosshair.value)
+		return;
+
+	// a pixel at that depth, in 20.12 fixed point
+	pixel = 2 * d * tan (r_refdef.fov_y * (float)(M_PI / 360)) / 192;
+	size = F32 (pixel * 3.5f);
+	thick = F32 (pixel * 0.5f);
+	x = F32 (cl_crossx.value * pixel);
+	y = F32 (-cl_crossy.value * pixel);
+
+	MATRIX_PUSH = 0;
+	MATRIX_IDENTITY = 0;
+	GFX_TEX_FORMAT = 0;
+	GFX_COLOR = RGB15 (31, 31, 31);
+	GFX_BEGIN = GL_QUADS;
+	R_CrosshairQuad (x - size, y - thick, x + size, y + thick, F32 (-d));
+	R_CrosshairQuad (x - thick, y - size, x + thick, y + size, F32 (-d));
+	MATRIX_POP = 1;
+}
