+static int R_Sqrt (int n)
+{
+	int	root = 0, bit = 1 << 30;
+
+	while (bit > n)
+		bit >>= 2;
+	for (; bit; bit >>= 2)
+	{
+		if (n >= root + bit)
+		{
+			n -= root + bit;
+			root = (root >> 1) + bit;
+		}
+		else
+			root >>= 1;
+	}
+	return root;
+}
