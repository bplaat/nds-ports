+/*
+================
+R_DrawSkySurfaces
+
+The two sky layers like GLQuake: the texture coordinates follow the
+direction from the eye to each vertex on a flattened sphere, the front
+layer is drawn on the back one with the depth test for equal
+================
+*/
+static void R_DrawSkySurfaces (model_t *mod, texture_t *t)
+{
+	msurface_t	*surf;
+	gxsurf_t	*gx;
+	unsigned	*pos, st[2][MAX_SURFVERTS];
+	u16			color[MAX_SURFVERTS];
+	int			i, x, y, z, len, layer, speed[2];
+
+	for (layer = 0; layer < 2; layer++)
+	{
+		speed[layer] = (int) (realtime * (layer ? 16 : 8)) & 127;
+		speed[layer] <<= 4;
+	}
+	for (i = 0; i < MAX_SURFVERTS; i++)
+		color[i] = GRAY (GX_NORMAL_LIGHT);
+
+	for (surf = t->texturechain; surf; surf = surf->texturechain)
+	{
+		gx = surf->gx;
+		for (i = 0; i < gx->numverts; i++)
+		{
+			pos = mod->gxvertexes + gx->verts[i] * 2;
+			x = ((short) (pos[0] & 0xffff) - modelorg_i[0]) >> 3;
+			y = ((short) (pos[0] >> 16) - modelorg_i[1]) >> 3;
+			z = (((short) (pos[1] & 0xffff) - modelorg_i[2]) >> 3) * 3;
+			len = R_Sqrt (x * x + y * y + z * z);
+			if (!len)
+				len = 1;
+			// 6*63 texels out on the sphere, in 1/16 texels
+			x = x * (6 * 63 * 16) / len;
+			y = y * (6 * 63 * 16) / len;
+			st[0][i] = TEXTURE_PACK (speed[0] + x, speed[0] + y);
+			st[1][i] = TEXTURE_PACK (speed[1] + x, speed[1] + y);
+		}
+		for (layer = 0; layer < 2; layer++)
+		{
+			R_BindTexture (t->gxparam[layer], t->gxscale);
+			GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE | (layer ? POLY_DEPTH_EQUAL : 0);
+			R_EmitSurface (mod, gx, color, st[layer]);
+		}
+	}
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
