+static void R_CrosshairQuad (int x1, int y1, int x2, int y2, int z)
+{
+	// the vertices are 4.12 fixed point, like the 20.12 of the eye space
+	GFX_VERTEX16 = VERTEX_PACK (x1, y1);
+	GFX_VERTEX16 = z & 0xffff;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y1);
+	GFX_VERTEX16 = z & 0xffff;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y2);
+	GFX_VERTEX16 = z & 0xffff;
+	GFX_VERTEX16 = VERTEX_PACK (x1, y2);
+	GFX_VERTEX16 = z & 0xffff;
+}
