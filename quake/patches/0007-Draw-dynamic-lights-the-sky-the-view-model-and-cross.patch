+	a = (FAR_PLANE + NEAR_PLANE) / (NEAR_PLANE - FAR_PLANE);
+	b = 2 * FAR_PLANE * NEAR_PLANE / (NEAR_PLANE - FAR_PLANE);
 	MATRIX_CONTROL = GL_PROJECTION;
 	MATRIX_LOAD4x4 = F32 (f * 192 / 256);
 	MATRIX_LOAD4x4 = 0;
@@ -1589,12 +1707,34 @@ void R_SetupFrame (void)
 	MATRIX_LOAD4x4 = 0;
 	MATRIX_LOAD4x4 = 0;
 	MATRIX_LOAD4x4 = 0;
-	MATRIX_LOAD4x4 = F32 ((FAR_PLANE + NEAR_PLANE) / (NEAR_PLANE - FAR_PLANE));
+	MATRIX_LOAD4x4 = F32 (a * depthscale - depthoffset);
 	MATRIX_LOAD4x4 = -4096;
 	MATRIX_LOAD4x4 = 0;
 	MATRIX_LOAD4x4 = 0;
-	MATRIX_LOAD4x4 = F32 (2 * FAR_PLANE * NEAR_PLANE / (NEAR_PLANE - FAR_PLANE));
+	MATRIX_LOAD4x4 = F32 (b * depthscale);
 	MATRIX_LOAD4x4 = 0;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
