 int	m_main_cursor;
 #define	MAIN_ITEMS	5
 
+// The single player items of sp_menu.lmp right in the main menu, then those
+// of mainmenu.lmp kept: there is no network play and the help is about the
+// keyboard
+static const struct
+{
+	char	*pic;
+	int		item;
+} m_main_items[MAIN_ITEMS] =
+{
+	{"gfx/sp_menu.lmp", 0},		// New Game
+	{"gfx/sp_menu.lmp", 1},		// Load
+	{"gfx/sp_menu.lmp", 2},		// Save
+	{"gfx/mainmenu.lmp", 2},	// Options
+	{"gfx/mainmenu.lmp", 4},	// Quit
+};
+#define	MAIN_ITEM_HEIGHT	20
+#define	MAIN_WIDTH			160		// the widest item, past it Quit's band has a bit of Help
+#define	MAIN_HEIGHT			(MAIN_ITEMS * MAIN_ITEM_HEIGHT + 12)
+#define	MAIN_Y				40		// under the title, lined up with it
+
 
 void M_Menu_Main_f (void)
 {
@@ -288,6 +310,40 @@ void M_Menu_Main_f (void)
 }
 
 
+/*
+================
+M_MainMenuPic
+
+The items of the menu cut out of sp_menu.lmp and mainmenu.lmp, the last
+one is taller
+================
+*/
+qpic_t *M_MainMenuPic (void)
+{
+	static qpic_t	*pic;
+	qpic_t			*src;
+	int				i, y, height;
+
+	if (pic)
+		return pic;
+	pic = malloc (sizeof(qpic_t) + MAIN_WIDTH * MAIN_HEIGHT);
+	pic->width = MAIN_WIDTH;
+	pic->height = MAIN_HEIGHT;
+	memset (pic->data, 255, MAIN_WIDTH * MAIN_HEIGHT);	// transparent
+	for (i = 0 ; i < MAIN_ITEMS ; i++)
+	{
+		src = Draw_CachePic (m_main_items[i].pic);
+		height = i < MAIN_ITEMS-1 ? MAIN_ITEM_HEIGHT : MAIN_HEIGHT - i * MAIN_ITEM_HEIGHT;
+		if (height > src->height - m_main_items[i].item * MAIN_ITEM_HEIGHT)
+			height = src->height - m_main_items[i].item * MAIN_ITEM_HEIGHT;
+		for (y = 0 ; y < height ; y++)
+			memcpy (pic->data + (i * MAIN_ITEM_HEIGHT + y) * MAIN_WIDTH,
+				src->data + (m_main_items[i].item * MAIN_ITEM_HEIGHT + y) * src->width,
+				src->width < MAIN_WIDTH ? src->width : MAIN_WIDTH);
+	}
+	return pic;
+}
+
