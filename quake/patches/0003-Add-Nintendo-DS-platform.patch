+{
+}
+
+void Sys_LowFPPrecision (void)
+{
+}
+
+//=============================================================================
+
+// Extra command line options (eg. -game hipnotic or +map e1m2) can be put in
+// /data/quake/args.txt, separated by whitespace
+static void Sys_ReadArgs (int *argc, char **argv)
+{
+	static char	text[512];
+	char		*p;
+	FILE		*f;
+	int		len;
+
+	if (!(f = fopen (DATA_DIR "/args.txt", "r")))
+		return;
+	len = fread (text, 1, sizeof(text) - 1, f);
+	fclose (f);
+	text[len] = 0;
+
+	for (p = strtok (text, " \t\r\n"); p && *argc < MAX_ARGS; p = strtok (NULL, " \t\r\n"))
+		argv[(*argc)++] = p;
+}
+
+static int Sys_QuakeMain (void *arg)
+{
+	double	time, oldtime, newtime;
+
+	Host_Init (arg);
+	oldtime = Sys_FloatTime ();
+	for (;;)
+	{
+		newtime = Sys_FloatTime ();
+		time = newtime - oldtime;
+		oldtime = newtime;
+		Host_Frame (time);
+	}
+	return 0;
+}
+
+int main (int argc, char **argv)
+{
+	extern char		*fake_heap_end;
+	static quakeparms_t	parms;
+	static char		*quake_argv[MAX_ARGS + 1] = { "quake" };
+	int			quake_argc = 1;
+	void			*stack;
+
+	tickTaskStart (&tick_task, Sys_TickTask, ticksFromHz (1), ticksFromHz (1));
+	consoleDemoInit ();
+	printf ("\x1b[31;1m  Quake\x1b[39;0m for Nintendo %s\n\n", isDSiMode () ? "DSi" : "DS");
+
+	nitroFSInit (NULL);
+	if (fatInitDefault ())
+	{
+		Sys_mkdir ("/data");
+		Sys_mkdir (DATA_DIR);
+		Sys_mkdir (DATA_DIR "/" GAMENAME);
+		parms.basedir = DATA_DIR;
+		Sys_ReadArgs (&quake_argc, quake_argv);
+	}
+	else
+	{
+		// Without an SD card everything comes from the ROM and nothing is saved
+		parms.basedir = "nitro:";
+	}
+
+	COM_InitArgv (quake_argc, quake_argv);
+	parms.argc = com_argc;
+	parms.argv = com_argv;
+
+	stack = malloc (QUAKE_STACK_SIZE);
+	parms.memsize = (fake_heap_end - (char *) sbrk (0)) - HUNK_RESERVE;
+	parms.membase = malloc (parms.memsize);
+	if (!stack || !parms.membase)
+		Sys_Error ("Unable to allocate %i KiB of RAM", parms.memsize / 1024);
+
+	threadPrepare (&quake_thread, Sys_QuakeMain, &parms, (char *) stack + QUAKE_STACK_SIZE, MAIN_THREAD_PRIO);
+	threadStart (&quake_thread);
+	return threadJoin (&quake_thread);
+}
