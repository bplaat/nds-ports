+// vid_nds.c -- Nintendo DS video driver
+//
+// The 320x200 frame is rendered into main RAM, copied into one of two 8bpp
+// bitmap backgrounds in VRAM banks A/B and page flipped on vblank. The affine
+// background hardware scales it to the 256x192 top screen for free, and the
+// palette lives directly in the hardware BG palette. For smoothing, a second
+// affine background samples the same frame at a half pixel offset and is
+// alpha blended on top, a cheap hardware bilinear-like filter.
+
+#include "quakedef.h"
+#include "d_local.h"
+
+#include <nds.h>
+
+#define	BASEWIDTH	320
+#define	BASEHEIGHT	200
+#define	FB_STRIDE	512
+
+// Scale factors in 8.8 fixed point: 320 -> 256 and 200 -> 192
+#define	SCALE_X		((BASEWIDTH << 8) / 256)
+#define	SCALE_Y		((BASEHEIGHT << 8) / 192)
+
+unsigned short	d_8to16table[256];
+unsigned	d_8to24table[256];
+
+static cvar_t	vid_smooth = {"vid_smooth", "1", true};
+
+static u16		palette[256] __attribute__((aligned(4)));
+static volatile qboolean	palette_dirty;
+static volatile int	shown_page, pending_page = -1;
+static int		smoothing = -1;
+
+static void VID_VBlank (void)
+{
+	// A CPU copy, DMA would miss palette writes still in the data cache
+	if (palette_dirty)
+	{
+		memcpy (BG_PALETTE, palette, sizeof(palette));
+		palette_dirty = false;
+	}
+	if (pending_page >= 0)
+	{
+		u16 base = BG_MAP_BASE(pending_page * 8);
+		REG_BG2CNT = (REG_BG2CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+		REG_BG3CNT = (REG_BG3CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+		shown_page = pending_page;
+		pending_page = -1;
+	}
+}
+
+static void VID_SetSmoothing (qboolean enable)
+{
+	smoothing = enable;
+	if (enable)
+	{
+		REG_DISPCNT |= DISPLAY_BG2_ACTIVE;
+		REG_BLDCNT = BLEND_ALPHA | BLEND_SRC_BG2 | BLEND_DST_BG3;
+		REG_BLDALPHA = 8 | (8 << 8);
+	}
+	else
+	{
+		REG_DISPCNT &= ~DISPLAY_BG2_ACTIVE;
+		REG_BLDCNT = BLEND_NONE;
+	}
+}
+
+void VID_SetPalette (unsigned char *pal)
+{
+	int	i;
+
+	for (i = 0; i < 256; i++, pal += 3)
+		palette[i] = RGB15(pal[0] >> 3, pal[1] >> 3, pal[2] >> 3);
+	palette_dirty = true;
+}
+
+void VID_ShiftPalette (unsigned char *pal)
+{
+	VID_SetPalette (pal);
+}
+
+void VID_Init (unsigned char *pal)
+{
+	int	bg, surfcachesize;
+	byte	*mem;
+
+	Cvar_RegisterVariable (&vid_smooth);
+
+	vid.maxwarpwidth = vid.width = vid.conwidth = BASEWIDTH;
+	vid.maxwarpheight = vid.height = vid.conheight = BASEHEIGHT;
+	vid.aspect = ((float) vid.height / vid.width) * (320.0 / 240.0);
+	vid.numpages = 2;
+	vid.colormap = host_colormap;
+	vid.fullbright = 256 - LittleLong (*((int *)vid.colormap + 2048));
+	vid.rowbytes = vid.conrowbytes = BASEWIDTH;
+
+	// The DS has little RAM to spare, its surface cache is half the usual size
+	surfcachesize = D_SurfaceCacheForRes (BASEWIDTH, BASEHEIGHT);
+	if (!isDSiMode () && !COM_CheckParm ("-surfcachesize"))
+		surfcachesize /= 2;
+	mem = Hunk_HighAllocName (BASEWIDTH * BASEHEIGHT * 3 + surfcachesize, "video");
+	vid.buffer = vid.conbuffer = mem;
+	d_pzbuffer = (short *) (mem + BASEWIDTH * BASEHEIGHT);
+	D_InitCaches (mem + BASEWIDTH * BASEHEIGHT * 3, surfcachesize);
+
+	videoSetMode (MODE_5_2D);
+	vramSetBankA (VRAM_A_MAIN_BG_0x06000000);
+	vramSetBankB (VRAM_B_MAIN_BG_0x06020000);
+	memset (BG_GFX, 0, 2 * FB_STRIDE * 256);
+	for (bg = 2; bg <= 3; bg++)
+	{
+		int id = bgInit (bg, BgType_Bmp8, BgSize_B8_512x256, 0, 0);
+		bgSetPriority (id, bg == 2 ? 0 : 1);
+		bgSetScale (id, SCALE_X, SCALE_Y);
+		// The blend layer samples half an output pixel further
+		if (bg == 2)
+			bgSetScrollf (id, SCALE_X / 2, SCALE_Y / 2);
+	}
+	bgUpdate ();
+	VID_SetSmoothing (vid_smooth.value);
+
+	VID_SetPalette (pal);
+	irqSet (IRQ_VBLANK, VID_VBlank);
+	irqEnable (IRQ_VBLANK);
+}
+
+void VID_Shutdown (void)
+{
+	irqClear (IRQ_VBLANK);
+}
+
+void VID_Update (vrect_t *rects)
+{
+	int	page, y;
+	u32	*src, *dst;
+
+	if (smoothing != (vid_smooth.value != 0))
+		VID_SetSmoothing (vid_smooth.value != 0);
+
+	// Wait until the last flip happened, the back buffer is then free
+	while (pending_page >= 0)
+		threadWaitForVBlank ();
+
+	page = shown_page ^ 1;
+	src = (u32 *) vid.buffer;
+	dst = (u32 *) BG_BMP_RAM(page * 8);
+	for (y = 0; y < BASEHEIGHT; y++)
+	{
+		memcpy (dst, src, BASEWIDTH);
+		src += BASEWIDTH / 4;
+		dst += FB_STRIDE / 4;
+	}
+	pending_page = page;
+}
