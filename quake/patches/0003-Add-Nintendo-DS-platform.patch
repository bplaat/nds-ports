new file mode 100644
index 0000000..ecf31fa
--- /dev/null
+++ b/WinQuake/Makefile.nds
@@ -0,0 +1,82 @@
+#---------------------------------------------------------------------------------
+# Nintendo DS (devkitARM + libnds) build of Quake
+#   make -f Makefile.nds [ICON=icon.bmp] [NITRO_DIR=dir]
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(DEVKITARM)),)
+$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
+endif
+
+GAME_TITLE     := Quake
+GAME_SUBTITLE1 := id Software (1996)
+GAME_SUBTITLE2 := Quake NDS port
+
+TARGET  := quake
+BUILD   := build
+OUTPUT  := $(CURDIR)/$(TARGET)
+
+ICON      ?=
+NITRO_DIR ?=
+GAME_ICON := $(or $(ICON),$(DEVKITPRO)/calico/share/nds-icon.bmp)
+ifneq ($(strip $(NITRO_DIR)),)
+NITRO_FILES := $(NITRO_DIR)
+endif
+
+# Must be set before ds_rules, which prepends the calico library path
+LIBPATHS := -L$(DEVKITPRO)/libnds/lib
+
+include $(DEVKITARM)/ds_rules
+
+SRC_QUAKE := cl_demo cl_input cl_main cl_parse cl_tent chase cmd common console crc cvar draw \
+	d_edge d_fill d_init d_modech d_part d_polyse d_sky d_sprite d_surf d_vars d_zpoint \
+	host host_cmd keys menu mathlib model net_loop net_main net_none net_vcr nonintel \
+	pr_cmds pr_edict pr_exec r_aclip r_alias r_bsp r_light r_draw r_efrag r_edge r_misc \
+	r_main r_sky r_sprite r_surf r_part r_vars screen sbar sv_main sv_phys sv_move sv_user \
+	zone view wad world cd_null snd_dma snd_mem snd_mix \
+	sys_nds vid_nds in_nds snd_nds
+
+# Hot inner loops (span drawers) run from ITCM
+SRC_ITCM := d_scan
+
+OFILES := $(addprefix $(BUILD)/,$(addsuffix .o,$(SRC_QUAKE)) $(addsuffix .itcm.o,$(SRC_ITCM)))
+
+ARCH     := -march=armv5te -mtune=arm946e-s -mthumb
+# Quake reads files straight into structs with enums and keeps flag masks in
+# qbooleans, so enums are int sized like on x86, not only as big as their
+# values like the ARM EABI default. Libraries only get enums as arguments.
+# Its globals are defined in headers, which needs common symbols.
+CFLAGS   := -g -O2 -Wall -Wno-dangling-else -Wno-unused-variable -Wno-unused-but-set-variable \
+	-Wno-misleading-indentation -Wno-format-overflow -Wno-pointer-sign -Wno-trigraphs \
+	-Wno-dangling-pointer -Wno-stringop-truncation -Wno-array-parameter -Wno-shift-overflow \
+	-ffunction-sections -fdata-sections -fno-strict-aliasing -fno-short-enums -fcommon -std=gnu17 \
+	$(ARCH) -DARM9 -I$(LIBNDS)/include -I$(CALICO)/include
+LDFLAGS  := -specs=ds_arm9.specs -g $(ARCH) -Wl,--no-enum-size-warning -Wl,-Map,$(BUILD)/$(TARGET).map
+LIBS     := -lfilesystem -lfat -lnds9 -lm
+LD       := $(CC)
+
+.PHONY: all clean
+all: $(OUTPUT).nds
+
+# Like the ds_rules default, plus a proper header title (homebrew game code kept)
+$(OUTPUT).nds: $(OUTPUT).elf $(GAME_ICON) $(shell find $(NITRO_DIR) -type f 2>/dev/null)
+	$(SILENTCMD)ndstool -c $@ -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1);$(GAME_SUBTITLE2)" \
+		-g "####" 00 "$(GAME_TITLE)" $(_ADDFILES)
+	$(SILENTMSG) built ... $(notdir $@)
+
+$(OUTPUT).elf: $(OFILES)
+
+$(BUILD)/%.itcm.o: CFLAGS += -marm -mlong-calls
+$(BUILD)/%.itcm.o: %.c | $(BUILD)
+	$(SILENTMSG) $(notdir $<)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+$(BUILD)/%.o: %.c | $(BUILD)
+	$(SILENTMSG) $(notdir $<)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+$(BUILD):
+	@mkdir -p $@
+
+clean:
+	rm -rf $(BUILD) $(OUTPUT).elf $(OUTPUT).nds $(TARGET).lst
+
+-include $(OFILES:.o=.d)
