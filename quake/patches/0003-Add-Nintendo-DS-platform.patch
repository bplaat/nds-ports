+// in_nds.c -- Nintendo DS buttons and touch screen
+//
+// The buttons send the keys of Quake's default bindings in game and the menu
+// keys everywhere else, so they can still be rebound. Dragging the stylus
+// over the touch screen looks around like a mouse.
+
+#include "quakedef.h"
+
+#include <nds.h>
+
+// Touch screen pixels to mouse units, at the default sensitivity of 3 a drag
+// across the whole screen turns about 180 degrees
+#define TOUCH_SCALE	10
+
+typedef struct
+{
+	u32	button;
+	int	game_key;	// bound by default.cfg
+	int	menu_key;
+} buttonmap_t;
+
+static const buttonmap_t buttonmap[] =
+{
+	{KEY_UP,	K_UPARROW,	K_UPARROW},	// +forward
+	{KEY_DOWN,	K_DOWNARROW,	K_DOWNARROW},	// +back
+	{KEY_LEFT,	K_LEFTARROW,	K_LEFTARROW},	// +left
+	{KEY_RIGHT,	K_RIGHTARROW,	K_RIGHTARROW},	// +right
+	{KEY_A,		K_CTRL,		K_ENTER},	// +attack
+	{KEY_B,		K_SPACE,	K_ESCAPE},	// +jump
+	{KEY_X,		'/',		K_BACKSPACE},	// impulse 10 (next weapon)
+	{KEY_Y,		K_SHIFT,	K_SHIFT},	// +speed
+	{KEY_L,		',',		K_PGUP},	// +moveleft
+	{KEY_R,		'.',		K_PGDN},	// +moveright
+	{KEY_START,	K_ESCAPE,	K_ESCAPE},	// togglemenu
+	{KEY_SELECT,	K_TAB,		K_TAB},		// +showscores
+};
+
+#define NUM_BUTTONS	(sizeof(buttonmap) / sizeof(buttonmap[0]))
+
+// The key sent for each held button, released even when key_dest changed
+static int	held_key[NUM_BUTTONS];
+
+static qboolean	touching;
+static int	touch_x, touch_y, mouse_x, mouse_y;
+
+void IN_Init (void)
+{
+}
+
+void IN_Shutdown (void)
+{
+}
+
+void Sys_SendKeyEvents (void)
+{
+	u32		down, up;
+	int		i;
+	touchPosition	touch;
+
+	scanKeys ();
+	down = keysDown ();
+	up = keysUp ();
+
+	for (i = 0; i < NUM_BUTTONS; i++)
+	{
+		if ((up & buttonmap[i].button) && held_key[i])
+		{
+			Key_Event (held_key[i], false);
+			held_key[i] = 0;
+		}
+		if (down & buttonmap[i].button)
+		{
+			held_key[i] = key_dest == key_game ? buttonmap[i].game_key : buttonmap[i].menu_key;
+			Key_Event (held_key[i], true);
+		}
+	}
+
+	if (keysHeld () & KEY_TOUCH)
+	{
+		touchRead (&touch);
+		if (touching)
+		{
+			mouse_x += touch.px - touch_x;
+			mouse_y += touch.py - touch_y;
+		}
+		touch_x = touch.px;
+		touch_y = touch.py;
+		touching = true;
+	}
+	else
+		touching = false;
+}
+
+void IN_Commands (void)
+{
+}
+
+void IN_Move (usercmd_t *cmd)
+{
+	float	mx, my;
+
+	if (key_dest != key_game)
+	{
+		mouse_x = mouse_y = 0;
+		return;
+	}
+
+	mx = mouse_x * TOUCH_SCALE * sensitivity.value;
+	my = mouse_y * TOUCH_SCALE * sensitivity.value;
+	mouse_x = mouse_y = 0;
+	if (!mx && !my)
+		return;
+
+	// Dragging always looks around, there is no separate mouse look mode
+	if (in_strafe.state & 1)
+		cmd->sidemove += m_side.value * mx;
+	else
+		cl.viewangles[YAW] -= m_yaw.value * mx;
+
+	V_StopPitchDrift ();
+	cl.viewangles[PITCH] += m_pitch.value * my;
+	if (cl.viewangles[PITCH] > 80)
+		cl.viewangles[PITCH] = 80;
+	if (cl.viewangles[PITCH] < -70)
+		cl.viewangles[PITCH] = -70;
+}
