+
+// Prints Quake text on the bottom screen console and to the no$gba debug
+// output of emulators: the high bit selects the red font and the low
+// characters are graphics, like the separator lines
+static void Sys_PrintText (const char *text)
+{
+	char	plain[1024], *out = plain;
+	int	c;
+
+	for (; *text && out < plain + sizeof(plain) - 1; text++)
+	{
+		c = *text & 0x7f;
+		if (c >= 29 && c <= 31)
+			c = '-';
+		if (c >= ' ' || c == '\n')
+			*out++ = c;
+	}
+	*out = 0;
+	fputs (plain, stdout);
+	nocashMessage (plain);
+}
+
+void Sys_Printf (char *fmt, ...)
+{
+	va_list	argptr;
+	char	text[1024];
+
+	va_start (argptr, fmt);
+	vsnprintf (text, sizeof(text), fmt, argptr);
+	va_end (argptr);
+	Sys_PrintText (text);
+}
+
+void Sys_Error (char *error, ...)
+{
+	va_list	argptr;
+	char	text[1024];
+
+	va_start (argptr, error);
+	vsnprintf (text, sizeof(text), error, argptr);
+	va_end (argptr);
+
+	if (shm)
+		SNDDMA_Shutdown ();
+	printf ("\n\x1b[31;1mError:\x1b[39;0m ");
+	Sys_PrintText (text);
+	printf ("\n\nPress START to exit\n");
+	do
+	{
+		threadWaitForVBlank ();
+		scanKeys ();
+	} while (!(keysDown () & KEY_START));
+	exit (1);
+}
+
+void Sys_Quit (void)
+{
+	exit (0);
+}
+
+double Sys_FloatTime (void)
+{
+	return (double) tickGetCount () / TICK_FREQ;
+}
+
