+// snd_nds.c -- Nintendo DS sound output
+//
+// Quake mixes into a 16-bit stereo ring buffer as if it was a DMA buffer.
+// The hardware only plays mono samples, so each submit splits it into a left
+// and a right ring buffer, which loop forever on two hardware channels panned
+// hard left and right. The play position follows from the time since they
+// started, the sound and tick timers share a clock.
+
+#include "quakedef.h"
+
+#include <nds.h>
+
+#define	SND_SPEED	11025
+#define	SND_FRAMES	4096		// per channel, a power of two
+#define	SND_CH_LEFT	0
+#define	SND_CH_RIGHT	1
+
+static short	mixbuffer[SND_FRAMES * 2] __attribute__((aligned(32)));
+static short	outbuffer[2][SND_FRAMES] __attribute__((aligned(32)));
+static unsigned	snd_timer;
+static u64	snd_start;
+
+qboolean SNDDMA_Init (void)
+{
+	memset (mixbuffer, 0, sizeof(mixbuffer));
+	memset (outbuffer, 0, sizeof(outbuffer));
+	armDCacheFlush (outbuffer, sizeof(outbuffer));
+
+	shm = &sn;
+	shm->splitbuffer = false;
+	shm->samplebits = 16;
+	shm->speed = SND_SPEED;
+	shm->channels = 2;
+	shm->samples = SND_FRAMES * 2;
+	shm->samplepos = 0;
+	shm->soundalive = true;
+	shm->gamealive = true;
+	shm->submission_chunk = 1;
+	shm->buffer = (unsigned char *) mixbuffer;
+
+	soundInit ();
+	soundPowerOn ();
+	soundSetMixerVolume (127);
+	snd_timer = soundTimerFromHz (SND_SPEED);
+	soundPreparePcm (SND_CH_LEFT, 2047, 0, snd_timer, SoundMode_Repeat, SoundFmt_Pcm16,
+		outbuffer[0], 0, sizeof(outbuffer[0]) / 4);
+	soundPreparePcm (SND_CH_RIGHT, 2047, 127, snd_timer, SoundMode_Repeat, SoundFmt_Pcm16,
+		outbuffer[1], 0, sizeof(outbuffer[1]) / 4);
+	soundStart (BIT(SND_CH_LEFT) | BIT(SND_CH_RIGHT));
+	snd_start = tickGetCount ();
+	return true;
+}
+
+int SNDDMA_GetDMAPos (void)
+{
+	// Ticks run at SYSTEM_CLOCK / 64, a sample lasts snd_timer SYSTEM_CLOCK / 2 cycles
+	u64 frames = (tickGetCount () - snd_start) * 32 / snd_timer;
+
+	shm->samplepos = (frames & (SND_FRAMES - 1)) * 2;
+	return shm->samplepos;
+}
+
+void SNDDMA_Submit (void)
+{
+	u32	*in = (u32 *) mixbuffer;
+	u32	*left = (u32 *) outbuffer[0], *right = (u32 *) outbuffer[1];
+	u32	a, b;
+	int	i;
+
+	// The whole ring, so a cleared buffer is silent at once. Two stereo
+	// frames at a time: LLRR words out of two LRLR words.
+	for (i = 0; i < SND_FRAMES / 2; i++)
+	{
+		a = *in++;
+		b = *in++;
+		*left++ = (a & 0xffff) | (b << 16);
+		*right++ = (a >> 16) | (b & 0xffff0000);
+	}
+	armDCacheFlush (outbuffer, sizeof(outbuffer));
+}
+
+void SNDDMA_Shutdown (void)
+{
+	soundStop (BIT(SND_CH_LEFT) | BIT(SND_CH_RIGHT));
+}
