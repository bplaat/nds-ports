From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] Copy memory fast on the DS

mem_nds.c replaces newlib's memcpy, memmove and memset, which copy a byte
at a time in Thumb mode, with word copies from ITCM.
---
 nds/mem_nds.c | 133 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 133 insertions(+)
 create mode 100644 nds/mem_nds.c

diff --git a/nds/mem_nds.c b/nds/mem_nds.c
new file mode 100644
index 0000000..96ba2a1
--- /dev/null
+++ b/nds/mem_nds.c
@@ -0,0 +1,133 @@
+//
+// memcpy, memmove and memset for the ARM9
+//
+// newlib's copy a byte at a time in Thumb mode, these move words, eight at a
+// time, or halfwords when only those line up, and run from ITCM. VRAM ignores
+// byte writes, so the edges are halfwords where they can be, copies to VRAM
+// need halfword aligned ends. Built without
+// builtins, so the compiler doesn't turn the loops back into calls to
+// themselves.
+//
+
+#include <stddef.h>
+#include <stdint.h>
+
+void *memcpy(void *dst, const void *src, size_t n)
+{
+    uint8_t *d = dst;
+    const uint8_t *s = src;
+
+    if ((((uintptr_t) d ^ (uintptr_t) s) & 3) == 0)
+    {
+        uint32_t *dw;
+        const uint32_t *sw;
+
+        if (n && ((uintptr_t) d & 1))
+        {
+            *d++ = *s++;
+            --n;
+        }
+        if (n >= 2 && ((uintptr_t) d & 2))
+        {
+            *(uint16_t *) d = *(const uint16_t *) s;
+            d += 2;
+            s += 2;
+            n -= 2;
+        }
+        dw = (uint32_t *) d;
+        sw = (const uint32_t *) s;
+        for (; n >= 32; n -= 32, dw += 8, sw += 8)
+        {
+            uint32_t a = sw[0], b = sw[1], c = sw[2], e = sw[3];
+            uint32_t f = sw[4], g = sw[5], h = sw[6], i = sw[7];
+
+            dw[0] = a; dw[1] = b; dw[2] = c; dw[3] = e;
+            dw[4] = f; dw[5] = g; dw[6] = h; dw[7] = i;
+        }
+        for (; n >= 4; n -= 4)
+            *dw++ = *sw++;
+        d = (uint8_t *) dw;
+        s = (const uint8_t *) sw;
+        if (n >= 2)
+        {
+            *(uint16_t *) d = *(const uint16_t *) s;
+            d += 2;
+            s += 2;
+            n -= 2;
+        }
+    }
+    else if ((((uintptr_t) d ^ (uintptr_t) s) & 1) == 0)
+    {
+        if (((uintptr_t) d & 1) && n)
+        {
+            *d++ = *s++;
+            --n;
+        }
+        for (; n >= 2; n -= 2, d += 2, s += 2)
+            *(uint16_t *) d = *(const uint16_t *) s;
+    }
+    while (n--)
+        *d++ = *s++;
+    return dst;
+}
+
+// Copies forward like memcpy unless the destination starts inside the source
+void *memmove(void *dst, const void *src, size_t n)
+{
+    uint8_t *d = dst;
+    const uint8_t *s = src;
+
+    if (d <= s || d >= s + n)
+        return memcpy(dst, src, n);
+    d += n;
+    s += n;
+    if ((((uintptr_t) d ^ (uintptr_t) s) & 3) == 0)
+    {
+        for (; n && ((uintptr_t) d & 3); --n)
+            *--d = *--s;
+        for (; n >= 4; n -= 4)
+        {
+            d -= 4;
+            s -= 4;
+            *(uint32_t *) d = *(const uint32_t *) s;
+        }
+    }
+    while (n--)
+        *--d = *--s;
+    return dst;
+}
+
+void *memset(void *dst, int c, size_t n)
+{
+    uint8_t *d = dst;
+    uint32_t *dw, v = (uint8_t) c * 0x01010101u;
+
+    if (n && ((uintptr_t) d & 1))
+    {
+        *d++ = c;
+        --n;
+    }
+    if (n >= 2 && ((uintptr_t) d & 2))
+    {
+        *(uint16_t *) d = v;
+        d += 2;
+        n -= 2;
+    }
+    dw = (uint32_t *) d;
+    for (; n >= 16; n -= 16, dw += 4)
+    {
+        dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
+    }
+    for (; n >= 4; n -= 4)
+        *dw++ = v;
+    d = (uint8_t *) dw;
+    if (n >= 2)
+    {
+        *(uint16_t *) d = v;
+        d += 2;
+        n -= 2;
+    }
+    while (n--)
+        *d++ = c;
+    return dst;
+}
