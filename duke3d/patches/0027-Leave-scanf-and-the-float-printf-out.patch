From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] Leave scanf and the float printf out

The game prints no floats and reads only the settings, so newlib's whole
scanf, its float printf and their decimal conversion code don't need to
be in the ROM. The settings parser strips quotes and reads its rare float
values itself and writes them in thousandths, and stdio_nds.c sends all
printing to newlib's integer-only printf, with a small siscanf for libnds'
console (64 KB).
---
 Game/src/scriplib.c |  47 +++++++++++++++++---
 nds/stdio_nds.c     | 106 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 146 insertions(+), 7 deletions(-)
 create mode 100644 nds/stdio_nds.c

diff --git a/Game/src/scriplib.c b/Game/src/scriplib.c
index 4164c22..1683a00 100644
--- a/Game/src/scriplib.c
+++ b/Game/src/scriplib.c
@@ -122,7 +122,13 @@ static void SCRIPT_writenode (scriptnode_t *node, FILE *fp)
 			fprintf (fp, "%s = %d\n", node->key, node->data.number);
 			break;
 		case SCRIPTFLAG_FLOAT:
-			fprintf (fp, "%s = %ff\n", node->key, node->data.floatnumber);
+			/* in thousandths, without the C library's float printing */
+			{
+				int32 thousandths = (int32)(node->data.floatnumber * 1000.0f + (node->data.floatnumber < 0 ? -0.5f : 0.5f));
+
+				fprintf (fp, "%s = %s%d.%03df\n", node->key, thousandths < 0 ? "-" : "",
+						 abs(thousandths) / 1000, abs(thousandths) % 1000);
+			}
 			break;
 	}
 }
@@ -225,6 +231,36 @@ static int SCRIPT_getnexttoken (char  *buffer, char * token, int start)
 }
 
 /* Fills in a scriptnode with the interpreted contents of a line */
+/* A decimal number with an f behind it, without the C library's strtod */
+static float SCRIPT_parsefloat (char  *s)
+{
+	float value = 0.0f, scale = 1.0f;
+	int negative = (*s == '-');
+
+	if (negative) s++;
+	for (; isdigit (*s); s++) value = value * 10.0f + (*s - '0');
+	if (*s == '.')
+		for (s++; isdigit (*s); s++) value += (*s - '0') * (scale *= 0.1f);
+	return negative ? -value : value;
+}
+
+/* The text between the first two quotes, up to the end without the second
+   one, empty without the first */
+static void SCRIPT_unquote (char  *s)
+{
+	char  *end;
+
+	if (s[0] != '"')
+	{
+		s[0] = '\0';
+		return;
+	}
+	if ((end = strchr (s + 1, '"')) == NULL)
+		end = s + strlen (s);
+	memmove (s, s + 1, end - s - 1);
+	s[end - s - 1] = '\0';
+}
+
 static void SCRIPT_parseline (char  *curline, scriptnode_t *node)
 {
 	char  token[128];
@@ -263,7 +299,7 @@ static void SCRIPT_parseline (char  *curline, scriptnode_t *node)
 	}else if (token[strlen(token) - 1] == 'f') {
 		/* Found a float */
 		node->type = SCRIPTFLAG_FLOAT;
-		node->data.floatnumber = atof(token);
+		node->data.floatnumber = SCRIPT_parsefloat(token);
 	}else if (isdigit (token[0])) {
 		/* Found a number! */
 		node->type = SCRIPTFLAG_DECIMAL;
@@ -280,7 +316,6 @@ static void SCRIPT_parseline (char  *curline, scriptnode_t *node)
 		node->data.number = -1;
 	}else if (token[0] == '"') {
 		char  workbuf[128];
-		int r;
 
 		/* Found one of possibly two strings */
 		strcpy (workbuf, token);
@@ -290,8 +325,7 @@ static void SCRIPT_parseline (char  *curline, scriptnode_t *node)
 			strcat (workbuf, " ");
 			strcat (workbuf, token);
 		}
-		r = sscanf(workbuf, "\"%[^\"]\"", workbuf);
-		if (r == 0) workbuf[0] = '\0';
+		SCRIPT_unquote(workbuf);
 
 		node->type = SCRIPTFLAG_ONESTRING;
 		node->data.string[0] = SCRIPT_copystring (workbuf);
@@ -305,8 +339,7 @@ static void SCRIPT_parseline (char  *curline, scriptnode_t *node)
 				strcat (workbuf, " ");
 				strcat (workbuf, token);
 			}
-			r = sscanf(workbuf, "\"%[^\"]\"", workbuf);
-			if (r == 0) workbuf[0] = '\0';
+			SCRIPT_unquote(workbuf);
 
 			node->type = SCRIPTFLAG_TWOSTRING;
 			node->data.string[1] = SCRIPT_copystring (workbuf);
diff --git a/nds/stdio_nds.c b/nds/stdio_nds.c
new file mode 100644
index 0000000..b6fff5d
--- /dev/null
+++ b/nds/stdio_nds.c
@@ -0,0 +1,106 @@
+//
+// printf and friends for the ARM9
+//
+// Duke Nukem 3D prints no floats, so newlib's integer-only printf, which
+// libnds' console uses already, does all the formatting: the float one, with
+// its decimal conversion and locale code, is left out of the ROM. libnds'
+// console reads its escape sequences with siscanf, using only %d, which a
+// few lines do instead of newlib's whole scanf with its Unicode tables.
+//
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+int vfprintf(FILE *stream, const char *format, va_list ap)
+{
+    return vfiprintf(stream, format, ap);
+}
+
+int fprintf(FILE *stream, const char *format, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, format);
+    n = vfiprintf(stream, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int vprintf(const char *format, va_list ap)
+{
+    return viprintf(format, ap);
+}
+
+int printf(const char *format, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, format);
+    n = viprintf(format, ap);
+    va_end(ap);
+    return n;
+}
+
+int vsprintf(char *str, const char *format, va_list ap)
+{
+    return vsiprintf(str, format, ap);
+}
+
+int sprintf(char *str, const char *format, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, format);
+    n = vsiprintf(str, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int vsnprintf(char *str, size_t size, const char *format, va_list ap)
+{
+    return vsniprintf(str, size, format, ap);
+}
+
+int snprintf(char *str, size_t size, const char *format, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, format);
+    n = vsniprintf(str, size, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int siscanf(const char *str, const char *format, ...)
+{
+    va_list ap;
+    int n = 0;
+
+    va_start(ap, format);
+    for (; *format; ++format)
+    {
+        if (format[0] == '%' && format[1] == 'd')
+        {
+            char *end;
+            int value = strtol(str, &end, 10);
+
+            if (end == str)
+                break;
+            *va_arg(ap, int *) = value;
+            str = end;
+            ++format;
+            ++n;
+        }
+        else if (*str++ != *format)
+        {
+            break;
+        }
+    }
+    va_end(ap);
+    return n;
+}
