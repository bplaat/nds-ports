-                
-	            vplce[i] += vince[i];
-            }
-            dest += bytesperline;
-        } while (((uint32_t)dest - bytesperline) < ((uint32_t)dest));
+        vlineasm2(numRows, (uint16_t *)framebuffer, 0);
+        vlineasm2(numRows, (uint16_t *)framebuffer + 1, 2);
