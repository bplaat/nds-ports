 //FCS This is used to fill the inside of a wall (so it draws VERTICAL column, always).
-void vlineasm4(int32_t columnIndex, intptr_t framebuffer)
+//Two columns at a time, a halfword per row, so everything fits in registers
+static inline void vlineasm2(int32_t numRows, uint16_t *dest, int32_t i)
 {
+    const int32_t shift = mach3_al, pitch = bytesperline >> 1;
+    const int32_t i0 = vince[i], i1 = vince[i + 1];
+    const uint8_t *b0 = (const uint8_t *)bufplce[i], *b1 = (const uint8_t *)bufplce[i + 1];
+    const uint8_t *p0 = palookupoffse[i], *p1 = palookupoffse[i + 1];
+    uint32_t v0 = vplce[i], v1 = vplce[i + 1];
 
-	if (!RENDER_DRAW_WALL_INSIDE)
-		return ;
+    do {
+        *dest = p0[b0[v0 >> shift]] | (p1[b1[v1 >> shift]] << 8);
+        v0 += i0;
+        v1 += i1;
+        dest += pitch;
+    } while (--numRows);
+    vplce[i] = v0;
+    vplce[i + 1] = v1;
+}
 
+void vlineasm4(int32_t numRows, intptr_t framebuffer)
+{
+    int i;
+
