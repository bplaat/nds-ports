+
+#ifndef DUKE3D_NDS_H
+#define DUKE3D_NDS_H
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+// The top screen, BUILD renders at this resolution
+#define NDS_SCREEN_W 256
+#define NDS_SCREEN_H 192
+
+// The touch screen's DMA channel
+#define NDS_HUD_DMA 3
+
+void NDS_ErrorBox(const char *fmt, va_list args);
+void NDS_QuietOutput(void);
+void findGRPToUse(char *path);
+
+void NDS_InitVideo(void);
+void *NDS_AllocVRAM(int size);
+uint32_t NDS_VBlankCount(void);
+void NDS_ShowSplash(const uint8_t *pixels, const uint8_t *pal);
+void NDS_PostScancode(int scancode, bool pressed);
+
+void NDS_PollInput(void);
+void NDS_TapScancode(int scancode);
+void NDS_PollTouch(uint32_t down);
+void NDS_UpdateSound(void);
+
+void NDS_UpdateSubScreen(void);
+
+#endif
