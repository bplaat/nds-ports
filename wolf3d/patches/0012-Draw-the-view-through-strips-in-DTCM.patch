 #if defined(USE_FEATUREFLAGS) && defined(USE_STARSKY)
     if(GetFeatureFlags() & FF_STARSKY)
         DrawStarSky();
@@ -1527,6 +1551,8 @@ void ThreeDRefresh (void)
 
     DrawPlayerWeapon ();    // draw player's hands
 
+    DrawView ();
