+/*
+===================
+=
+= ScaleLine
+=
+= Queues a sprite column over column x of the view, DrawSpriteColumns draws
+= them once the view is put together
+=
+===================
+*/
+
+typedef struct
+{
+    byte    *linesrc;
+    byte    *curshades;
+    fixed   fracstep;
+    word    cmdofs;                             // of the segment data in linesrc
+    int16_t toppix;
+    word    next;                               // the next one over the column, 0 ends
+} spriteline_t;
+
+#define MAXSPRITELINES 4096
+
+static spriteline_t spritelines[MAXSPRITELINES];
+static int numspritelines;
+// The first and last sprite column over each column of the view, 0 for none
+static word firstline[TOPSCREENWIDTH], lastline[TOPSCREENWIDTH];
+
+void ScaleLine (int16_t x, int16_t toppix, fixed fracstep, byte *linesrc, byte *linecmds, byte *curshades)
+{
+    spriteline_t *line;
+
+    if (numspritelines == MAXSPRITELINES)
+        return;                                 // too many sprites over each other
+
+    line = &spritelines[numspritelines++];
+    line->linesrc = linesrc;
+    line->curshades = curshades;
+    line->fracstep = fracstep;
+    line->cmdofs = linecmds - linesrc;
+    line->toppix = toppix;
+    line->next = 0;
+
+    if (firstline[x])
+        spritelines[lastline[x] - 1].next = numspritelines;
+    else
+        firstline[x] = numspritelines;
+    lastline[x] = numspritelines;
+}
+
+void DrawSpriteColumns (byte *post, int x)
+{
+    const spriteline_t *line;
+    word i;
+
+    for (i = firstline[x]; i; i = line->next)
+    {
+        line = &spritelines[i - 1];
+        DrawSpriteLine (post, line->toppix, line->fracstep, line->linesrc, line->linesrc + line->cmdofs, line->curshades);
+    }
+
+    // The queue is empty once the last column is drawn
+    firstline[x] = 0;
+    if (x == viewwidth - 1)
+        numspritelines = 0;
+}
+
+
 /*
