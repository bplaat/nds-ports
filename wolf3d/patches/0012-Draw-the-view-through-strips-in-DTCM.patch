+++ b/wl_draw.c
@@ -296,11 +296,23 @@ int16_t CalcHeight (void)
 ===================
 */
 
+//
+// Writing the view down the columns of the frame misses the data cache with
+// every pixel, which is slow in DS main RAM. The ray caster and the sprites
+// only note their columns instead, the view is then put together in strips
+// of VIEWSTRIP columns that stay in DTCM and are copied into the frame in
+// words: the ceiling and floor, the wall post of each column and the
+// sprite columns queued over it by ScaleLine.
+//
+
+extern byte vgaCeiling[];
+
+static byte viewstrip[VIEWSTRIP * TOPSCREENHEIGHT] __attribute__((section(".sbss"), aligned(32)));
+static byte *postsources[TOPSCREENWIDTH];
+boolean viewdrawn;
+
 void ScalePost (void)
 {
-    int ywcount, yoffs, yw, yd, yendoffs;
-    byte col;
-
 #ifdef USE_SKYWALLPARALLAX
     if (tilehit == 16)
     {
@@ -309,59 +321,72 @@ void ScalePost (void)
     }
 #endif
 
-#ifdef USE_SHADING
-    byte *curshades = shadetable[GetShade(wallheight[postx])];
-#endif
-
-    ywcount = yd = wallheight[postx] >> 3;
-    if(yd <= 0) yd = 100;
+    postsources[postx] = postsource;
+}
 
-    yoffs = (centery - ywcount) * bufferPitch;
-    if(yoffs < 0) yoffs = 0;
-    yoffs += postx;
+// Fills the strip with the ceiling above the middle of the view and the
+// floor below it
+static void FillStrip (void)
+{
+    memset(viewstrip, vgaCeiling[gamestate.episode*10+gamestate.mapon], centery * VIEWSTRIP);
+    memset(viewstrip + centery * VIEWSTRIP, 0x19, (viewheight - centery) * VIEWSTRIP);
+}
 
-    yendoffs = centery + ywcount - 1;
-    yw=TEXTURESIZE-1;
+// Draws the wall post of column x into its column of the strip
+static void DrawPost (byte *post, int x)
+{
+    // The texture steps in 16.16 fixed point, from the top of the wall,
+    // through a copy of its column in DTCM
+    static byte column[TEXTURESIZE] __attribute__((section(".sbss"), aligned(4)));
+    int height = wallheight[x] >> 3;            // half the height in pixels
+    int top = centery - height;
+    int y1 = MAX(top, 0), n = MIN(centery + height, viewheight) - y1;
+    const byte *src;
+    fixed step, frac;
+
+    if (height <= 0 || n <= 0)
+        return;
+    src = memcpy(column, postsources[x], TEXTURESIZE);
+    step = div32((TEXTURESIZE/2) << FRACBITS, height);
+    frac = (y1 - top) * step;
+    post += y1 * VIEWSTRIP;
 
-    while(yendoffs >= viewheight)
+    // Four pixels per loop, a branch costs the ARM9 three cycles
+    for (; n >= 4; n -= 4, post += 4 * VIEWSTRIP)
     {
-        ywcount -= TEXTURESIZE/2;
-        while(ywcount <= 0)
-        {
-            ywcount += yd;
-            yw--;
-        }
-        yendoffs--;
+        post[0] = src[frac >> FRACBITS];
+        frac += step;
+        post[VIEWSTRIP] = src[frac >> FRACBITS];
+        frac += step;
+        post[2 * VIEWSTRIP] = src[frac >> FRACBITS];
+        frac += step;
+        post[3 * VIEWSTRIP] = src[frac >> FRACBITS];
+        frac += step;
     }
-    if(yw < 0) return;
+    for (; n > 0; n--, post += VIEWSTRIP, frac += step)
+        *post = src[frac >> FRACBITS];
+}
 
-#ifdef USE_SHADING
-    col = curshades[postsource[yw]];
-#else
-    col = postsource[yw];
-#endif
-    yendoffs = yendoffs * bufferPitch + postx;
-    while(yoffs <= yendoffs)
+// Puts the view together a strip at a time, into the frame at vbuf
+static void DrawView (void)
+{
+    int x, i, y;
+
+    for (x = 0; x < viewwidth; x += VIEWSTRIP)
     {
-        vbuf[yendoffs] = col;
-        ywcount -= TEXTURESIZE/2;
-        if(ywcount <= 0)
+        const uint64_t *src = (const uint64_t *) viewstrip;
+        byte *dest = vbuf + x;
+
+        FillStrip ();
+        for (i = 0; i < VIEWSTRIP; i++)
         {
-            do
-            {
-                ywcount += yd;
-                yw--;
-            }
-            while(ywcount <= 0);
-            if(yw < 0) break;
-#ifdef USE_SHADING
-            col = curshades[postsource[yw]];
-#else
-            col = postsource[yw];
-#endif
+            DrawPost (viewstrip + i, x + i);
+            DrawSpriteColumns (viewstrip + i, x + i);
         }
-        yendoffs -= bufferPitch;
+        for (y = 0; y < viewheight; y++, dest += bufferPitch)
+            *(uint64_t *) dest = *src++;
     }
+    viewdrawn = true;
 }
 
