From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Thu, 1 Oct 2026 09:40:02 +0200
Subject: [PATCH] Add the map, status bar and touch buttons to the touch screen

The touch screen shows the explored part of the level as a map around
the player, with the walls in the average color of their textures and
the doors in the colors of their keys, zoomed by a button or SELECT.
Below it is the status bar, without the weapon, which fits the width,
and buttons with the four weapons. Without a game it lists the
controls. Each part is only redrawn when what it shows changes.

As the status bar is on the touch screen, the view now starts full
screen on the top screen.
---
 nds/wl_nds.c | 487 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 wl_main.c    |   4 +
 2 files changed, 489 insertions(+), 2 deletions(-)

diff --git a/nds/wl_nds.c b/nds/wl_nds.c
index 99d1481..802ee19 100644
--- a/nds/wl_nds.c
+++ b/nds/wl_nds.c
@@ -5,6 +5,8 @@
 //   the .nds or embedded in the ROM (NitroFS), the full game before the
 //   shareware, and keeps the config and savegames in /data/wolf3d/
 // - Errors are shown on the touch screen console
+// - The touch screen shows a map of the explored level, the status bar and
+//   buttons for the weapons, or the controls without a game
 // - Dragging the stylus turns the player like a mouse
 //
 
@@ -148,8 +150,458 @@ found:
     *argv = args;
 }
 
+// ---------------------------------------------------------------------------
+// Touch screen: automap, status bar and touch buttons
+// ---------------------------------------------------------------------------
+
+#define SUB_WIDTH   256
+#define SUB_HEIGHT  192
+#define MAP_HEIGHT  120
+#define STATUS_Y    MAP_HEIGHT
+#define BAR_Y       (STATUS_Y + STATUSLINES)
+
+typedef struct
+{
+    int x, w;
+    int pic;                        // weapon picture, or 0 for the map zoom
+} touch_button_t;
+
+static const touch_button_t touch_buttons[] =
+{
+    {   0, 48, KNIFEPIC },
+    {  48, 48, GUNPIC },
+    {  96, 48, MACHINEGUNPIC },
+    { 144, 48, GATLINGGUNPIC },
+    { 192, 64, 0 },
+};
+
+static byte sub_fb[SUB_WIDTH * SUB_HEIGHT] __attribute__((aligned(32)));
+static bool sub_bitmap;
+static unsigned map_hash, status_hash, bar_hash, panel_hash;
+static int map_zoom = 8;
+static int touch_button = -1;
+
+// Tiles seen this level, and the level they belong to
+static bool seen[MAPSIZE][MAPSIZE];
+static int seen_level = -1;
+static int32_t seen_time;
+
+// Palette indices, matched to the game palette
+static byte col_black, col_white, col_gray, col_gold, col_red, col_floor;
+static byte col_door, col_door_gold, col_door_silver, col_button, col_button_hi, col_button_lo, col_button_on;
+static byte wall_colors[64], wall_colors_done[64];
+static byte dark_xlat[256];
+
+static byte NearestColor (int r, int g, int b)
+{
+    int i, best = 0, best_diff = 1 << 30;
+
+    for (i = 0; i < 256; ++i)
+    {
+        int dr = r - gamepal[i].r, dg = g - gamepal[i].g, db = b - gamepal[i].b;
+        int diff = dr * dr + dg * dg + db * db;
+
+        if (diff < best_diff)
+        {
+            best = i;
+            best_diff = diff;
+        }
+    }
+    return best;
+}
+
+static void CopyToVRAM (int y, int h)
+{
+    memcpy ((byte *) BG_BMP_RAM_SUB (0) + y * SUB_WIDTH, sub_fb + y * SUB_WIDTH, h * SUB_WIDTH);
+}
+
+static void InitSubScreen (void)
+{
+    int i;
+
+    for (i = 0; i < 256; ++i)
+        BG_PALETTE_SUB[i] = RGB15 (gamepal[i].r >> 3, gamepal[i].g >> 3, gamepal[i].b >> 3);
+    for (i = 0; i < 256; ++i)
+        dark_xlat[i] = NearestColor (gamepal[i].r / 3, gamepal[i].g / 3, gamepal[i].b / 3);
+    col_black = NearestColor (0, 0, 0);
+    col_white = NearestColor (252, 252, 252);
+    col_gray = NearestColor (144, 144, 144);
+    col_floor = NearestColor (72, 72, 72);
+    col_gold = NearestColor (252, 212, 0);
+    col_red = NearestColor (252, 0, 0);
+    col_door = NearestColor (0, 160, 160);
+    col_door_gold = NearestColor (220, 180, 0);
+    col_door_silver = NearestColor (176, 176, 208);
+    col_button = NearestColor (0, 0, 120);
+    col_button_hi = NearestColor (64, 64, 184);
+    col_button_lo = NearestColor (0, 0, 64);
+    col_button_on = NearestColor (148, 0, 0);
+
+    videoSetModeSub (MODE_5_2D);
+    vramSetBankC (VRAM_C_SUB_BG);
+    bgInitSub (3, BgType_Bmp8, BgSize_B8_256x256, 0, 0);
+    memset (sub_fb, col_black, sizeof(sub_fb));
+    CopyToVRAM (0, SUB_HEIGHT);
+    status_hash = bar_hash = panel_hash = 0;
+    sub_bitmap = true;
+}
+
+static void FillRect (int x, int y, int w, int h, byte color)
+{
+    for (; h > 0; --h, ++y)
+        memset (sub_fb + y * SUB_WIDTH + x, color, w);
+}
+
+// Draws a picture, clipped to the screen, optionally darkened
+static void DrawPic (int x, int y, int pic, const byte *xlat)
+{
+    const pictabletype *size = &pictable[pic - STARTPICS];
+    const byte *src = grsegs[pic];
+    int row, col;
+
+    if (src == NULL)
+        return;
+    for (row = 0; row < size->height && y + row < SUB_HEIGHT; ++row)
+    {
+        byte *dest = sub_fb + (y + row) * SUB_WIDTH + x;
+
+        for (col = 0; col < size->width && x + col < SUB_WIDTH; ++col)
+            dest[col] = xlat ? xlat[src[row * size->width + col]] : src[row * size->width + col];
+    }
+}
+
+static int TextWidth (const char *s, int font)
+{
+    const fontstruct *f = (const fontstruct *) grsegs[STARTFONT + font];
+    int w = 0;
+
+    for (; *s; ++s)
+        w += f->width[(byte) *s];
+    return w;
+}
+
+static void DrawText (int x, int y, const char *s, int font, byte color)
+{
+    const fontstruct *f = (const fontstruct *) grsegs[STARTFONT + font];
+
+    for (; *s; ++s)
+    {
+        const byte *src = (const byte *) f + f->location[(byte) *s];
+        int w = f->width[(byte) *s], row, col;
+
+        for (row = 0; row < f->height; ++row)
+            for (col = 0; col < w; ++col)
+                if (src[row * w + col] && x + col < SUB_WIDTH)
+                    sub_fb[(y + row) * SUB_WIDTH + x + col] = color;
+        x += w;
+    }
+}
+
+// The face the status bar shows, like DrawFace
+static int FacePic (void)
+{
+    if (SD_SoundPlaying () == GETGATLINGSND)
+        return GOTGATLINGPIC;
+    if (gamestate.health)
+        return FACE1APIC + 3 * ((100 - gamestate.health) / 16) + gamestate.faceframe;
+    if (LastAttacker && LastAttacker->obclass == needleobj)
+        return MUTANTBJPIC;
+    return FACE8APIC;
+}
+
+// A right aligned number in the status bar font, like LatchNumber
+static void DrawNumber (int x, int y, int width, int32_t number)
+{
+    char str[12];
+    int len = snprintf (str, sizeof(str), "%ld", (long) number), i;
+
+    for (i = 0; i < width; ++i)
+    {
+        int c = len - width + i;
+        DrawPic (x + i * 8, y, c < 0 ? N_BLANKPIC : N_0PIC + str[c] - '0', NULL);
+    }
+}
+
+// The status bar without the weapon, which is on a touch button, fits the
+// width of the touch screen
+static void DrawStatus (void)
+{
+    DrawPic (0, STATUS_Y, STATUSBARPIC, NULL);
+    DrawNumber (16, STATUS_Y + 16, 2, gamestate.mapon + 1);
+    DrawNumber (48, STATUS_Y + 16, 6, gamestate.score);
+    DrawNumber (112, STATUS_Y + 16, 1, gamestate.lives);
+    DrawPic (136, STATUS_Y + 4, FacePic (), NULL);
+    DrawNumber (168, STATUS_Y + 16, 3, gamestate.health);
+    DrawNumber (216, STATUS_Y + 16, 2, gamestate.ammo);
+    DrawPic (240, STATUS_Y + 4, gamestate.keys & 1 ? GOLDKEYPIC : NOKEYPIC, NULL);
+    DrawPic (240, STATUS_Y + 20, gamestate.keys & 2 ? SILVERKEYPIC : NOKEYPIC, NULL);
+}
+
+static unsigned StatusHash (void)
+{
+    unsigned h = FacePic ();
+
+    h = h * 33 + gamestate.mapon;
+    h = h * 33 + gamestate.score;
+    h = h * 33 + gamestate.lives;
+    h = h * 33 + gamestate.health;
+    h = h * 33 + gamestate.ammo;
+    h = h * 33 + gamestate.keys;
+    return h | 1;
+}
+
+static void DrawButton (const touch_button_t *b, bool pressed, bool on, bool enabled)
+{
+    int y = BAR_Y + 2, h = SUB_HEIGHT - BAR_Y - 2;
+    byte face = pressed ? col_button_lo : on ? col_button_on : col_button;
+
+    FillRect (b->x, y, b->w, h, pressed ? col_button_hi : col_button_lo);
+    FillRect (b->x, y, b->w - 1, h - 1, pressed ? col_button_lo : col_button_hi);
+    FillRect (b->x + 1, y + 1, b->w - 2, h - 2, face);
+    if (b->pic)
+        DrawPic (b->x + (b->w - 48) / 2 + pressed, y + (h - 24) / 2 + pressed, b->pic, enabled ? NULL : dark_xlat);
+    else
+    {
+        const char *label = map_zoom == 8 ? "ZOOM OUT" : "ZOOM IN";
+        DrawText (b->x + (b->w - TextWidth (label, 0)) / 2 + pressed, y + 9 + pressed, label, 0, enabled ? col_white : col_gray);
+    }
+}
+
+static void DrawTouchBar (void)
+{
+    unsigned i;
+
+    FillRect (0, BAR_Y, SUB_WIDTH, SUB_HEIGHT - BAR_Y, col_black);
+    for (i = 0; i < lengthof(touch_buttons); ++i)
+    {
+        const touch_button_t *b = &touch_buttons[i];
+        bool weapon = b->pic != 0;
+
+        DrawButton (b, (int) i == touch_button, ingame && weapon && (int) i == gamestate.weapon,
+            ingame && (!weapon || (int) i <= gamestate.bestweapon));
+    }
+}
+
+static unsigned BarHash (void)
+{
+    unsigned h = (touch_button + 2) * 131 + map_zoom;
+
+    if (ingame)
+        h = h * 33 + gamestate.weapon * 7 + gamestate.bestweapon + 1;
+    return h | 1;
+}
+
+static byte WallColor (int tile)
+{
+    // The average color of the wall texture
+    if (!wall_colors_done[tile])
+    {
+        const byte *src = PM_GetPage ((tile - 1) * 2);
+        int r = 0, g = 0, b = 0, i;
+
+        for (i = 0; i < TEXTURESIZE * TEXTURESIZE; ++i)
+        {
+            r += gamepal[src[i]].r;
+            g += gamepal[src[i]].g;
+            b += gamepal[src[i]].b;
+        }
+        wall_colors[tile] = NearestColor (r / (TEXTURESIZE * TEXTURESIZE), g / (TEXTURESIZE * TEXTURESIZE), b / (TEXTURESIZE * TEXTURESIZE));
+        wall_colors_done[tile] = true;
+    }
+    return wall_colors[tile];
+}
+
+static bool Seen (int x, int y)
+{
+    return x >= 0 && x < MAPSIZE && y >= 0 && y < MAPSIZE && seen[x][y];
+}
+
+// Adds the tiles in view, returns whether any were new
+static bool UpdateSeen (void)
+{
+    int level = gamestate.episode * 10 + gamestate.mapon;
+    uint32_t *dest = (uint32_t *) seen, changed = 0;
+    const uint32_t *src = (const uint32_t *) spotvis;
+    int i;
+
+    // A new level, or the same one again
+    if (level != seen_level || gamestate.TimeCount < seen_time)
+    {
+        memset (seen, 0, sizeof(seen));
+        seen_level = level;
+        changed = 1;
+    }
+    seen_time = gamestate.TimeCount;
+    seen[player->tilex][player->tiley] = true;
+    for (i = 0; i < MAPAREA / 4; ++i)
+    {
+        changed |= src[i] & ~dest[i];
+        dest[i] |= src[i];
+    }
+    return changed != 0;
+}
+
+// What the map shows: the player and the doors
+static unsigned MapHash (void)
+{
+    unsigned h = (player->x * map_zoom) >> TILESHIFT;
+    int i;
+
+    h = h * 33 + ((player->y * map_zoom) >> TILESHIFT);
+    h = h * 33 + player->angle / 8;
+    for (i = 0; i < MAXDOORS; ++i)
+        h = h * 3 + doorobjlist[i].position;
+    return h * 33 + pwallstate + 1;
+}
+
+// The explored part of the level around the player, walls in the colors of
+// their textures, doors in the colors of their keys
+static void DrawMap (void)
+{
+    int z = map_zoom;
+    int px = (player->x * z) >> TILESHIFT, py = (player->y * z) >> TILESHIFT;
+    int left = px - SUB_WIDTH / 2, top = py - MAP_HEIGHT / 2;
+    int tx0 = MAX (left / z, 0), tx1 = MIN ((left + SUB_WIDTH) / z + 1, MAPSIZE);
+    int ty0 = MAX (top / z, 0), ty1 = MIN ((top + MAP_HEIGHT) / z + 1, MAPSIZE);
+    int tx, ty;
+
+    FillRect (0, 0, SUB_WIDTH, MAP_HEIGHT, col_black);
+    for (tx = tx0; tx < tx1; ++tx)
+    {
+        for (ty = ty0; ty < ty1; ++ty)
+        {
+            int tile = tilemap[tx][ty], x = tx * z - left, y = ty * z - top, w = z, h = z;
+            bool near = Seen (tx, ty) || Seen (tx - 1, ty) || Seen (tx + 1, ty) || Seen (tx, ty - 1) || Seen (tx, ty + 1);
+            byte color;
+
+            if (tile & BIT_DOOR)
+            {
+                const doorobj_t *door = &doorobjlist[tile & ~BIT_DOOR];
+
+                if (!near)
+                    continue;
+                color = door->lock == dr_lock1 ? col_door_gold : door->lock == dr_lock2 ? col_door_silver : col_door;
+                // A bar across the tile, shorter as the door opens
+                if (door->vertical)
+                {
+                    x += z / 2 - z / 4;
+                    w = MAX (z / 2, 1);
+                    h = z - (z * door->position >> 16);
+                }
+                else
+                {
+                    y += z / 2 - z / 4;
+                    h = MAX (z / 2, 1);
+                    w = z - (z * door->position >> 16);
+                }
+            }
+            else if (tile)
+            {
+                if (!near)
+                    continue;
+                color = WallColor (tile == BIT_WALL ? pwalltile : tile & ~BIT_WALL);
+            }
+            else if (seen[tx][ty])
+                color = col_floor;
+            else
+                continue;
+
+            // Clipped to the map area
+            if (x < 0) { w += x; x = 0; }
+            if (y < 0) { h += y; y = 0; }
+            if (x + w > SUB_WIDTH) w = SUB_WIDTH - x;
+            if (y + h > MAP_HEIGHT) h = MAP_HEIGHT - y;
+            if (w > 0 && h > 0)
+                FillRect (x, y, w, h, color);
+        }
+    }
+
+    // The player, an arrow in the direction of view
+    {
+        int cx = px - left, cy = py - top, i;
+
+        for (i = -4; i <= 4; ++i)
+        {
+            int x = cx + (costable[player->angle] * i >> 16);
+            int y = cy - (sintable[player->angle] * i >> 16);
+
+            if (x >= 0 && x < SUB_WIDTH && y >= 0 && y < MAP_HEIGHT)
+                sub_fb[y * SUB_WIDTH + x] = i > 1 ? col_gold : col_red;
+        }
+        FillRect (cx - 1, cy - 1, 3, 3, col_red);
+    }
+}
+
+// The controls while not playing
+static void DrawHelpPanel (void)
+{
+    static const char *lines[][2] =
+    {
+        { "D-Pad", "Move and turn" },
+        { "A", "Fire / select" },
+        { "B", "Open / back" },
+        { "X", "Next weapon" },
+        { "Y", "Run (hold)" },
+        { "L R", "Strafe" },
+        { "START", "Menu" },
+        { "SELECT", "Zoom the map" },
+        { "Stylus", "Drag to turn" },
+    };
+    const char *title = "Wolfenstein 3D";
+    unsigned i;
+
+    FillRect (0, 0, SUB_WIDTH, BAR_Y, col_black);
+    DrawText ((SUB_WIDTH - TextWidth (title, 1)) / 2, 8, title, 1, col_gold);
+    FillRect (24, 30, SUB_WIDTH - 48, 1, col_gray);
+    for (i = 0; i < lengthof(lines); ++i)
+    {
+        DrawText (40, 38 + i * 13, lines[i][0], 0, col_white);
+        DrawText (104, 38 + i * 13, lines[i][1], 0, col_gray);
+    }
+}
+
 void NDS_UpdateSubScreen (void)
 {
+    unsigned hash;
+    bool playing = ingame && player != NULL;
+
+    // The graphics are loaded once the game shows anything
+    if (!sub_bitmap)
+    {
+        if (grsegs[STATUSBARPIC] == NULL)
+            return;
+        InitSubScreen ();
+    }
+
+    if (playing)
+    {
+        if (UpdateSeen () || (hash = MapHash ()) != map_hash || panel_hash != 1)
+        {
+            map_hash = MapHash ();
+            DrawMap ();
+            CopyToVRAM (0, MAP_HEIGHT);
+        }
+        if (panel_hash != 1 || (hash = StatusHash ()) != status_hash)
+        {
+            status_hash = StatusHash ();
+            DrawStatus ();
+            CopyToVRAM (STATUS_Y, STATUSLINES);
+        }
+        panel_hash = 1;
+    }
+    else if (panel_hash != 2)
+    {
+        DrawHelpPanel ();
+        CopyToVRAM (0, BAR_Y);
+        panel_hash = 2;
+    }
+
+    if ((hash = BarHash ()) != bar_hash)
+    {
+        bar_hash = hash;
+        DrawTouchBar ();
+        CopyToVRAM (BAR_Y, SUB_HEIGHT - BAR_Y);
+    }
 }
 
 // ---------------------------------------------------------------------------
@@ -161,20 +613,51 @@ void NDS_UpdateSubScreen (void)
 static bool touch_dragging;
 static int touch_last_x;
 
+static void ReleaseButton (void)
+{
+    if (touch_button >= 0 && touch_buttons[touch_button].pic)
+        NDS_PushKey (SDL_SCANCODE_1 + touch_button, false);
+    touch_button = -1;
+}
+
 void NDS_PollInput (uint32_t down, uint32_t held)
 {
     touchPosition touch;
+    unsigned i;
 
+    if (down & KEY_SELECT)
+        map_zoom = map_zoom == 8 ? 4 : 8;
     if (!(held & KEY_TOUCH))
     {
+        ReleaseButton ();
         touch_dragging = false;
         return;
     }
     touchRead (&touch);
     if (down & KEY_TOUCH)
     {
-        touch_dragging = true;
-        touch_last_x = touch.px;
+        if (touch.py < BAR_Y)
+        {
+            touch_dragging = true;
+            touch_last_x = touch.px;
+            return;
+        }
+        for (i = 0; i < lengthof(touch_buttons); ++i)
+        {
+            const touch_button_t *b = &touch_buttons[i];
+
+            if (touch.px < b->x || touch.px >= b->x + b->w)
+                continue;
+            touch_button = i;
+            // The weapon buttons are its number keys
+            if (b->pic)
+                NDS_PushKey (SDL_SCANCODE_1 + i, true);
+            else
+            {
+                map_zoom = map_zoom == 8 ? 4 : 8;
+            }
+            break;
+        }
         return;
     }
     if (touch_dragging)
diff --git a/wl_main.c b/wl_main.c
index 756771e..2b322cd 100644
--- a/wl_main.c
+++ b/wl_main.c
@@ -234,7 +234,11 @@ noconfig:
         if (IN_JoyPresent())
             joystickenabled = true;
 
+#ifdef __NDS__
+        viewsize = 21;                          // the status bar is on the touch screen
+#else
         viewsize = 19;                          // start with a good size
+#endif
         mouseadjustment=5;
     }
 
