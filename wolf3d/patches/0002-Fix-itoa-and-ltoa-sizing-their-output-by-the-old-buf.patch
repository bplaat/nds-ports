From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Thu, 1 Oct 2026 08:56:02 +0200
Subject: [PATCH] Fix itoa and ltoa sizing their output by the old buffer
 contents

They printed at most as many characters as the string in the buffer had
before, which is uninitialized for the status bar numbers (LatchNumber)
and the printed signed numbers, so those showed garbage or nothing at
all depending on what the stack held. Like the real ones they now print
the whole number.
---
 wl_def.h | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/wl_def.h b/wl_def.h
index a45a551..538c811 100644
--- a/wl_def.h
+++ b/wl_def.h
@@ -1488,18 +1488,14 @@ void GP2X_ButtonUp (int button);
 #ifndef _WIN32
     static inline char *itoa (int value, char *string, int radix)
     {
-        int len = strlen(string) + 1;
-
-	    snprintf (string,len,"%d",value);
+	    sprintf (string,"%d",value);
 
 	    return string;
     }
 
     static inline char *ltoa (long value, char *string, int radix)
     {
-        int len = strlen(string) + 1;
-
-	    snprintf (string,len,"%ld",value);
+	    sprintf (string,"%ld",value);
 
 	    return string;
     }
