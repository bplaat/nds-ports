From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Tue, 6 Oct 2026 12:00:00 +0200
Subject: [PATCH] Use single precision and reduce floating point work

Use float math for trig, projection and OPL tables. Share the direction
conversion and multiply by a constant instead of dividing for each aim.
---

diff --git a/wl_def.h b/wl_def.h
--- a/wl_def.h
+++ b/wl_def.h
@@ -183,7 +183,7 @@
 
 #define RUNSPEED        6000
 
-#define HEIGHTRATIO     0.50
+#define HEIGHTRATIO     0.50f
 
 // The DS top screen shows the view at 1:1 in the top left corner of the
 // screen buffer, menus and pictures are shown scaled
@@ -206,7 +206,7 @@
                                         // to any actor center
 
 #undef M_PI
-#define PI              3.141592657
+#define PI              3.141592657f
 #define M_PI PI
 
 #define GLOBAL1         (1l<<16)
diff --git a/wl_main.c b/wl_main.c
--- a/wl_main.c
+++ b/wl_main.c
@@ -719,7 +719,7 @@
     int i;
     for(i=0;i<FINEANGLES/8;i++)
     {
-        double tang=tan((i+0.5)/radtoint);
+        float tang=tanf((i+0.5f)/radtoint);
         finetangent[i]=(int32_t)(tang*GLOBAL1);
         finetangent[FINEANGLES/4-1-i]=(int32_t)((1/tang)*GLOBAL1);
     }
@@ -733,7 +733,7 @@
     float anglestep=(float)(PI/2/ANGLEQUAD);
     for(i=0; i<ANGLEQUAD; i++)
     {
-        fixed value=(int32_t)(GLOBAL1*sin(angle));
+        fixed value=(int32_t)(GLOBAL1*sinf(angle));
         sintable[i]=sintable[i+ANGLES]=sintable[ANGLES/2-i]=value;
         sintable[ANGLES-i]=sintable[ANGLES/2+i]=-value;
         angle+=anglestep;
@@ -764,9 +764,9 @@
     int     i;
     int    intang;
     float   angle;
-    double  tang;
+    float   tang;
     int     halfview;
-    double  facedist;
+    float   facedist;
 
     focallength = focal;
     facedist = focal+MINDIST;
@@ -792,7 +792,7 @@
     {
         // start 1/2 pixel over, so viewangle bisects two middle pixels
         tang = (int32_t)i*VIEWGLOBAL/viewwidth/facedist;
-        angle = (float) atan(tang);
+        angle = atanf(tang);
         intang = (int) (angle*radtoint);
         pixelangle[halfview-1-i] = intang;
         pixelangle[halfview+i] = -intang;
diff --git a/nds/opl.c b/nds/opl.c
--- a/nds/opl.c
+++ b/nds/opl.c
@@ -112,7 +112,7 @@
 
     for (i = 0; i < SIN_LEN; ++i)
     {
-        s16 s = (s16) lrint (sin ((i * 2 + 1) * M_PI / SIN_LEN) * 4095);
+        s16 s = (s16) lrintf (sinf ((i * 2 + 1) * (float) M_PI / SIN_LEN) * 4095);
         int quarter = i / (SIN_LEN / 4);
 
         sin_tab[0][i] = s;
@@ -121,7 +121,7 @@
         sin_tab[3][i] = quarter & 1 ? 0 : sin_tab[2][i];
     }
     for (w = 0; w < 32; ++w)
-        att_volume[w] = (u16) lrint (2047 * pow (2.0, -w / 32.0));
+        att_volume[w] = (u16) lrintf (2047 * powf (2.0f, -w / 32.0f));
 
     // The first 16 rates are infinite, rates 0-12 step every 2^(12-n)
     // samples and 13-15 every sample, with the increments of the MAME
@@ -129,7 +129,7 @@
     for (i = 0; i < 96; ++i)
     {
         int rate = (i - 16) / 4, sel, shift = 0;
-        double avg = 0, updates;
+        float avg = 0, updates;
 
         if (i < 16)
             sel = 14;
@@ -140,12 +140,12 @@
         }
         else
             sel = rate < 15 ? 4 + (rate - 13) * 4 + ((i - 16) & 3) : 12;
-        updates = (double) EG_QUANTUM / (1 << shift);
+        updates = (float) EG_QUANTUM / (1 << shift);
 
         for (w = 0; w < 8; ++w)
-            avg += eg_inc[sel][w] / 8.0;
+            avg += eg_inc[sel][w] / 8.0f;
         rate_inc[i] = (s32) (avg * updates * 65536);
-        rate_att[i] = (u32) (pow (1.0 - avg / 8.0, updates) * 65536);
+        rate_att[i] = (u32) (powf (1.0f - avg / 8.0f, updates) * 65536);
     }
 }
 
