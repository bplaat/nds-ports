 void     *safe_malloc (size_t size, const char *fname, uint32_t line);
 fixed    FixedMul (fixed a, fixed b);
 fixed    FixedDiv (fixed a, fixed b);
+int      VectorAngle (int32_t y, int32_t x);
 
 uint16_t ReadShort (void *ptr);
 uint32_t ReadLong (void *ptr);
diff --git a/wl_utils.c b/wl_utils.c
--- a/wl_utils.c
+++ b/wl_utils.c
@@ -38,6 +38,18 @@
 	return div64((int64_t)a << FRACBITS, b);
 }
 
+// Convert a direction to the game's integer angles without double math.
+int VectorAngle (int32_t y, int32_t x)
+{
+    float angle = atan2f ((float) y, (float) x);
+    int result;
+
+    if (angle < 0)
+        angle += 2.0f * PI;
+    result = (int) (angle * (ANGLES / (2.0f * PI)));
+    return result == ANGLES ? 0 : result;
+}
+
 uint16_t ReadShort (void *ptr)
 {
     unsigned value;
