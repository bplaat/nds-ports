From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Sun, 4 Oct 2026 12:18:33 +0200
Subject: [PATCH] Draw the walls through a strip in DTCM

Writing the posts down the columns of the frame misses the data cache
with every pixel, which is slow in DS main RAM. ScalePost writes them
into a strip of 8 columns in DTCM instead, with their ceiling and floor,
so the screen isn't cleared first, and copies the strip into the frame
in words once it is full. The texture steps in 16.16 fixed point through
a copy of its column in DTCM, four pixels per loop, as a branch costs
the ARM9 three cycles. Posts taller than the view are clipped at once.
---
 wl_draw.c | 123 ++++++++++++++++++++++++++++++++----------------------
 1 file changed, 72 insertions(+), 51 deletions(-)

diff --git a/wl_draw.c b/wl_draw.c
index f0cbe74..ba89a0b 100644
--- a/wl_draw.c
+++ b/wl_draw.c
@@ -296,10 +296,53 @@ int16_t CalcHeight (void)
 ===================
 */
 
+//
+// Writing posts down the columns of the frame misses the data cache with
+// every pixel, which is slow in DS main RAM. The posts go into a strip of
+// WALLSTRIP columns instead, with their ceiling and floor, that stays in
+// DTCM and is copied into the frame in words once it is full.
+//
+#define WALLSTRIP 8
+
+extern byte vgaCeiling[];
+
+static byte wallstrip[WALLSTRIP * TOPSCREENHEIGHT] __attribute__((section(".sbss"), aligned(32)));
+
+static void FlushWallStrip (void)
+{
+    uint32_t *src = (uint32_t *) wallstrip;
+    byte *dest = vbuf + (postx & ~(WALLSTRIP - 1));
+    int y;
+
+    for (y = 0; y < viewheight; y++, src += WALLSTRIP / 4, dest += bufferPitch)
+    {
+        ((uint32_t *) dest)[0] = src[0];
+        ((uint32_t *) dest)[1] = src[1];
+    }
+}
+
+// Fills a column of the strip, four pixels per loop
+static byte *FillPost (byte *post, int n, byte color)
+{
+    for (; n >= 4; n -= 4, post += 4 * WALLSTRIP)
+    {
+        post[0] = color;
+        post[WALLSTRIP] = color;
+        post[2 * WALLSTRIP] = color;
+        post[3 * WALLSTRIP] = color;
+    }
+    for (; n > 0; n--, post += WALLSTRIP)
+        *post = color;
+    return post;
+}
+
 void ScalePost (void)
 {
-    int ywcount, yoffs, yw, yd, yendoffs;
-    byte col;
+    byte *post = wallstrip + (postx & (WALLSTRIP - 1));
+    byte ceiling = vgaCeiling[gamestate.episode*10+gamestate.mapon];
+    int height = wallheight[postx] >> 3;            // half the height in pixels
+    int top = centery - height;
+    int y1 = MAX(top, 0), y2 = MIN(centery + height, viewheight);
 
 #ifdef USE_SKYWALLPARALLAX
     if (tilehit == 16)
@@ -309,59 +352,38 @@ void ScalePost (void)
     }
 #endif
 
-#ifdef USE_SHADING
-    byte *curshades = shadetable[GetShade(wallheight[postx])];
-#endif
-
-    ywcount = yd = wallheight[postx] >> 3;
-    if(yd <= 0) yd = 100;
-
-    yoffs = (centery - ywcount) * bufferPitch;
-    if(yoffs < 0) yoffs = 0;
-    yoffs += postx;
-
-    yendoffs = centery + ywcount - 1;
-    yw=TEXTURESIZE-1;
-
-    while(yendoffs >= viewheight)
+    if (height <= 0)
+        y1 = y2 = centery;
+    post = FillPost (post, y1, ceiling);
+    if (y1 < y2)
     {
-        ywcount -= TEXTURESIZE/2;
-        while(ywcount <= 0)
+        // The texture steps in 16.16 fixed point, from the top of the wall,
+        // through a copy of its column in DTCM
+        static byte column[TEXTURESIZE] __attribute__((section(".sbss"), aligned(4)));
+        const byte *src = memcpy(column, postsource, TEXTURESIZE);
+        fixed step = div32((TEXTURESIZE/2) << FRACBITS, height);
+        fixed frac = (y1 - top) * step;
+        int n = y2 - y1;
+
+        // Four pixels per loop, a branch costs the ARM9 three cycles
+        for (; n >= 4; n -= 4, post += 4 * WALLSTRIP)
         {
-            ywcount += yd;
-            yw--;
+            post[0] = src[frac >> FRACBITS];
+            frac += step;
+            post[WALLSTRIP] = src[frac >> FRACBITS];
+            frac += step;
+            post[2 * WALLSTRIP] = src[frac >> FRACBITS];
+            frac += step;
+            post[3 * WALLSTRIP] = src[frac >> FRACBITS];
+            frac += step;
         }
-        yendoffs--;
+        for (; n > 0; n--, post += WALLSTRIP, frac += step)
+            *post = src[frac >> FRACBITS];
     }
-    if(yw < 0) return;
+    FillPost (post, viewheight - y2, 0x19);
 
-#ifdef USE_SHADING
-    col = curshades[postsource[yw]];
-#else
-    col = postsource[yw];
-#endif
-    yendoffs = yendoffs * bufferPitch + postx;
-    while(yoffs <= yendoffs)
-    {
-        vbuf[yendoffs] = col;
-        ywcount -= TEXTURESIZE/2;
-        if(ywcount <= 0)
-        {
-            do
-            {
-                ywcount += yd;
-                yw--;
-            }
-            while(ywcount <= 0);
-            if(yw < 0) break;
-#ifdef USE_SHADING
-            col = curshades[postsource[yw]];
-#else
-            col = postsource[yw];
-#endif
-        }
-        yendoffs -= bufferPitch;
-    }
+    if ((postx & (WALLSTRIP - 1)) == WALLSTRIP - 1)
+        FlushWallStrip ();
 }
 
 #ifdef USE_SKYWALLPARALLAX
@@ -1487,7 +1509,6 @@ void ThreeDRefresh (void)
 //
 // follow the walls from there to the right, drawing as we go
 //
-    VGAClearScreen ();
 #if defined(USE_FEATUREFLAGS) && defined(USE_STARSKY)
     if(GetFeatureFlags() & FF_STARSKY)
         DrawStarSky();
