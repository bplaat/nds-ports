+
+int SDL_JoystickNumButtons (SDL_Joystick *joystick)
+{
+    return sizeof(joy_buttons) / sizeof(joy_buttons[0]);
+}
+
+int SDL_JoystickNumHats (SDL_Joystick *joystick)
+{
+    return 1;
+}
+
+Sint16 SDL_JoystickGetAxis (SDL_Joystick *joystick, int axis)
+{
+    u32 neg = axis == 0 ? KEY_LEFT : KEY_UP, pos = axis == 0 ? KEY_RIGHT : KEY_DOWN;
+
+    return keys_held & neg ? -32768 : keys_held & pos ? 32767 : 0;
+}
+
+Uint8 SDL_JoystickGetHat (SDL_Joystick *joystick, int hat)
+{
+    return (keys_held & KEY_UP ? SDL_HAT_UP : 0) | (keys_held & KEY_RIGHT ? SDL_HAT_RIGHT : 0)
+        | (keys_held & KEY_DOWN ? SDL_HAT_DOWN : 0) | (keys_held & KEY_LEFT ? SDL_HAT_LEFT : 0);
+}
+
+Uint8 SDL_JoystickGetButton (SDL_Joystick *joystick, int button)
+{
+    return button >= 0 && button < SDL_JoystickNumButtons (joystick) && (keys_held & joy_buttons[button]);
+}
+
+// ---------------------------------------------------------------------------
+// Audio
+// ---------------------------------------------------------------------------
+
+// An exact multiple of the 700 Hz music tick (and the 140 Hz PC speaker)
+#define STREAM_RATE     14000
+#define STREAM_FRAMES   4096            // a power of two
+#define STREAM_AHEAD    (STREAM_RATE / 30)
+#define STREAM_CHUNK    256
+#define AUDIO_HZ        700             // the music tick
+
+typedef void (*mix_func_t)(void *udata, Uint8 *stream, int len);
+
+typedef struct
+{
+    u64 start, end;     // in ticks, end is 0 when stopped
+    unsigned volume, pan;
+} mix_channel_t;
+
+static s16 stream_buffer[STREAM_FRAMES] __attribute__((aligned(32)));
+static unsigned stream_timer;
+static u64 stream_start, stream_written;
+static mix_func_t music_hook, post_mix;
+static void *music_arg, *post_mix_arg;
+
+static mix_channel_t mix_channels[MIX_CHANNELS];
+static int group_from, group_to = MIX_CHANNELS - 1;
+static void (*channel_finished)(int channel);
+
+static Thread audio_thread;
+static u8 audio_stack[8192] __attribute__((aligned(8)));
+
+// Mixes the stream up to a little ahead of the play position
+static void FillStream (void)
+{
+    // Ticks run at SYSTEM_CLOCK / 64, a sample lasts stream_timer SYSTEM_CLOCK / 2 cycles
+    u64 played = (tickGetCount () - stream_start) * 32 / stream_timer;
+    s16 mix[STREAM_CHUNK * 2];
+
+    if (stream_written < played)
+        stream_written = played;
+    while (stream_written < played + STREAM_AHEAD)
+    {
+        unsigned pos = stream_written & (STREAM_FRAMES - 1), i;
+        unsigned frames = STREAM_FRAMES - pos;
+
+        if (frames > STREAM_CHUNK)
+            frames = STREAM_CHUNK;
+        if (frames > played + STREAM_AHEAD - stream_written)
+            frames = played + STREAM_AHEAD - stream_written;
+
+        memset (mix, 0, frames * 4);
+        if (music_hook != NULL)
+            music_hook (music_arg, (Uint8 *) mix, frames * 4);
+        if (post_mix != NULL)
+            post_mix (post_mix_arg, (Uint8 *) mix, frames * 4);
+        // Both channels are the same, the OPL2 and the PC speaker are mono
+        for (i = 0; i < frames; ++i)
+            stream_buffer[pos + i] = mix[i * 2];
+        DC_FlushRange (stream_buffer + pos, frames * 2);
+        stream_written += frames;
+    }
+}
+
+static void CheckFinishedChannels (void)
+{
+    u64 now = tickGetCount ();
+    int i;
+
+    for (i = 0; i < MIX_CHANNELS; ++i)
+    {
+        if (mix_channels[i].end == 0 || now < mix_channels[i].end)
+            continue;
+        mix_channels[i].end = 0;
+        if (channel_finished != NULL)
+            channel_finished (i);
+    }
+}
+
+static int AudioThreadMain (void *arg)
+{
+    TickTask task;
+
+    threadTimerStart (&task, AUDIO_HZ);
+    for (;;)
+    {
+        threadTimerWait (&task);
+        FillStream ();
+        CheckFinishedChannels ();
+    }
+    return 0;
+}
+
+int Mix_OpenAudioDevice (int frequency, Uint16 format, int channels, int chunksize, const char *device, int allowed_changes)
+{
+    int i;
+
+    for (i = 0; i < MIX_CHANNELS; ++i)
+        Mix_SetPanning (i, 255, 255);
+    soundInit ();
+    soundPowerOn ();
+    soundSetMixerVolume (127);
+
+    // Primed with silence, the thread keeps it ahead of the play position
+    memset (stream_buffer, 0, sizeof(stream_buffer));
+    DC_FlushRange (stream_buffer, sizeof(stream_buffer));
+    stream_timer = soundTimerFromHz (STREAM_RATE);
+    soundPreparePcm (NDS_STREAM_CHANNEL | SOUND_START, 127 << 4, 64, stream_timer, SoundMode_Repeat, SoundFmt_Pcm16,
+        stream_buffer, 0, sizeof(stream_buffer) / 4);
+    stream_start = tickGetCount ();
+    stream_written = 0;
+
+    threadPrepare (&audio_thread, AudioThreadMain, NULL, audio_stack + sizeof(audio_stack), MAIN_THREAD_PRIO - 1);
+    threadAttachLocalStorage (&audio_thread, NULL);
+    threadStart (&audio_thread);
+    return 0;
+}
+
+int Mix_QuerySpec (int *frequency, Uint16 *format, int *channels)
+{
+    if (frequency != NULL)
+        *frequency = STREAM_RATE;
+    if (format != NULL)
+        *format = AUDIO_S16;
+    if (channels != NULL)
+        *channels = 2;
+    return 1;
+}
+
+const char *Mix_GetError (void)
+{
+    return SDL_GetError ();
+}
+
+Mix_Chunk *Mix_QuickLoad_RAW (Uint8 *mem, Uint32 len)
+{
+    Mix_Chunk *chunk = malloc (sizeof(*chunk));
+    Uint32 i;
+
+    if (chunk == NULL)
+        return NULL;
+    for (i = 0; i < len; ++i)
+        mem[i] ^= 0x80;
+    DC_FlushRange (mem, len);
+    chunk->abuf = mem;
+    chunk->alen = len;
+    return chunk;
+}
+
+void Mix_FreeChunk (Mix_Chunk *chunk)
+{
+    free (chunk);
+}
+
+int Mix_ReserveChannels (int num)
+{
+    return num;
+}
+
+int Mix_GroupChannels (int from, int to, int tag)
+{
+    group_from = from;
+    group_to = to;
+    return to - from + 1;
+}
+
+int Mix_GroupAvailable (int tag)
+{
+    int i;
+
+    for (i = group_from; i <= group_to; ++i)
+        if (mix_channels[i].end == 0)
+            return i;
+    return -1;
+}
+
+int Mix_GroupOldest (int tag)
+{
+    int i, oldest = -1;
+
+    for (i = group_from; i <= group_to; ++i)
+        if (mix_channels[i].end != 0 && (oldest < 0 || mix_channels[i].start < mix_channels[oldest].start))
+            oldest = i;
+    return oldest;
+}
+
+int Mix_PlayChannel (int channel, Mix_Chunk *chunk, int loops)
+{
+    mix_channel_t *ch;
+    // The hardware plays whole words from a word aligned address
+    uintptr_t start = (uintptr_t) chunk->abuf & ~3;
+    Uint32 words = ((uintptr_t) chunk->abuf + chunk->alen - start + 3) / 4;
+
+    if (channel < 0 || channel >= MIX_CHANNELS)
+        return -1;
+    ch = &mix_channels[channel];
+    ch->start = tickGetCount ();
+    ch->end = ch->start + (u64) chunk->alen * TICK_FREQ / MIX_NDS_CHUNK_RATE + 1;
+    soundPreparePcm (channel | SOUND_START, ch->volume, ch->pan, soundTimerFromHz (MIX_NDS_CHUNK_RATE),
+        SoundMode_OneShot, SoundFmt_Pcm8, (const void *) start, 0, words);
+    return channel;
+}
+
+int Mix_HaltChannel (int channel)
+{
+    int i;
+
+    for (i = 0; i < MIX_CHANNELS; ++i)
+    {
+        if ((channel >= 0 && i != channel) || mix_channels[i].end == 0)
+            continue;
+        soundStop (BIT (i));
+        mix_channels[i].end = 0;
+        if (channel_finished != NULL)
+            channel_finished (i);
+    }
+    return 0;
+}
+
+// SDL_mixer plays both sides at full volume in the center, the DS halves
+// them, so the stream is centered too to keep the balance
+int Mix_SetPanning (int channel, Uint8 left, Uint8 right)
+{
+    mix_channel_t *ch;
+
+    if (channel < 0 || channel >= MIX_CHANNELS)
+        return 0;
+    ch = &mix_channels[channel];
+    ch->volume = (left + right) * 2047 / 510;
+    ch->pan = left + right > 0 ? right * 127 / (left + right) : 64;
+    if (ch->end != 0)
+    {
+        soundChSetVolume (channel, ch->volume);
+        soundChSetPan (channel, ch->pan);
+    }
+    return 1;
+}
+
+void Mix_ChannelFinished (void (*func)(int channel))
+{
+    channel_finished = func;
+}
+
+void Mix_HookMusic (void (*mix_func)(void *udata, Uint8 *stream, int len), void *arg)
+{
+    music_hook = mix_func;
+    music_arg = arg;
+}
+
+void Mix_SetPostMix (void (*mix_func)(void *udata, Uint8 *stream, int len), void *arg)
+{
+    post_mix = mix_func;
+    post_mix_arg = arg;
+}
diff --git a/nds/wl_nds.c b/nds/wl_nds.c
new file mode 100644
index 0000000..99d1481
--- /dev/null
+++ b/nds/wl_nds.c
@@ -0,0 +1,188 @@
+//
+// Nintendo DS user interface for Wolf4SDL
+//
+// - Startup: finds the game data in the data folder on the SD card, next to
+//   the .nds or embedded in the ROM (NitroFS), the full game before the
+//   shareware, and keeps the config and savegames in /data/wolf3d/
+// - Errors are shown on the touch screen console
+// - Dragging the stylus turns the player like a mouse
+//
+
+// libnds and Wolf4SDL both have a Keyboard and a SoundMode
+#define Keyboard NDS_Keyboard
+#define SoundMode NDS_SoundMode
+#include <nds.h>
+#undef Keyboard
+#undef SoundMode
+#include <fat.h>
+#include <filesystem.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// Wolf4SDL has its own bool
+#undef bool
+#undef true
+#undef false
+#include "wl_def.h"
+#include "wl_nds.h"
+
+// Config, savegames and game data live in the usual homebrew data folder
+#define DATA_DIR "data/wolf3d"
+#define MAX_ARGS 32
+
+static PrintConsole console;
+
+static void ConsoleMode (void)
+{
+    videoSetModeSub (MODE_0_2D);
+    vramSetBankC (VRAM_C_SUB_BG);
+    consoleInit (&console, 0, BgType_Text4bpp, BgSize_T_256x256, 31, 0, false, true);
+    consoleSelect (&console);
+}
+
+static void WaitForStart (void)
+{
+    do
+    {
+        threadWaitForVBlank ();
+        scanKeys ();
+    } while (!(keysDown () & KEY_START));
+}
+
+void NDS_ShowMessage (const char *title, const char *message)
+{
+    ConsoleMode ();
+    consoleClear ();
+    printf ("\x1b[31;1m%s\x1b[39;0m\n\n%s\n\n\x1b[30;1mPress START to exit\x1b[39;0m\n", title, message);
+    WaitForStart ();
+}
+
+static bool FileExists (const char *path)
+{
+    struct stat st;
+    return stat (path, &st) == 0 && S_ISREG (st.st_mode);
+}
+
+// Splits a file into arguments
+static void ReadArgs (const char *path, int *argc, char **argv)
+{
+    static char buf[512];
+    FILE *f = fopen (path, "r");
+    size_t len;
+    char *s;
+
+    if (f == NULL)
+        return;
+    len = fread (buf, 1, sizeof(buf) - 1, f);
+    fclose (f);
+    buf[len] = '\0';
+    for (s = strtok (buf, " \t\r\n"); s != NULL && *argc < MAX_ARGS - 1; s = strtok (NULL, " \t\r\n"))
+        argv[(*argc)++] = s;
+}
+
+void NDS_Init (int *argc, char ***argv)
+{
+    static const char *extensions[] = { "wl6", "wl3", "wl1" };
+    static char *args[MAX_ARGS];
+    static char dirs[4][256], datadir[256];
+    int num_dirs = 0, i, j, n = 0;
+
+    ConsoleMode ();
+    printf ("\n  \x1b[31;1mWolfenstein 3D\x1b[39;0m for Nintendo DS\n\n  Loading...\n");
+
+    // The data folder, the folder of the .nds and the root of the SD card,
+    // then the ROM, which also is the config folder without an SD card
+    if (fatInitDefault ())
+    {
+        char root[64], *slash;
+
+        getcwd (root, sizeof(root));
+        snprintf (datadir, sizeof(datadir), "%sdata", root);
+        mkdir (datadir, 0777);
+        snprintf (datadir, sizeof(datadir), "%s" DATA_DIR, root);
+        mkdir (datadir, 0777);
+        snprintf (dirs[num_dirs++], 256, "%s/", datadir);
+        if (*argc > 0 && (slash = strrchr ((*argv)[0], '/')) != NULL && slash - (*argv)[0] < 255)
+            snprintf (dirs[num_dirs++], 256, "%.*s", (int) (slash - (*argv)[0] + 1), (*argv)[0]);
+        strcpy (dirs[num_dirs++], root);
+    }
+    else
+        strcpy (datadir, "nitro:");
+    nitroFSInit (NULL);
+    strcpy (dirs[num_dirs++], "nitro:/");
+
+    // The full game first, it has the shareware episode too
+    for (i = 0; i < (int) lengthof(extensions); ++i)
+    {
+        for (j = 0; j < num_dirs; ++j)
+        {
+            char path[300];
+
+            snprintf (path, sizeof(path), "%svswap.%s", dirs[j], extensions[i]);
+            if (FileExists (path))
+            {
+                chdir (dirs[j]);
+                goto found;
+            }
+        }
+    }
+    NDS_ShowMessage ("No game data found!", "Copy the *.wl6 files of\nWolfenstein 3D to\n/" DATA_DIR "/ on the SD card,\nor embed them in the ROM at\nbuild time (see README).");
+    exit (1);
+
+found:
+    args[n++] = *argc > 0 ? (*argv)[0] : "wolf3d";
+    args[n++] = "--configdir";
+    args[n++] = datadir;
+    // Extra arguments (eg. --goobers or --tedlevel 3) from args.txt
+    {
+        char path[300];
+
+        snprintf (path, sizeof(path), "%s/args.txt", datadir);
+        ReadArgs (path, &n, args);
+    }
+    args[n] = NULL;
+    *argc = n;
+    *argv = args;
+}
+
+void NDS_UpdateSubScreen (void)
+{
+}
+
+// ---------------------------------------------------------------------------
+// Input
+// ---------------------------------------------------------------------------
+
+#define TOUCH_TURN_SCALE 10
+
+static bool touch_dragging;
+static int touch_last_x;
+
+void NDS_PollInput (uint32_t down, uint32_t held)
+{
+    touchPosition touch;
+
+    if (!(held & KEY_TOUCH))
+    {
+        touch_dragging = false;
+        return;
+    }
+    touchRead (&touch);
+    if (down & KEY_TOUCH)
+    {
+        touch_dragging = true;
+        touch_last_x = touch.px;
+        return;
+    }
+    if (touch_dragging)
+    {
+        int dx = touch.px - touch_last_x;
+
+        touch_last_x = touch.px;
+        if (dx > -48 && dx < 48)
+            NDS_MoveMouse (dx * TOUCH_TURN_SCALE, 0);
+    }
+}
diff --git a/nds/wl_nds.h b/nds/wl_nds.h
new file mode 100644
index 0000000..ff1ef80
--- /dev/null
+++ b/nds/wl_nds.h
@@ -0,0 +1,32 @@
+//
+// Nintendo DS platform glue between the SDL implementation (sdl_nds.c) and
+// the DS user interface (wl_nds.c)
+//
+
+#ifndef WL_NDS_H
