+    return 0;
+}
+
+Uint32 SDL_GetRelativeMouseState (int *x, int *y)
+{
+    PumpEvents ();
+    *x = mouse_dx;
+    *y = mouse_dy;
+    mouse_dx = mouse_dy = 0;
+    return 0;
+}
