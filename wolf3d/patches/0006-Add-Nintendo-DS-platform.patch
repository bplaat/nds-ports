--- /dev/null
+++ b/Makefile.nds
@@ -0,0 +1,77 @@
+#---------------------------------------------------------------------------------
+# Nintendo DS (devkitARM + libnds) build of Wolf4SDL
+#   make -f Makefile.nds [ICON=icon.bmp] [NITRO_DIR=dir]
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(DEVKITARM)),)
+$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
+endif
+
+GAME_TITLE     := Wolfenstein 3D
+GAME_SUBTITLE1 := id Software (1992)
+GAME_SUBTITLE2 := Wolf4SDL NDS port
+
+TARGET  := wolf3d
+BUILD   := build-nds
+OUTPUT  := $(CURDIR)/$(TARGET)
+
+ICON      ?=
+NITRO_DIR ?=
+GAME_ICON := $(or $(ICON),$(DEVKITPRO)/calico/share/nds-icon.bmp)
+ifneq ($(strip $(NITRO_DIR)),)
+NITRO_FILES := $(NITRO_DIR)
+endif
+
+# Must be set before ds_rules, which prepends the calico library path
+LIBPATHS := -L$(DEVKITPRO)/libnds/lib
+
+include $(DEVKITARM)/ds_rules
+
+SRC_WOLF := id_ca id_in id_pm id_sd id_us id_vh id_vl signon wl_act1 wl_act2 wl_agent wl_atmos \
+	wl_cloudsky wl_debug wl_game wl_inter wl_main wl_menu wl_parallax wl_plane wl_play wl_shade \
+	wl_state wl_text nds/opl_nds nds/sdl_nds nds/wl_nds
+
+# Hot code (the ray caster, the scaler and the fixed point math) runs from ITCM
+SRC_ITCM := wl_draw wl_scale wl_utils
+
+OFILES := $(addprefix $(BUILD)/,$(addsuffix .o,$(SRC_WOLF)) $(addsuffix .itcm.o,$(SRC_ITCM)))
+
+ARCH     := -march=armv5te -mtune=arm946e-s -mthumb
+# Savegames hold structs with enums, int sized like on the PC instead of only
+# as big as their values like the ARM EABI default. Libraries only get enums
+# as arguments. The Apogee v1.4 layout also runs the shareware and GT data.
+CFLAGS   := -g -O2 -Wall -Wno-unused -Wno-pointer-sign -Wno-format-truncation -Wno-misleading-indentation \
+	-Wno-dangling-else -Wno-parentheses -Wno-char-subscripts -Wno-maybe-uninitialized -Wno-format \
+	-Wno-missing-braces \
+	-ffunction-sections -fdata-sections -fno-strict-aliasing -fno-short-enums -std=gnu99 \
+	$(ARCH) -DARM9 -DVERSIONALREADYCHOSEN -DCARMACIZED \
+	-Inds -I. -I$(LIBNDS)/include -I$(CALICO)/include
+LDFLAGS  := -specs=ds_arm9.specs -g $(ARCH) -Wl,--no-enum-size-warning -Wl,-Map,$(BUILD)/$(TARGET).map
+LIBS     := -lfilesystem -lfat -lnds9 -lm
+LD       := $(CC)
+
+.PHONY: all clean
+all: $(OUTPUT).nds
+
+# Like the ds_rules default, plus a proper header title (homebrew game code kept)
+$(OUTPUT).nds: $(OUTPUT).elf $(GAME_ICON) $(wildcard $(NITRO_DIR)/*)
+	$(SILENTCMD)ndstool -c $@ -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1);$(GAME_SUBTITLE2)" \
+		-g "####" 00 "WOLF3D" $(_ADDFILES)
+	$(SILENTMSG) built ... $(notdir $@)
+
+$(OUTPUT).elf: $(OFILES)
+
+$(BUILD)/%.itcm.o: CFLAGS += -marm -mlong-calls
+$(BUILD)/%.itcm.o: %.c
+	$(SILENTMSG) $(notdir $<)
+	@mkdir -p $(dir $@)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+$(BUILD)/%.o: %.c
+	$(SILENTMSG) $(notdir $<)
+	@mkdir -p $(dir $@)
+	$(SILENTCMD)$(CC) -MMD -MP $(_EXTRADEFS) $(CFLAGS) -c $< -o $@
+
+clean:
+	rm -rf $(BUILD) $(OUTPUT).elf $(OUTPUT).nds
+
+-include $(OFILES:.o=.d)
