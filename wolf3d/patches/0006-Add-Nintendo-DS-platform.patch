@@ -0,0 +1,771 @@
+//
+// The subset of SDL 2 and SDL_mixer that Wolf4SDL uses, on the Nintendo DS
+//
+// - Video: surfaces are 8-bit, the window shows the screen surface. Each
+//   presented frame is copied by DMA into one of two 8bpp bitmap backgrounds
+//   in VRAM banks A/B, page flipped on vblank and scaled from 320x200 to
+//   256x192 by the affine background hardware. Surfaces have the pitch of
+//   the backgrounds, so that is a single copy. A second affine background
+//   samples the frame half a pixel further and is alpha blended on top,
+//   which gives a cheap hardware bilinear-like filter. The palette of the
+//   screen surface is the hardware palette, so fades cost nothing.
+// - Input: START is the escape key, the other buttons are joystick 0 with
+//   the d-pad as its axes and the stylus is a mouse (see wl_nds.c).
+// - Audio: chunks play on hardware channels 0-5, which do the resampling,
+//   volume and panning. A 700 Hz thread fills a mono ring buffer that loops
+//   on hardware channel 6 with the music hook and the post mix: the music
+//   and AdLib sound sequencer, which plays the OPL2 on the other hardware
+//   channels (opl_nds.c), and the PC speaker.
+//
+
+#include <nds.h>
+#include <malloc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "SDL.h"
+#include "SDL_mixer.h"
+#include "wl_nds.h"
+
+// The surface the window shows, from id_vl.c
+extern SDL_Surface *screen;
+
+static TickTask tick_task;
+
+static void TickNoop (TickTask *task)
+{
+}
+
+int SDL_Init (Uint32 flags)
+{
+    // The tick counter only runs while a tick task is scheduled
+    tickTaskStart (&tick_task, TickNoop, ticksFromHz (1), ticksFromHz (1));
+    return 0;
+}
+
+void SDL_Quit (void)
+{
+}
+
+const char *SDL_GetError (void)
+{
+    return "unsupported on the Nintendo DS";
+}
+
+void SDL_SetHint (const char *name, const char *value)
+{
+}
+
+Uint32 SDL_GetTicks (void)
+{
+    return (Uint32) (tickGetCount () * 1000 / TICK_FREQ);
+}
+
+void SDL_Delay (Uint32 ms)
+{
+    threadSleep (ms * 1000);
+}
+
+// ---------------------------------------------------------------------------
+// Video
+// ---------------------------------------------------------------------------
+
+#define FB_STRIDE   512
+#define FB_PAGE(n)  ((u8 *) BG_BMP_RAM ((n) * 8))
+#define FB_DMA      2
+
+static u16 hw_palette[256] __attribute__((aligned(4)));
+static volatile bool palette_dirty;
+static volatile int shown_page, pending_page = -1;
+static int frame_w = 320, frame_h = 200;
+
+static void VBlankHandler (void)
+{
+    // A CPU copy, DMA would miss palette writes still in the data cache
+    if (palette_dirty)
+    {
+        memcpy (BG_PALETTE, hw_palette, sizeof(hw_palette));
+        palette_dirty = false;
+    }
+    // Only once the frame is completely copied
+    if (pending_page >= 0 && !dmaBusy (FB_DMA))
+    {
+        u16 base = BG_MAP_BASE (pending_page * 8);
+        REG_BG2CNT = (REG_BG2CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+        REG_BG3CNT = (REG_BG3CNT & ~(31 << MAP_BASE_SHIFT)) | base;
+        shown_page = pending_page;
+        pending_page = -1;
+    }
+}
+
+static void InitVideo (void)
+{
+    // Scale factors in 8.8 fixed point
+    int dx = (frame_w << 8) / SCREEN_WIDTH, dy = (frame_h << 8) / SCREEN_HEIGHT;
+    int bg;
+
+    videoSetMode (MODE_5_2D);
+    vramSetBankA (VRAM_A_MAIN_BG_0x06000000);
+    vramSetBankB (VRAM_B_MAIN_BG_0x06020000);
+    memset (BG_GFX, 0, 2 * FB_STRIDE * 256);
+
+    for (bg = 2; bg <= 3; ++bg)
+    {
+        int id = bgInit (bg, BgType_Bmp8, BgSize_B8_512x256, 0, 0);
+        bgSetPriority (id, bg == 2 ? 0 : 1);
+        bgSetScale (id, dx, dy);
+        // The blend layer samples half an output pixel further
+        if (bg == 2)
+            bgSetScrollf (id, dx / 2, dy / 2);
+    }
+    bgUpdate ();
+    REG_BLDCNT = BLEND_ALPHA | BLEND_SRC_BG2 | BLEND_DST_BG3;
+    REG_BLDALPHA = 8 | (8 << 8);
+
+    irqSet (IRQ_VBLANK, VBlankHandler);
+    irqEnable (IRQ_VBLANK);
+}
+
+struct SDL_Window { int unused; };
+struct SDL_Renderer { int unused; };
+struct SDL_Texture { int unused; };
+
+static SDL_Window the_window;
+static SDL_Renderer the_renderer;
+static SDL_Texture the_texture;
+
+SDL_Window *SDL_CreateWindow (const char *title, int x, int y, int w, int h, Uint32 flags)
+{
+    frame_w = w;
+    frame_h = h;
+    InitVideo ();
+    return &the_window;
+}
+
+void SDL_DestroyWindow (SDL_Window *window)
+{
+    irqClear (IRQ_VBLANK);
+}
+
+SDL_Renderer *SDL_CreateRenderer (SDL_Window *window, int index, Uint32 flags)
+{
+    return &the_renderer;
+}
+
+void SDL_DestroyRenderer (SDL_Renderer *renderer)
+{
+}
+
+int SDL_SetRenderDrawBlendMode (SDL_Renderer *renderer, int mode)
+{
+    return 0;
+}
+
+SDL_Texture *SDL_CreateTexture (SDL_Renderer *renderer, Uint32 format, int access, int w, int h)
+{
+    return &the_texture;
+}
+
+void SDL_DestroyTexture (SDL_Texture *texture)
+{
+}
+
+// Copies the frame (a surface, so with the pitch of the backgrounds) into
+// the back page, which is shown on the vblank after the copy
+int SDL_UpdateTexture (SDL_Texture *texture, const SDL_Rect *rect, const void *pixels, int pitch)
+{
+    // Wait until the last flip happened, the back page is then free
+    while (pending_page >= 0)
+        threadWaitForVBlank ();
+
+    // The whole 4 KiB cache is quicker to flush than the frame
+    DC_FlushAll ();
+    dmaCopyWordsAsynch (FB_DMA, pixels, FB_PAGE (shown_page ^ 1), FB_STRIDE * frame_h);
+    return 0;
+}
+
+int SDL_RenderCopy (SDL_Renderer *renderer, SDL_Texture *texture, const SDL_Rect *src, const SDL_Rect *dst)
+{
+    return 0;
+}
+
+void SDL_RenderPresent (SDL_Renderer *renderer)
+{
+    pending_page = shown_page ^ 1;
+    NDS_UpdateSubScreen ();
+}
+
+int SDL_ShowCursor (int toggle)
+{
+    return 0;
+}
+
+SDL_bool SDL_PixelFormatEnumToMasks (Uint32 format, int *bpp, Uint32 *r, Uint32 *g, Uint32 *b, Uint32 *a)
+{
+    *bpp = 8;
+    *r = *g = *b = *a = 0;
+    return SDL_TRUE;
+}
+
+SDL_Surface *SDL_CreateRGBSurface (Uint32 flags, int w, int h, int depth, Uint32 r, Uint32 g, Uint32 b, Uint32 a)
+{
+    struct
+    {
+        SDL_Surface surface;
+        SDL_PixelFormat format;
+        SDL_Palette palette;
+        SDL_Color colors[256];
+    } *s;
+
+    // Surfaces are frames, with the pitch of the backgrounds
+    const int pitch = FB_STRIDE;
+
+    if (depth != 8 || w > FB_STRIDE || h > 256 || (s = calloc (1, sizeof(*s))) == NULL)
+        return NULL;
+    s->surface.pixels = memalign (32, pitch * h);
+    if (s->surface.pixels == NULL)
+    {
+        free (s);
+        return NULL;
+    }
+    memset (s->surface.pixels, 0, pitch * h);
+    s->surface.format = &s->format;
+    s->surface.w = w;
+    s->surface.h = h;
+    s->surface.pitch = pitch;
+    s->format.palette = &s->palette;
+    s->format.BitsPerPixel = 8;
+    s->format.BytesPerPixel = 1;
+    s->palette.ncolors = 256;
+    s->palette.colors = s->colors;
+    return &s->surface;
+}
+
+void SDL_FreeSurface (SDL_Surface *surface)
+{
+    if (surface == NULL)
+        return;
+    free (surface->pixels);
+    free (surface);
+}
+
+int SDL_SetPaletteColors (SDL_Palette *palette, const SDL_Color *colors, int first, int ncolors)
+{
+    int i;
+
+    memcpy (palette->colors + first, colors, ncolors * sizeof(*colors));
+    if (screen == NULL || palette != screen->format->palette)
+        return 0;
+    for (i = first; i < first + ncolors; ++i)
+        hw_palette[i] = RGB15 (colors[i - first].r >> 3, colors[i - first].g >> 3, colors[i - first].b >> 3);
+    palette_dirty = true;
+    return 0;
+}
+
+// Only whole surfaces of the same size are blitted
+int SDL_BlitSurface (SDL_Surface *src, const SDL_Rect *srcrect, SDL_Surface *dst, SDL_Rect *dstrect)
+{
+    const Uint8 *from = src->pixels;
+    Uint8 *to = dst->pixels;
+    int y;
+
+    if (src->w != dst->w || src->h != dst->h)
+        return -1;
+    // The last frame may still be copied out of it
+    while (dmaBusy (FB_DMA))
+        ;
+    for (y = 0; y < src->h; ++y, from += src->pitch, to += dst->pitch)
+        memcpy (to, from, src->w);
+    return 0;
+}
+
+int SDL_FillRect (SDL_Surface *dst, const SDL_Rect *rect, Uint32 color)
+{
+    int y;
+
+    if (rect == NULL)
+    {
+        memset (dst->pixels, color, dst->pitch * dst->h);
+        return 0;
+    }
+    for (y = rect->y; y < rect->y + rect->h; ++y)
+        memset ((Uint8 *) dst->pixels + y * dst->pitch + rect->x, color, rect->w);
+    return 0;
+}
