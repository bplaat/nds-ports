From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nds-ports <nds-ports@localhost>
Date: Thu, 1 Oct 2026 09:40:02 +0200
Subject: [PATCH] Draw the walls through a strip in DTCM on the DS

Drawing the wall posts straight down the columns of the frame in main
RAM misses the data cache with every pixel. The posts go into a strip
of 8 columns in DTCM instead, with the ceiling and floor above and
below them, which is copied into the frame in words once it is full.
That replaces clearing the view as well.
---
 wl_draw.c | 96 +++++++++++++++++++++++++++++++++++++++++++------------
 1 file changed, 76 insertions(+), 20 deletions(-)

diff --git a/wl_draw.c b/wl_draw.c
index 1dad953..321bf66 100644
--- a/wl_draw.c
+++ b/wl_draw.c
@@ -295,10 +295,44 @@ int16_t CalcHeight (void)
 ===================
 */
 
+#ifdef __NDS__
+//
+// Writing posts down the columns of the frame misses the data cache with
+// every pixel, which is slow in DS main RAM. The posts go into a strip of
+// WALLSTRIP columns instead, with their ceiling and floor, that stays in
+// the cache and is copied into the frame in words once it is full.
+//
+#define WALLSTRIP 8
+
+extern byte vgaCeiling[];
+
+static byte wallstrip[WALLSTRIP * 256] __attribute__((section(".sbss"), aligned(32)));
+
+static void FlushWallStrip (void)
+{
+    uint32_t *src = (uint32_t *) wallstrip;
+    byte *dest = vbuf + (postx & ~(WALLSTRIP - 1));
+    int y;
+
+    for (y = 0; y < viewheight; y++, src += WALLSTRIP / 4, dest += bufferPitch)
+    {
+        ((uint32_t *) dest)[0] = src[0];
+        ((uint32_t *) dest)[1] = src[1];
+    }
+}
+#endif
+
 void ScalePost (void)
 {
     int ywcount, yoffs, yw, yd, yendoffs;
     byte col;
+#ifdef __NDS__
+    byte *post = wallstrip + (postx & (WALLSTRIP - 1));
+    const int pitch = WALLSTRIP;
+#else
+    byte *post = vbuf + postx;
+    const int pitch = bufferPitch;
+#endif
 
 #ifdef USE_SKYWALLPARALLAX
     if (tilehit == 16)
@@ -315,9 +349,8 @@ void ScalePost (void)
     ywcount = yd = wallheight[postx] >> 3;
     if(yd <= 0) yd = 100;
 
-    yoffs = (centery - ywcount) * bufferPitch;
+    yoffs = centery - ywcount;
     if(yoffs < 0) yoffs = 0;
-    yoffs += postx;
 
     yendoffs = centery + ywcount - 1;
     yw=TEXTURESIZE-1;
@@ -334,35 +367,56 @@ void ScalePost (void)
         }
         yendoffs = viewheight - 1;
     }
-    if(yw < 0) return;
 
+#ifdef __NDS__
+    {
+        byte ceiling = vgaCeiling[gamestate.episode*10+gamestate.mapon];
+        int y;
+
+        if(yw < 0) yendoffs = yoffs - 1;
+        for(y = 0; y < yoffs; y++)
+            post[y * pitch] = ceiling;
+        for(y = yendoffs + 1; y < viewheight; y++)
+            post[y * pitch] = 0x19;
+    }
+#endif
+
+    if(yw >= 0)
+    {
 #ifdef USE_SHADING
-    col = curshades[postsource[yw]];
+        col = curshades[postsource[yw]];
 #else
-    col = postsource[yw];
+        col = postsource[yw];
 #endif
-    yendoffs = yendoffs * bufferPitch + postx;
-    while(yoffs <= yendoffs)
-    {
-        vbuf[yendoffs] = col;
-        ywcount -= TEXTURESIZE/2;
-        if(ywcount <= 0)
+        yoffs *= pitch;
+        yendoffs *= pitch;
+        while(yoffs <= yendoffs)
         {
-            do
+            post[yendoffs] = col;
+            ywcount -= TEXTURESIZE/2;
+            if(ywcount <= 0)
             {
-                ywcount += yd;
-                yw--;
-            }
-            while(ywcount <= 0);
-            if(yw < 0) break;
+                do
+                {
+                    ywcount += yd;
+                    yw--;
+                }
+                while(ywcount <= 0);
+                if(yw < 0) break;
 #ifdef USE_SHADING
-            col = curshades[postsource[yw]];
+                col = curshades[postsource[yw]];
 #else
-            col = postsource[yw];
+                col = postsource[yw];
 #endif
+            }
+            yendoffs -= pitch;
         }
-        yendoffs -= bufferPitch;
     }
+
+#ifdef __NDS__
+    if((postx & (WALLSTRIP - 1)) == WALLSTRIP - 1)
+        FlushWallStrip ();
+#endif
 }
 
 #ifdef USE_SKYWALLPARALLAX
@@ -1488,7 +1542,9 @@ void ThreeDRefresh (void)
 //
 // follow the walls from there to the right, drawing as we go
 //
+#ifndef __NDS__           // the wall strips draw the ceiling and floor
     VGAClearScreen ();
+#endif
 #if defined(USE_FEATUREFLAGS) && defined(USE_STARSKY)
     if(GetFeatureFlags() & FF_STARSKY)
         DrawStarSky();
