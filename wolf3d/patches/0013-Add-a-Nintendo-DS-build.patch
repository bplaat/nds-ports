 #endif
 
 #include "wl_def.h"
diff --git a/id_vl.c b/id_vl.c
index 9c3c9a3..ca55f61 100644
--- a/id_vl.c
+++ b/id_vl.c
@@ -28,9 +28,9 @@ int      screenBits = 8;
 int      screenBits = 16;
 #endif
 #else
-int16_t  screenWidth = 640;
-int16_t  screenHeight = 400;
-int      screenBits = -1;      // use "best" color depth according to libSDL
+int16_t  screenWidth = 320;    // the frame of the DS
+int16_t  screenHeight = 200;
+int      screenBits = 8;
 #endif
 
 SDL_Surface *screen = NULL;
